6992							;-------------------------------------------------------------------------
6993							;
6994							; Receive multiple bytes via R2: some kind of parameter block,
6995							; followed by the reason code. Store the first N-1 received in zero
6996							; page, starting at $00.
6997							;
6998							; entry:
6999							;
7000							; X = number of bytes to receive, minus 1
7001							;
7002							; exit:
7003							;
7004							; ?$00, ?$01... = first N-1 bytes received
7005							;
7006							; A = final byte received
7007							;
7008							; X = 0
7009							;
7010	.adf8	0693					recvR2N:
7011	.adf8	0693	20 a1 06	jsr $06a1	                jsr recvR2
7012	.adfb	0696	95 ff		sta $ff,x	                sta $ff,x
7013	.adfd	0698	ca		dex		                dex
7014	.adfe	0699	d0 f8		bne $0693	                bne recvR2N
7015	.ae00	069b	80 04		bra $06a1	                bra recvR2

7017							;-------------------------------------------------------------------------
7018							;
