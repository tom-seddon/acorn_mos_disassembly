10511	.ee7c		8a		txa		                txa             ; Pass service call number to A
10512	.ee7d		a2 0f		ldx #$0f	                ldx #$0F     ; Start at ROM 15, and always call ROM 15
10513	.ee7f		80 05		bra $ee86	                bra callServiceEntry
10514	.ee81						callServiceEntriesLoop:
10515	.ee81		3c a1 02	bit $02a1,x	                bit romInformationTable,x ;check if ROM X has a service entry
10516	.ee84		10 0b		bpl $ee91	                bpl nextROM       ;branch taken if no service entry
