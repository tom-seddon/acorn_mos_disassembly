13189	.f957		cd cb 02	cmp $02cb	                cmp previousKeyPressedWhenReadingLastKey
13190	.f95a		90 ee		bcc $f94a	                bcc loopKeyboardRows         ;Taken if key<start key
13191							                                             ;value. The scan excludes
13192							                                             ;this key.
13193	.f95c		cd cc 02	cmp $02cc	                cmp previousKeyPressedWhenReadingFirstKey
13194	.f95f		b0 e9		bcs $f94a	                bcs loopKeyboardRows         ;Taken if key>=first key
13195							                                             ;value. Not sure why not
13196							                                             ;to simply break out of
13197							                                             ;thel loop though?
13198	.f961		8d cc 02	sta $02cc	                sta previousKeyPressedWhenReadingFirstKey
