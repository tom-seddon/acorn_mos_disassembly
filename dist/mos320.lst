5901	.a94e		e6 b8		inc $b8		                inc printMessageAddress+0
5902	.a950		d0 02		bne $a954	                bne +
5903	.a952		e6 b9		inc $b9		                inc printMessageAddress+1
5904	.a954						+
5905	.a954		7a		ply		                ply                          ;restore initial Y
