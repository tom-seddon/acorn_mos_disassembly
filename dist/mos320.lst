13609							;-------------------------------------------------------------------------
13610							;
13611							; Parse the FS part of a file name, if any, and return the filing
13612							; system to use.
13613							;
13614							; Entry:
13615							;
13616							; (stringInputBufferAddress),y = the string
13617							;
13618							; Exit:
13619							;
13620							; A = FS number to use
13621							;
13622							; (stringInputBufferAddress),y = next char after any tempfs prefix has
13623							; been consumed
13624	.faa6						parseFileNameFS: .proc

13626	.faa6		4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13627	.faa9		20 ff f2	jsr $f2ff	                jsr skipSpacesAndCheckForCRInStringInput
13628	.faac		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13629	.faae		c9 2d		cmp #$2d	                cmp #'-'
13630	.fab0		f0 0c		beq $fabe	                beq parseFSNamePrefix ; branch taken if tempfs syntax
13631	.fab2		2c c6 df	bit $dfc6	                bit hazel.tempFSFlag
13632	.fab5		ad 00 df	lda $df00	                lda hazel.currentFS
13633	.fab8		50 03		bvc $fabd	                bvc +
13634	.faba		ad 01 df	lda $df01	                lda hazel.activeFS
13635	.fabd						+
13636	.fabd		60		rts		                rts

13638	.fabe						parseFSNamePrefix:
13639	.fabe		c8		iny		                iny
13640	.fabf		a2 00		ldx #$00	                ldx #$00
13641	.fac1						LFAC1:
13642	.fac1		bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;get FS name char
13643	.fac4		f0 44		beq $fb0a	                beq badFilingSystemName
13644	.fac6		8a		txa		                txa                      ;A=offset in info blocks
13645	.fac7		18		clc		                clc
13646	.fac8		69 08		adc #$08	                adc #size(fsInfoBlock.name)
13647	.faca		85 b0		sta $b0		                sta parseFileNameFSWorkspace.fsInfoOffset
13648	.facc		5a		phy		                phy
13649	.facd						compareFSNameLoop:
13650	.facd		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y

13652							; validate FS name char. Must be letter or digit.

13654	.facf		20 71 ea	jsr $ea71	                jsr isLetter
13655	.fad2		90 08		bcc $fadc	                bcc validFSNameChar           ;branch taken if letter
13656	.fad4		c9 30		cmp #$30	                cmp #'0'
13657	.fad6		90 1b		bcc $faf3	                bcc notValidFSNameChar       ;branch taken if not digit
13658	.fad8		c9 3a		cmp #$3a	                cmp #'9'+1
13659	.fada		b0 17		bcs $faf3	                bcs notValidFSNameChar       ;branch taken if not digit
13660	.fadc						validFSNameChar:
13661	.fadc		e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13662	.fade		b0 0b		bcs $faeb	                bcs nextFSInfoBlock ;branch taken if end of FS
13663							                                         ;info block name was reached
13664	.fae0		5d 06 df	eor $df06,x	                eor hazel.fsInfoBlocks,x
13665	.fae3		29 df		and #$df	                and #$DF                 ;Z=1 if char matches FS name
13666	.fae5		d0 04		bne $faeb	                bne nextFSInfoBlock      ;branch taken if not a match
13667	.fae7		e8		inx		                inx                      ;next fs info block byte
13668	.fae8		c8		iny		                iny                      ;next input string byte
13669	.fae9		80 e2		bra $facd	                bra compareFSNameLoop

13671	.faeb						nextFSInfoBlock:
13672	.faeb		7a		ply		                ply
13673	.faec		a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset ;offset of end of name
13674	.faee		e8		inx		                inx
13675	.faef		e8		inx		                inx
13676	.faf0		e8		inx		                inx             ;advance to next entry
13677	.faf1		80 ce		bra $fac1	                bra LFAC1

13679	.faf3						notValidFSNameChar:

13681							; Matching FS name must be terminated with -. Otherwise, it's bad
13682							; syntax, or perhaps an overly long name.

13684	.faf3		c9 2d		cmp #$2d	                cmp #'-'
13685	.faf5		d0 13		bne $fb0a	                bne badFilingSystemName
13686	.faf7		c8		iny		                iny                       ;consume input '-'
13687	.faf8		e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13688	.fafa		f0 07		beq $fb03	                beq foundFSInfoBlock     ;branch taken if a match due
13689							                                         ;to being right at end of the
13690							                                         ;FS info block name
13691	.fafc		bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;
13692	.faff		c9 20		cmp #$20	                cmp #' '
13693	.fb01		d0 e8		bne $faeb	                bne nextFSInfoBlock      ;branch taken if not a match
13694							                                         ;as tthe supplied name was a
13695							                                         ;prefix of this FS's name
13696	.fb03						foundFSInfoBlock:
13697	.fb03		68		pla		                pla
13698	.fb04		a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset
13699	.fb06		bd 08 df	lda $df08,x	                lda hazel.fsInfoBlocks+(fsInfoBlock.fsNumber-(fsInfoBlock.name+size(fsInfoBlock.name))),x
13700	.fb09		60		rts		                rts

13702	.fb0a						badFilingSystemName:
13703	.fb0a		00		brk #		                brk
13704	>fb0b		f8 42 61 64 20 66 69 6c		                .text $f8,'Bad filing system name',0
	>fb13		69 6e 67 20 73 79 73 74 65 6d 20 6e 61 6d 65 00
13705							                .pend

13707							;-------------------------------------------------------------------------
13708							;
13709							; Find FS for the given handle
13710							;
13711							; entry:
13712							;
13713							; Y = file handle
13714							;
13715							; exit:
13716							;
13717							; X = FS number - will just use current FS if none suitable found
13718							;
13719	.fb23						findFSForHandle: .proc
13720	.fb23		48		pha		                pha                          ;
13721	.fb24		5a		phy		                phy                          ;
13722	.fb25		98		tya		                tya                          ;A = handle to search for
13723	.fb26		a0 00		ldy #$00	                ldy #$00                     ;
13724	.fb28						loop:
13725	.fb28		be 06 df	ldx $df06,y	                ldx hazel.fsInfoBlocks.name+0,y
13726	.fb2b		f0 15		beq $fb42	                beq notFound                  ;taken if terminating entry
13727	.fb2d		d9 0e df	cmp $df0e,y	                cmp hazel.fsInfoBlocks.minHandle,y
13728	.fb30		90 07		bcc $fb39	                bcc next                     ;taken if not this FS
13729	.fb32		d9 0f df	cmp $df0f,y	                cmp hazel.fsInfoBlocks.maxHandle,y
13730	.fb35		90 10		bcc $fb47	                bcc found                    ;taken if this FS
13731	.fb37		f0 0e		beq $fb47	                beq found                    ;taken if this FS

13733	.fb39						next:
13734	.fb39		48		pha		                pha
13735	.fb3a		98		tya		                tya
13736	.fb3b		18		clc		                clc
13737	.fb3c		69 0b		adc #$0b	                adc #size(fsInfoBlock)
13738	.fb3e		a8		tay		                tay
13739	.fb3f		68		pla		                pla
13740	.fb40		80 e6		bra $fb28	                bra loop

13742	.fb42						notFound:
13743	.fb42		ae 00 df	ldx $df00	                ldx hazel.currentFS
13744	.fb45		80 03		bra $fb4a	                bra done

13746	.fb47						found:
13747	.fb47		be 10 df	ldx $df10,y	                ldx hazel.fsInfoBlocks.fsNumber,y
13748	.fb4a						done:
13749	.fb4a		7a		ply		                ply
13750	.fb4b		68		pla		                pla
13751	.fb4c		60		rts		                rts
13752							                .endproc

13754							;-------------------------------------------------------------------------
13755							;
13756							; Select filing system in A.
13757							;
13758							; Entry:
13759							;
13760							; A = FS number
13761							;
13762	.fb4d						selectFS:                               ;fb4d
13763	.fb4d		cd 01 df	cmp $df01	                cmp hazel.activeFS      ; Check active fs
13764	.fb50		f0 16		beq $fb68	                beq rtsFB68               ; Already active fs, return
13765	.fb52		5a		phy		                phy
13766	.fb53		da		phx		                phx
13767	.fb54		a8		tay		                tay
13768	.fb55		3a		dec a		                dec a
13769	.fb56		d0 07		bne $fb5f	                bne LFB5F       ;taken if not FS 1 (tape)

13771							; ??? - only if trying to select tape FS

13773	.fb58		a9 04		lda #$04	                lda #$04
13774	.fb5a		24 e2		bit $e2		                bit $E2
13775	.fb5c		d0 01		bne $fb5f	                bne LFB5F
13776	.fb5e		c8		iny		                iny
13777	.fb5f						LFB5F:
13778	.fb5f		5a		phy		                phy
13779	.fb60		a2 12		ldx #$12	                ldx #romServiceCallInitialiseFilingSystem
13780	.fb62		20 72 ee	jsr $ee72	                jsr makeROMServiceCall
13781	.fb65		68		pla		                pla
13782	.fb66		fa		plx		                plx
13783	.fb67		7a		ply		                ply
13784	.fb68						rtsFB68:
13785	.fb68		60		rts		                rts

13787							;-------------------------------------------------------------------------
13788							;
13789							; FileSwitch FSC
13790							; ==============
13791							;
13792	.fb69						fileswitchFSCEntryPoint:
13793	.fb69		48		pha		                pha                          ;save request type
13794	.fb6a		20 ba ed	jsr $edba	                jsr selectHAZEL
13795	.fb6d		4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13796	.fb70		68		pla		                pla                          ;restore request type
13797	.fb71		48		pha		                pha                          ;save request type
13798	.fb72		da		phx		                phx                          ;save request X
13799	.fb73		0a		asl a		                asl a
13800	.fb74		aa		tax		                tax
13801	.fb75		c9 17		cmp #$17	                cmp #11*2+1
13802	.fb77		b0 03		bcs $fb7c	                bcs fileswitchPassFSCToCurrentFS ;taken if out of range
13803	.fb79		7c 81 fb	jmp ($fb81,x)	                jmp (fileswitchFSCRoutinesTable,x)

13805							;-------------------------------------------------------------------------
13806							;
13807							; Pass to filing system's FSC
13808							;
13809							; There's 2 entry points - fileswitchPassFSCToCurrentFS, for
13810							; when X and A are both on the stack, and
13811							; fileswitchPassFSCToCurrentFS_X, for when only A is on the
13812							; stack.
13813							;
13814	.fb7c						fileswitchPassFSCToCurrentFS:
13815	.fb7c						fileswitchFSCNewFS:
13816	.fb7c						fileswitchFSCFileHandleRange:
13817	.fb7c						fileswitchFSCStarCommand:
13818	.fb7c		fa		plx		                plx                          ;restore request X
13819	.fb7d						fileswitchPassFSCToCurrentFS_X:
13820	.fb7d		68		pla		                pla                          ;restore request type
13821	.fb7e		6c da df	jmp ($dfda)	                jmp (hazel.activeFSCV) ;call active FS's real FSCV entry point

13823							;-------------------------------------------------------------------------
13824							;
13825							; FileSwitch FSC table
13826							;
13827	.fb81						fileswitchFSCRoutinesTable:
13828	>fb81		a6 fb				                .word fileswitchFSCOPT
13829	>fb83		9f fb				                .word fileswitchFSCCheckEOF
13830	>fb85		b3 fb				                .word fileswitchFSCStarSlash
13831	>fb87		99 fb				                .word fileswitchFSCUnknownCommand
13832	>fb89		b3 fb				                .word fileswitchFSCStarRUN
13833	>fb8b		b8 fb				                .word fileswitchFSCStarCAT
13834	>fb8d		7c fb				                .word fileswitchFSCNewFS
13835	>fb8f		7c fb				                .word fileswitchFSCFileHandleRange
13836	>fb91		7c fb				                .word fileswitchFSCStarCommand
13837	>fb93		b8 fb				                .word fileswitchFSCStarEX
13838	>fb95		b8 fb				                .word fileswitchFSCStarINFO
13839	>fb97		e8 fb				                .word fileswitchFSCRUNLibrary

13841							;-------------------------------------------------------------------------
13842							;
13843							; FSC 3 - *command [AUG p344]
13844							;
13845	.fb99						fileswitchFSCUnknownCommand:
13846	.fb99		fa		plx		                plx
13847	.fb9a		20 c1 fb	jsr $fbc1	                jsr getCommandLinePointer
13848	.fb9d		80 de		bra $fb7d	                bra fileswitchPassFSCToCurrentFS_X

13850							;-------------------------------------------------------------------------
13851							;
13852							; FSC 1 - check EOF [AUG p343]
13853							;
13854	.fb9f						fileswitchFSCCheckEOF:
13855	.fb9f		7a		ply		                ply                         ;Y = file handle
13856	.fba0		5a		phy		                phy                         ;restore stack arrangement
13857	.fba1		20 97 fa	jsr $fa97	                jsr selectFSForHandle
13858	.fba4		80 d6		bra $fb7c	                bra fileswitchPassFSCToCurrentFS

13860							;-------------------------------------------------------------------------
13861							;
13862							; FSC 0 - *OPT [AUG p343]
13863							;
13864	.fba6						fileswitchFSCOPT:
13865	.fba6		2c c6 df	bit $dfc6	                bit hazel.tempFSFlag   ; Check temporary fs flag
13866	.fba9		70 d1		bvs $fb7c	                bvs fileswitchPassFSCToCurrentFS
13867	.fbab		ad 00 df	lda $df00	                lda hazel.currentFS ; Get current filing system number

13869							;-------------------------------------------------------------------------
13870							;
13871							; Pass FSCV request through to a particular FS.
13872							;
13873							; entry:
13874							;
13875							; A = FS to select
13876							;
13877							; Y = FSCV Y
13878							;
13879							; S = [FSCV X; FSCV A]
13880							;
13881	.fbae						fileswitchPassFSCToSpecificFS:
13882	.fbae		20 4d fb	jsr $fb4d	                jsr selectFS        ; Select filing system
13883	.fbb1		80 c9		bra $fb7c	                bra fileswitchPassFSCToCurrentFS

13885							;-------------------------------------------------------------------------
13886							;
13887							; FSC 2 - */filename [AUG p343]
13888							; FSC 4 - *RUN filename [AUG p344]
13889							;
13890	.fbb3						fileswitchFSCStarSlash:
13891	.fbb3						fileswitchFSCStarRUN:
13892	.fbb3		fa		plx		                plx
13893	.fbb4		20 c1 fb	jsr $fbc1	                jsr getCommandLinePointer ; Skip '*'s and spaces, set command line address
13894	.fbb7		da		phx		                phx             ; Continue on to pass to filing system

13897							;-------------------------------------------------------------------------
13898							;
13899							; FSC 5 - *CAT [AUG p344]
13900							; FSC 9 - *EX [NAUG p257]
13901							; FSC, 10 - *INFO [NAUG p257]
13902							;
13903	.fbb8						fileswitchFSCStarCAT:
13904	.fbb8						fileswitchFSCStarEX:
13905	.fbb8						fileswitchFSCStarINFO:
13906	.fbb8		fa		plx		                plx
13907	.fbb9		0e c6 df	asl $dfc6	                asl hazel.tempFSFlag
13908	.fbbc		20 6e fa	jsr $fa6e	                jsr parseFileNameAndSelectFS
13909	.fbbf		80 bc		bra $fb7d	                bra fileswitchPassFSCToCurrentFS_X

13911							;-------------------------------------------------------------------------
13912							;
13913							; Get command line pointer.
13914							;
13915							; Entry:
13916							;
13917							; X/Y - pointer to CR-terminated command line string
13918							;
13919							; Exit:
13920							;
13921							; X/Y, (hazel.commandLinePointer) - pointer to first non-space char in
13922							; command line string
13923	.fbc1						getCommandLinePointer: .proc ;fbc1
13924	.fbc1		86 f2		stx $f2		                stx stringInputBufferAddress+0
13925	.fbc3		84 f3		sty $f3		                sty stringInputBufferAddress+1

13927							; skip spaces. Stop if terminating CR encountered.

13929	.fbc5		a0 ff		ldy #$ff	                ldy #$FF
13930	.fbc7						-
13931	.fbc7		c8		iny		                iny
13932	.fbc8		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13933	.fbca		c9 0d		cmp #$0d	                cmp #$0D
13934	.fbcc		f0 04		beq $fbd2	                beq +
13935	.fbce		c9 20		cmp #$20	                cmp #' '
13936	.fbd0		d0 f5		bne $fbc7	                bne -

13938	.fbd2						+

13940							; Hmm. Didn't we just do this bit already?

13942	.fbd2		20 ff f2	jsr $f2ff	                jsr skipSpacesAndCheckForCRInStringInput

13944							; Store address of first non-space char in the HAZEL command line
13945							; pointer.

13947	.fbd5		98		tya		                tya
13948	.fbd6		18		clc		                clc
13949	.fbd7		65 f2		adc $f2		                adc stringInputBufferAddress+0
13950	.fbd9		8d 04 df	sta $df04	                sta hazel.commandLinePointer+0
13951	.fbdc		a5 f3		lda $f3		                lda stringInputBufferAddress+1
13952	.fbde		69 00		adc #$00	                adc #$00
13953	.fbe0		8d 05 df	sta $df05	                sta hazel.commandLinePointer+1
13954	.fbe3		a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13955	.fbe5		a6 f2		ldx $f2		                ldx stringInputBufferAddress+0
13956	.fbe7		60		rts		                rts
13957							                .pend

13959							;-------------------------------------------------------------------------
13960							;
13961							; FSC 11 - RUN from libfs [NAUG p257]
13962							;
13963	.fbe8						fileswitchFSCRUNLibrary:
13964	.fbe8		ad 02 df	lda $df02	                lda hazel.libFS      ; Is a libfs set?
13965	.fbeb		10 c1		bpl $fbae	                bpl fileswitchPassFSCToSpecificFS
13966	.fbed						badCommandError:
13967	.fbed		00		brk #		                brk
13968	>fbee		fe				                .byte 254
13969	>fbef		42 61 64 20 63 6f 6d 6d		                .text "Bad command"
	>fbf7		61 6e 64
13970	.fbfa		00		brk #		                brk

