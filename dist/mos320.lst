13156							                ; Reinstate auto scan mode on exit
13157	.f91c		a9 0b		lda #$0b	                lda #8|3                     ;set latch B3 - auto scan mode
13158	.f91e		8d 40 fe	sta $fe40	                sta systemVIA.orb            ;set auto scan mode
13159	.f921		8a		txa		                txa
