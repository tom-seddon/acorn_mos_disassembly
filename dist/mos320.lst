6719	>e175		04				                .byte 4|0                    ;16 KB
6720	>e176		0c				                .byte 4|8                    ;10 KB
6721	>e177		0c				                .byte 4|8                    ; 8 KB
6722	>e178		04				                .byte 4|0                    ;(benign value for 1 KB)

