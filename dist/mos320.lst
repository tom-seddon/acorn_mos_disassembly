3137	.cef0		1a		inc a		                inc a
3138	.cef1		10 03		bpl $cef6	                bpl +           ;taken if no screen address wraparound
3139	.cef3		ad 4e 03	lda $034e	                lda vduv.startScreenAddressHighByte
3140	.cef6						+
3141	.cef6		86 e0		stx $e0		                stx ZTEMPD+0
