12980	.f88a		8e 4f fe	stx $fe4f	                stx systemVIA.oraNoHandshake ;store key value
12981	.f88d		ea		nop		                nop
12982	.f88e		ae 4f fe	ldx $fe4f	                ldx systemVIA.iraNoHandshake ;read key state
12983	.f891		60		rts		                rts

