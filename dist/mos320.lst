12003	.f323						flipBitsForShift:
12004	.f323		49 30		eor #$30	                eor #$30                     ;
12005	.f325		c9 6f		cmp #$6f	                cmp #$6F                     ;
12006	.f327		f0 04		beq $f32d	                beq +                        ;taken if originally _
12007	.f329		c9 50		cmp #$50	                cmp #$50                     ;
12008	.f32b		d0 02		bne $f32f	                bne shiftMaybeNumber         ;taken if not originally GBP
12009	.f32d						+
12010	.f32d		49 1f		eor #$1f	                eor #$1F                     ;extra step for GBP/_ toggle
12011	.f32f						shiftMaybeNumber:
12012	.f32f		c9 21		cmp #$21	                cmp #' '+1
12013	.f331		90 02		bcc $f335	                bcc gotShiftedChar         ;taken if non-printing char
