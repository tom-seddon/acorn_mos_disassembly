11305							;-------------------------------------------------------------------------
11306							;
11307							; This table is used to set the serial baud rate.
11308							;
11309							;   - bit 7 is not used (always clear)
11310							;   - bit 6 is not used (always set)
11311							;   - bits 3,4,5 indicate the serial receive baud rate
11312							;   - bits 0,1,2 indicate the serial transmit baud rate
11313							;
11314							;       111 =    75 baud
11315							;       011 =   150 baud
11316							;       101 =   300 baud
11317							;       001 =  1200 baud
11318							;       110 =  2400 baud
11319							;       010 =  4800 baud
11320							;       100 =  9600 baud
11321							;       000 = 19200 baud
11322							;
11324	.f0ec						serialBaudRatesTable:
11325	>f0ec		64				                .byte %01100100;$64
11326	>f0ed		7f				                .byte %01111111;$7f
11327	>f0ee		5b				                .byte %01011011;$5b
11328	>f0ef		6d				                .byte %01101101;$6d
11329	>f0f0		49				                .byte %01001001;$49
11330	>f0f1		76				                .byte %01110110;$76
11331	>f0f2		52				                .byte %01010010;$52
11332	>f0f3		64				                .byte %01100100;$64
11333	>f0f4		40				                .byte %01000000;$40

