589							;-------------------------------------------------------------------------
590							;
591							; Read a byte value (0-255) from a string. If the number has a '&'
592							; prefix, interpret it as hex.
593							;
594							; entry:
595							;
596							; (stringInputBufferAddress),y - string
597							;
598							; exit:
599							;
600							; X = result
601							; ?$e6 = result
602							; C=0 if error
603							; Z=1 if CR encountered
604							;
605	.85e6						parseNumberFromString:
606	.85e6		20 ff f2	jsr $f2ff	                jsr skipSpacesAndCheckForCRInStringInput
607	.85e9		c9 26		cmp #$26	                cmp #'&'                     ; hex value incoming?
608	.85eb		d0 21		bne $860e	                bne parseDecimal             ; taken if not hex value
609	.85ed						parseHex:
610	.85ed		c8		iny		                iny                          ; skip '&'
611	.85ee		20 48 86	jsr $8648	                jsr readHexDigit             ; read first hex digit
612	.85f1		90 53		bcc $8646	                bcc errorReadingString
613	.85f3		85 e6		sta $e6		                sta $E6                      ; save first hex digit
614	.85f5		20 48 86	jsr $8648	                jsr readHexDigit             ; read second hex digih
