13200	.f964		ca		dex		                dex
13201	.f965		10 d0		bpl $f937	                bpl loopKeyboardColumns
13202	.f967		ae cc 02	ldx $02cc	                ldx previousKeyPressedWhenReadingFirstKey ; X=key
13203							                                                          ; found, or
13204							                                                          ; $ff if
13205							                                                          ; none
