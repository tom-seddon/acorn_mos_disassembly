12662							;
12663							; Convert internal key number (with bit 7 set) to ASCII code, taking
12664							; into account state of CTRL, SHIFT, CAPS LOCK and SHIFT LOCK.
12665							;
12666	.f7d6						getASCIICode:
12667							                ; -$80 to adjust for bit 7 set; -16 because
12668							                ; interesting keys start at 16
12669	.f7d6		bd 02 f8	lda $f802,x	                lda keyTranslationTable-$80-16,x
12687	.f7d9		f0 08		beq $f7e3	                beq handleTAB                ;taken if TAB
12688	.f7db		c9 9d		cmp #$9d	                cmp #$9D                     ;was it key_numpad_return?
12690	.f7dd		d0 07		bne $f7e6	                bne handleKey                ;taken if not

12695							                ;Transform $9d into $8d, aka 13|$80. ($8d is already
12696							                ; used in the table for right arrow.)
12697	.f7df		49 10		eor #$10	                eor #$10
12698	.f7e1		80 07		bra $f7ea	                bra getNumpadASCIICode

12700	.f7e3						handleTAB:
12701	.f7e3		ad 6b 02	lda $026b	                lda tabKeyCode
12736	.f7e6						handleKey:
12737	.f7e6		c9 a0		cmp #$a0	                cmp #$A0                     ;numpad key?
12738	.f7e8		90 0c		bcc $f7f6	                bcc processModifiers         ;taken if not
12739	.f7ea						getNumpadASCIICode:
12743							                ; C=1 at this point
12744	.f7ea		e9 31		sbc #$31	                sbc #'0'+1      ;+1 to compensate for C=1 in the next
12745							                                ;addition
12746	.f7ec		6d 7e 02	adc $027e	                adc numericKeypadInterpretation ;form actual ASCII value
12750	.f7ef		49 80		eor #$80	                eor #$80                     ;clear bit 7
12751	.f7f1		ae 8e 02	ldx $028e	                ldx numericKeypadShiftEffect ;does SHIFT affect the
12752							                                             ;keypad?
12753	.f7f4		d0 43		bne $f839	                bne LF839                    ;taken if no
12754	.f7f6						processModifiers:
12755	.f7f6		ae 5a 02	ldx $025a	                ldx keyboardStatusByte
12756	.f7f9		86 fa		stx $fa		                stx SEIWKA
12757	.f7fb		26 fa		rol $fa		                rol SEIWKA                  ;b7 = ctrlPressed
12758	.f7fd		10 07		bpl $f806	                bpl testShiftLock           ;taken if ctrl not pressed
12759	.f7ff		a6 ed		ldx $ed		                ldx firstKeyPressedInternal
12760	.f801						localResetAutoRepeatAndContinue:
12762	.f801		d0 91		bne $f794	                bne resetAutoRepeatAndContinue
12763	.f803		20 36 f3	jsr $f336	                jsr implementCTRLCodes
12770	.f806						testShiftLock:
