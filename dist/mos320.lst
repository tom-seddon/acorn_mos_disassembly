12772	.f808		30 07		bmi $f811	                bmi testCapsLock             ;taken if shift lock off
12773	.f80a		20 13 f3	jsr $f313	                jsr implementShift           ;shift lock on - apply shift
12774	.f80d		26 fa		rol $fa		                rol SEIWKA                   ;b7 = capsLockDisengaged
12775	.f80f		80 0c		bra $f81d	                bra testShiftEnabled

12777	.f811						testCapsLock:
