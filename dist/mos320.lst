5859							;
5860							; Print 0-terminated message using address from stack.
5861							;
5862							; entry:
5863							;
5864							; S=[StrL; StrH] - where Str = (address of string)-1
5865							; Y = 0 to print message; otherwise, don't print message
5866							;
5867	.a927						printFollowingMessage:                       ;
5868	.a927		68		pla		                pla
5869	.a928		85 b8		sta $b8		                sta printMessageAddress+0
5870	.a92a		68		pla		                pla
5871	.a92b		85 b9		sta $b9		                sta printMessageAddress+1
5872	.a92d		5a		phy		                phy                          ;save initial Y
5873	.a92e		98		tya		                tya                          ;Z=1 if Y=0
5874	.a92f		08		php		                php                          ;save Y=0 state
5875	.a930						fetchNextChar:
5876	.a930		e6 b8		inc $b8		                inc printMessageAddress+0
5877	.a932		d0 02		bne $a936	                bne +
5878	.a934		e6 b9		inc $b9		                inc printMessageAddress+1
5879	.a936						+
5880	.a936		b2 b8		lda ($b8)	                lda (printMessageAddress)   ;fetch next char to print
5881	.a938		f0 13		beq $a94d	                beq printingFinished        ;branch taken if last char
5882	.a93a		28		plp		                plp                         ;restore Y=0 state
5883	.a93b		08		php		                php                         ;save Y=0 state
5884	.a93c		f0 f2		beq $a930	                beq fetchNextChar ;branch taken if Y=0 - i.e., skip the
5885							                                  ;printing

5887							                ; printMessageAddress is in the $b0-$bf area, so it
5888							                ; needs saving in case there's a *SPOOL going on.
5889	.a93e		a4 b8		ldy $b8		                ldy printMessageAddress+0
5890	.a940		5a		phy		                phy
5891	.a941		a4 b9		ldy $b9		                ldy printMessageAddress+1
5892	.a943		20 e3 ff	jsr $ffe3	                jsr OSASCI
5893	.a946		84 b9		sty $b9		                sty printMessageAddress+1
5894	.a948		7a		ply		                ply
