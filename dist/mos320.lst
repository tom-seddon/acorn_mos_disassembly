3098							;
3099							; A (MSB)/X (LSB) = address
3100							;
3101							; exit:
3102							;
3103							; (ZTEMP) = column N+1
3104							; (ZTEMPB) = column N+2
3105							; (ZTEMPD) = column N+3
3106							;
