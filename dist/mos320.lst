4420	.d588		1a		inc a		                inc a
4421	.d589		e6 da		inc $da		                inc ZTEMP+0
4422	.d58b		e6 da		inc $da		                inc ZTEMP+0

4424							                ; TODO - not a great name. Could probably just be
4425							                ; addDifference, or something.
