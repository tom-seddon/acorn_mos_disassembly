10106							;
10107							; OSBYTE $80
10108							;
10109							; Read ADC channel
10110							;
10111							; On entry:
10112							;   X = channel number
10113							;
10114							; On exit:
10115							;
10116							;   X = 0 : Returns channel status
10117							;           MOS <=3.x: Y = last channel used, X[1:0] = fire buttons (active-high)
10118							;           MOS 5.x:  Y = current channel, X = digital joystick/mouse byte
10119							;                     (b7=right, b6=up, b5=down, b4=left, b3-b1=mouse, b0=fire)
10120							;
10121							;   X = 1-4 : Returns ADVAL conversion
10122							;           MOS <=3.x: Returns ADVAL(X) in X(LSB):Y(MSB), range check X < 5
10123							;           MOS 5.x:  Odd X â<86><92> ADVAL(1), Even X â<86><92> ADVAL(2), no range check

10126	.ed35						osbyte80:

10128	.ed35		30 e1		bmi $ed18	                bmi readBufferStatus        ; If negative ...
10129	.ed37		f0 0c		beq $ed45	                beq readAdval0              ; If zero, ADVAL(0)

10133							                ; The ADC workspace layout is two arrays of the five LSB values
10134							                ; for ADVAL 0 - 4 followed by the five corresponding MSB values.

10136	.ed39		e0 05		cpx #$05	                cpx #$05
10137	.ed3b		b0 ce		bcs $ed0b	                bcs osbyte82                ; return with X=$ff Y=$ff
10138	.ed3d		bc b9 02	ldy $02b9,x	                ldy adcResultMSBs-1,x       ; Y = ADVAL(X - 1) MSB
10139	.ed40		bd b5 02	lda $02b5,x	                lda adcResultLSBs-1,x       ; A = ADVAL(X - 1) LSB
10140	.ed43		aa		tax		                tax                         ; X = A

10142							                                            ; LSB in X, MSB in Y

10173	.ed44		60		rts		                rts

10176							;-------------------------------------------------------------------------

10179	.ed45						readAdval0:

10182							                ; Put the current ADC channel into Y and the state of the two
10183							                ; joystick buttons into b1 and b0 of X.

10185	.ed45		ad 40 fe	lda $fe40	                lda systemVIA.irb       ; System VIA Input Register B has active-low fire buttons on PB4 and PB5
10186	.ed48		6a		ror a		                ror a                   ; Rotate pb5 and pb4
10187	.ed49		6a		ror a		                ror a                   ; right by four
10188	.ed4a		6a		ror a		                ror a                   ; places to occupy
10189	.ed4b		6a		ror a		                ror a                   ; b1 and b0
10190	.ed4c		49 ff		eor #$ff	                eor #$FF                ; Invert to active-high
10191	.ed4e		29 03		and #$03	                and #$03                ; Mask b1 and b0
10192	.ed50		ac be 02	ldy $02be	                ldy adcLastChannelRead  ; Y = the old adcLastChannelRead for return
10193	.ed53		8e be 02	stx $02be	                stx adcLastChannelRead  ; Update adcLastChannelRead
10194	.ed56		aa		tax		                tax                     ; X = fire button statuses

10207	.ed57		60		rts		                rts

