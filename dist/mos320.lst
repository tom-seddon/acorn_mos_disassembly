10519	.ee89		20 03 80	jsr $8003	                jsr $8003       ; Call ROM service entry point
10520	.ee8c		aa		tax		                tax             ; X = service call result
10521	.ee8d		f0 05		beq $ee94	                beq done       ;branch taken if service call claimed
10522	.ee8f		a6 f4		ldx $f4		                ldx $F4         ; Get ROM number
10523	.ee91						nextROM:
10524	.ee91		ca		dex		                dex       ; Step down to next ROM, loop until all done
10525	.ee92		10 ed		bpl $ee81	                bpl callServiceEntriesLoop

10527	.ee94						done:
