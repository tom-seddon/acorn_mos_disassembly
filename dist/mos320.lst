9826							; X=1 selects 75 baud
9827							; X=2 selects 150 baud
9828							; X=3 selects 300 baud
9829							; X=4 selects 1200 baud
9830							; X=5 selects 2400 baud
9831							; X=6 selects 4800 baud
9832							; X=7 selects 9600 baud
