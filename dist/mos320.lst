13573	.fa8a		a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13574	.fa8c		90 01		bcc $fa8f	                bcc +
13575	.fa8e		c8		iny		                iny
13576	.fa8f						+
13577	.fa8f		68		pla		                pla
13578	.fa90		85 f3		sta $f3		                sta stringInputBufferAddress+1
13579	.fa92		68		pla		                pla
13580	.fa93		85 f2		sta $f2		                sta stringInputBufferAddress+0
13581	.fa95		68		pla		                pla
