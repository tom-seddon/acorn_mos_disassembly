13555							;
13556	.fa6e						parseFileNameAndSelectFS:
13557	.fa6e		48		pha		                pha
13558	.fa6f		a5 f2		lda $f2		                lda stringInputBufferAddress+0
13559	.fa71		48		pha		                pha
13560	.fa72		a5 f3		lda $f3		                lda stringInputBufferAddress+1
13561	.fa74		48		pha		                pha
13562	.fa75		20 ba ed	jsr $edba	                jsr selectHAZEL
13563	.fa78		86 f2		stx $f2		                stx stringInputBufferAddress+0
13564	.fa7a		84 f3		sty $f3		                sty stringInputBufferAddress+1
13565	.fa7c		a0 00		ldy #$00	                ldy #$00
