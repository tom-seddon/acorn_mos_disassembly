13162	.f923						scanKeyboardFromKey:
13163	.f923		8e cb 02	stx $02cb	                stx previousKeyPressedWhenReadingLastKey ; save start key
13164	.f926		a9 ff		lda #$ff	                lda #$FF
13165	.f928		8d cc 02	sta $02cc	                sta previousKeyPressedWhenReadingFirstKey
13166	.f92b		a2 0c		ldx #$0c	                ldx #$0C
13167	.f92d		a9 7f		lda #$7f	                lda #$7F
13168	.f92f		8d 43 fe	sta $fe43	                sta systemVIA.ddra  ;bit 7=input, bits0-6=output
13169	.f932		a9 03		lda #$03	                lda #0|3            ;reset latch B3 - manual scan mode
13170	.f934		8d 40 fe	sta $fe40	                sta systemVIA.orb
13171	.f937						loopKeyboardColumns:
13172	.f937		a9 0f		lda #$0f	                lda #$0F
13173	.f939		8d 4f fe	sta $fe4f	                sta systemVIA.oraNoHandshake ;select a non-existent column
13174	.f93c		a9 01		lda #$01	                lda #$01
13175	.f93e		8d 4d fe	sta $fe4d	                sta systemVIA.ifr            ;cancel keyboard interrupts
13176	.f941		8e 4f fe	stx $fe4f	                stx systemVIA.oraNoHandshake ;select column
13177	.f944		2c 4d fe	bit $fe4d	                bit systemVIA.ifr            ;any key in this column
13178							                                             ;pressed?
13179	.f947		f0 1b		beq $f964	                beq tryNextKeyboardColumn    ;taken if no key
13180	.f949		8a		txa		                txa                          ;A = first key in column
13181	.f94a						loopKeyboardRows:
13182	.f94a		18		clc		                clc
13183	.f94b		69 10		adc #$10	                adc #$10                     ;next row
13184	.f94d		30 15		bmi $f964	                bmi tryNextKeyboardColumn    ;taken if done
13185	.f94f		8d 4f fe	sta $fe4f	                sta systemVIA.oraNoHandshake ;store key
13186	.f952		2c 4f fe	bit $fe4f	                bit systemVIA.iraNoHandshake ;pressed?
13187	.f955		10 f3		bpl $f94a	                bpl loopKeyboardRows         ;taken if not
