6954	.e278		a2 03		ldx #$03	                ldx #VDUVariables.textWindowTop-VDUVariables.textWindow
6955	.e27a		20 88 e2	jsr $e288	                jsr getTextWindowRelativePosition
6956	.e27d		aa		tax		                tax                          ;X = Y position
6957	.e27e		a8		tay		                tay                          ;Y = Y position
