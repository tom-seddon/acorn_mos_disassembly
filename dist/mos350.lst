690							;-------------------------------------------------------------------------
691							;
692							; Read a hex digit from a string
693							;
694							; entry:
695							;
696							; (stringInputBufferAddress),y = next byte to read
697							;
698							; exit:
699							;
700							; C=1 if ok: A = digit read
701							;
702							; C=0 if error: A = value read, Z=1 if CR encountered
703							;
704	.8410						readHexDigit:
705	.8410		20 fe 83	jsr $83fe	                jsr readDigitFromString
706	.8413		b0 0d		bcs $8422	                bcs +                        ; branch taken if digit
707	.8415		29 df		and #$df	                and #$DF                     ; convert to upper case
708	.8417		c9 47		cmp #$47	                cmp #'F'+1
709	.8419		b0 f0		bcs $840b	                bcs L8641    ; branch taken if not ASCII A-F hex digit
710	.841b		c9 41		cmp #$41	                cmp #'A'
711	.841d		90 ec		bcc $840b	                bcc L8641     ;branch taken if not ASCII A-F hex digit
712							                ; convert ASCII A-F hex digit to number.
713	.841f		49 48		eor #$48	                eor #$48
714	.8421		1a		inc a		                inc a
715	.8422						+
716	.8422		c8		iny		                iny
717	.8423		60		rts		                rts

