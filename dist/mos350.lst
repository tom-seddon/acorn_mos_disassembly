5872	.a96f		5a		phy		                phy                          ;save initial Y
5873	.a970		98		tya		                tya                          ;Z=1 if Y=0
5874	.a971		08		php		                php                          ;save Y=0 state
5875	.a972						fetchNextChar:
5876	.a972		e6 b8		inc $b8		                inc printMessageAddress+0
5877	.a974		d0 02		bne $a978	                bne +
5878	.a976		e6 b9		inc $b9		                inc printMessageAddress+1
5879	.a978						+
5880	.a978		b2 b8		lda ($b8)	                lda (printMessageAddress)   ;fetch next char to print
5881	.a97a		f0 13		beq $a98f	                beq printingFinished        ;branch taken if last char
5882	.a97c		28		plp		                plp                         ;restore Y=0 state
5883	.a97d		08		php		                php                         ;save Y=0 state
5884	.a97e		f0 f2		beq $a972	                beq fetchNextChar ;branch taken if Y=0 - i.e., skip the
5885							                                  ;printing

