5888							                ; needs saving in case there's a *SPOOL going on.
5889	.a980		a4 b8		ldy $b8		                ldy printMessageAddress+0
5890	.a982		5a		phy		                phy
5891	.a983		a4 b9		ldy $b9		                ldy printMessageAddress+1
