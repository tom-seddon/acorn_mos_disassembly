6947	.e26d		a0 10		ldy #$10	                ldy #VDUVariables.textCursorXPosition-VDUVariables.textWindow
6948	.e26f		a2 00		ldx #$00	                ldx #VDUVariables.textWindowLeft-VDUVariables.textWindow
6949	.e271		20 88 e2	jsr $e288	                jsr getTextWindowRelativePosition
6950	.e274		48		pha		                pha                          ;save X position
6951	.e275		a9 04		lda #$04	                lda #VDUVariables.cursorFlags.invertVertical
6952	.e277						LE279:
