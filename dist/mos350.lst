9791							;
9792							; ;OSBYTE 8 (&08) Write RS423 transmit rate
9793							;
9794							; This call sets the RS423 baud rate for transmitting data. The actual format of
9795							; the data is set using OSBYTE 156/&9C (see below).
9796							;
9797							; Entry parameters :
9798							; X=0 selects 9600 baud
9799							; X=1 selects 75 baud
9800							; X=2 selects 150 baud
9801							; X=3 selects 300 baud
9802							; X=4 selects 1200 baud
9803							; X=5 selects 2400 baud
9804							; X=6 selects 4800 baud
9805							; X=7 selects 9600 baud
9806							; X=8 selects 19200 baud
9807							; Y=0
9808							;
