13555							;
13556	.f7aa						parseFileNameAndSelectFS:
13557	.f7aa		48		pha		                pha
13558	.f7ab		a5 f2		lda $f2		                lda stringInputBufferAddress+0
13559	.f7ad		48		pha		                pha
13560	.f7ae		a5 f3		lda $f3		                lda stringInputBufferAddress+1
13561	.f7b0		48		pha		                pha
13562	.f7b1		20 fa ec	jsr $ecfa	                jsr selectHAZEL
13563	.f7b4		86 f2		stx $f2		                stx stringInputBufferAddress+0
13564	.f7b6		84 f3		sty $f3		                sty stringInputBufferAddress+1
13565	.f7b8		a0 00		ldy #$00	                ldy #$00
