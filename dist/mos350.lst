13567	.f7bd		5a		phy		                phy                      ;save offset
13568	.f7be		20 89 f8	jsr $f889	                jsr selectFS                 ;select desired FS
13569	.f7c1		68		pla		                pla
13570	.f7c2		18		clc		                clc
13571	.f7c3		65 f2		adc $f2		                adc stringInputBufferAddress+0
13572	.f7c5		aa		tax		                tax                          ;save string address LSB
13573	.f7c6		a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13574	.f7c8		90 01		bcc $f7cb	                bcc +
13575	.f7ca		c8		iny		                iny
13576	.f7cb						+
13577	.f7cb		68		pla		                pla
13578	.f7cc		85 f3		sta $f3		                sta stringInputBufferAddress+1
13579	.f7ce		68		pla		                pla
13580	.f7cf		85 f2		sta $f2		                sta stringInputBufferAddress+0
13581	.f7d1		68		pla		                pla
13582	.f7d2		60		rts		                rts

