13609							;-------------------------------------------------------------------------
13610							;
13611							; Parse the FS part of a file name, if any, and return the filing
13612							; system to use.
13613							;
13614							; Entry:
13615							;
13616							; (stringInputBufferAddress),y = the string
13617							;
13618							; Exit:
13619							;
13620							; A = FS number to use
13621							;
13622							; (stringInputBufferAddress),y = next char after any tempfs prefix has
13623							; been consumed
13624	.f7e2						parseFileNameFS: .proc

13626	.f7e2		4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13627	.f7e5		20 72 f2	jsr $f272	                jsr skipSpacesAndCheckForCRInStringInput
13628	.f7e8		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13629	.f7ea		c9 2d		cmp #$2d	                cmp #'-'
13630	.f7ec		f0 0c		beq $f7fa	                beq parseFSNamePrefix ; branch taken if tempfs syntax
13631	.f7ee		2c c6 df	bit $dfc6	                bit hazel.tempFSFlag
13632	.f7f1		ad 00 df	lda $df00	                lda hazel.currentFS
13633	.f7f4		50 03		bvc $f7f9	                bvc +
13634	.f7f6		ad 01 df	lda $df01	                lda hazel.activeFS
13635	.f7f9						+
13636	.f7f9		60		rts		                rts

13638	.f7fa						parseFSNamePrefix:
13639	.f7fa		c8		iny		                iny
13640	.f7fb		a2 00		ldx #$00	                ldx #$00
13641	.f7fd						LFAC1:
13642	.f7fd		bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;get FS name char
13643	.f800		f0 44		beq $f846	                beq badFilingSystemName
13644	.f802		8a		txa		                txa                      ;A=offset in info blocks
13645	.f803		18		clc		                clc
13646	.f804		69 08		adc #$08	                adc #size(fsInfoBlock.name)
13647	.f806		85 b0		sta $b0		                sta parseFileNameFSWorkspace.fsInfoOffset
13648	.f808		5a		phy		                phy
13649	.f809						compareFSNameLoop:
13650	.f809		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y

13652							; validate FS name char. Must be letter or digit.

13654	.f80b		20 35 ea	jsr $ea35	                jsr isLetter
13655	.f80e		90 08		bcc $f818	                bcc validFSNameChar           ;branch taken if letter
13656	.f810		c9 30		cmp #$30	                cmp #'0'
13657	.f812		90 1b		bcc $f82f	                bcc notValidFSNameChar       ;branch taken if not digit
13658	.f814		c9 3a		cmp #$3a	                cmp #'9'+1
13659	.f816		b0 17		bcs $f82f	                bcs notValidFSNameChar       ;branch taken if not digit
13660	.f818						validFSNameChar:
13661	.f818		e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13662	.f81a		b0 0b		bcs $f827	                bcs nextFSInfoBlock ;branch taken if end of FS
13663							                                         ;info block name was reached
13664	.f81c		5d 06 df	eor $df06,x	                eor hazel.fsInfoBlocks,x
13665	.f81f		29 df		and #$df	                and #$DF                 ;Z=1 if char matches FS name
13666	.f821		d0 04		bne $f827	                bne nextFSInfoBlock      ;branch taken if not a match
13667	.f823		e8		inx		                inx                      ;next fs info block byte
13668	.f824		c8		iny		                iny                      ;next input string byte
13669	.f825		80 e2		bra $f809	                bra compareFSNameLoop

13671	.f827						nextFSInfoBlock:
13672	.f827		7a		ply		                ply
13673	.f828		a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset ;offset of end of name
13674	.f82a		e8		inx		                inx
13675	.f82b		e8		inx		                inx
13676	.f82c		e8		inx		                inx             ;advance to next entry
13677	.f82d		80 ce		bra $f7fd	                bra LFAC1

13679	.f82f						notValidFSNameChar:

13681							; Matching FS name must be terminated with -. Otherwise, it's bad
13682							; syntax, or perhaps an overly long name.

13684	.f82f		c9 2d		cmp #$2d	                cmp #'-'
13685	.f831		d0 13		bne $f846	                bne badFilingSystemName
13686	.f833		c8		iny		                iny                       ;consume input '-'
13687	.f834		e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13688	.f836		f0 07		beq $f83f	                beq foundFSInfoBlock     ;branch taken if a match due
13689							                                         ;to being right at end of the
13690							                                         ;FS info block name
13691	.f838		bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;
13692	.f83b		c9 20		cmp #$20	                cmp #' '
13693	.f83d		d0 e8		bne $f827	                bne nextFSInfoBlock      ;branch taken if not a match
13694							                                         ;as tthe supplied name was a
13695							                                         ;prefix of this FS's name
13696	.f83f						foundFSInfoBlock:
13697	.f83f		68		pla		                pla
13698	.f840		a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset
13699	.f842		bd 08 df	lda $df08,x	                lda hazel.fsInfoBlocks+(fsInfoBlock.fsNumber-(fsInfoBlock.name+size(fsInfoBlock.name))),x
13700	.f845		60		rts		                rts

13702	.f846						badFilingSystemName:
13703	.f846		00		brk #		                brk
13704	>f847		f8 42 61 64 20 66 69 6c		                .text $f8,'Bad filing system name',0
	>f84f		69 6e 67 20 73 79 73 74 65 6d 20 6e 61 6d 65 00
13705							                .pend

