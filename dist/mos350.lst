589							;-------------------------------------------------------------------------
590							;
591							; Read a byte value (0-255) from a string. If the number has a '&'
592							; prefix, interpret it as hex.
593							;
594							; entry:
595							;
596							; (stringInputBufferAddress),y - string
597							;
598							; exit:
599							;
600							; X = result
601							; ?$e6 = result
602							; C=0 if error
603							; Z=1 if CR encountered
604							;
605	.83b0						parseNumberFromString:
606	.83b0		20 72 f2	jsr $f272	                jsr skipSpacesAndCheckForCRInStringInput
607	.83b3		c9 26		cmp #$26	                cmp #'&'                     ; hex value incoming?
608	.83b5		d0 21		bne $83d8	                bne parseDecimal             ; taken if not hex value
609	.83b7						parseHex:
610	.83b7		c8		iny		                iny                          ; skip '&'
611	.83b8		20 10 84	jsr $8410	                jsr readHexDigit             ; read first hex digit
612	.83bb		90 51		bcc $840e	                bcc errorReadingString
613	.83bd		85 e6		sta $e6		                sta $E6                      ; save first hex digit
614	.83bf		20 10 84	jsr $8410	                jsr readHexDigit             ; read second hex digih
615	.83c2		90 0e		bcc $83d2	                bcc parsedValue         ; taken if not hex digit
616							                ; The first digit read was actually the high nybble,
617							                ; and the current digit read is therefore the low
618							                ; nybble.
619							                ;
620							                ; Shift saved digit 4 bits left.
621	.83c4		a2 04		ldx #$04	                ldx #$04
622	.83c6						-
623	.83c6		06 e6		asl $e6		                asl $E6
624	.83c8		ca		dex		                dex
625	.83c9		d0 fb		bne $83c6	                bne -
626	.83cb		04 e6		tsb $e6		                tsb $E6                      ; insert low nybble
627	.83cd		20 10 84	jsr $8410	                jsr readHexDigit             ; read third hex digit
628	.83d0		b0 29		bcs $83fb	                bcs errorReadingString2 ; 3+-digit hex values are not valid
629	.83d2						parsedValue:
630	.83d2		a6 e6		ldx $e6		                ldx $E6
631	.83d4		c9 0d		cmp #$0d	                cmp #$0D
632	.83d6		38		sec		                sec
633	.83d7						parseDone:
634	.83d7		60		rts		                rts

636	.83d8						parseDecimal:
637	.83d8		20 fe 83	jsr $83fe	                jsr readDigitFromString
638	.83db		90 31		bcc $840e	                bcc errorReadingString      ;branch taken if not digit
639	.83dd						parseDecimalDigit:
640	.83dd		85 e6		sta $e6		                sta $E6                     ;save current value
641	.83df		20 fd 83	jsr $83fd	                jsr readNextDigitFromString
642	.83e2		90 ee		bcc $83d2	                bcc parsedValue ;branch taken if not digit, meaning number
643							                                     ;parsed successfully
644	.83e4		aa		tax		                tax                         ;X=digit

646							                ; calculate (value*4+value)*2 - i.e., value*10. Carry
647							                ; at any point indicates the value was greater than
648							                ; 255, and therefore an error.
649	.83e5		a5 e6		lda $e6		                lda $E6                     ;value
650	.83e7		0a		asl a		                asl a                       ;value*2
651	.83e8		b0 24		bcs $840e	                bcs errorReadingString
652	.83ea		0a		asl a		                asl a                       ;value*4
653	.83eb		b0 21		bcs $840e	                bcs errorReadingString
654	.83ed		65 e6		adc $e6		                adc $E6                     ;value*5
655	.83ef		b0 1d		bcs $840e	                bcs errorReadingString
656	.83f1		0a		asl a		                asl a                       ;value*10
657	.83f2		b0 1a		bcs $840e	                bcs errorReadingString
658	.83f4		85 e6		sta $e6		                sta $E6                      ;save value*10
659	.83f6		8a		txa		                txa                          ;A=digit
660	.83f7		65 e6		adc $e6		                adc $E6                      ;value*10+digit
661	.83f9		90 e2		bcc $83dd	                bcc parseDecimalDigit
662	.83fb						errorReadingString2:
663	.83fb		18		clc		                clc
664	.83fc		60		rts		                rts

666	.83fd						readNextDigitFromString:
667	.83fd		c8		iny		                iny

669							; check if current string input byte is a digit.
670							;
671							; exit: C=1 if digit; C=0 if not digit
672	.83fe						readDigitFromString:
673	.83fe		b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
674	.8400		c9 3a		cmp #$3a	                cmp #'9'+1
675	.8402		b0 0a		bcs $840e	                bcs errorReadingString       ;taken if not ASCII decimal digit
676	.8404		c9 30		cmp #$30	                cmp #'0'
677	.8406		90 06		bcc $840e	                bcc errorReadingString       ;taken if not ASCII decimal digit
678	.8408		29 0f		and #$0f	                and #$0F         ;convert ASCII decimaldigit to number
679	.840a		60		rts		                rts

681	.840b						L8641:
682	.840b		20 72 f2	jsr $f272	                jsr skipSpacesAndCheckForCRInStringInput
