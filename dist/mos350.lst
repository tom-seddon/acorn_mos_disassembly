3836							; EIGABS entry point.
3837							;
3838	.d1dd						eigabsEntryPoint:
3839	.d1dd		a9 ff		lda #$ff	                lda #$FF ;pretend it's PLOT 255 (as that would be absolute coordinates)
3840	.d1df		80 03		bra $d1e4	                bra eigabsCommon

