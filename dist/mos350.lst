3137	.ceef		1a		inc a		                inc a
3138	.cef0		10 03		bpl $cef5	                bpl +           ;taken if no screen address wraparound
3139	.cef2		ad 4e 03	lda $034e	                lda vduv.startScreenAddressHighByte
3140	.cef5						+
3141	.cef5		86 e0		stx $e0		                stx ZTEMPD+0
