13708							;
13709							; Find FS for the given handle
13710							;
13711							; entry:
13712							;
13713							; Y = file handle
13714							;
13715							; exit:
13716							;
13717							; X = FS number - will just use current FS if none suitable found
13718							;
13719	.f85f						findFSForHandle: .proc
13720	.f85f		48		pha		                pha                          ;
13721	.f860		5a		phy		                phy                          ;
13722	.f861		98		tya		                tya                          ;A = handle to search for
13723	.f862		a0 00		ldy #$00	                ldy #$00                     ;
13724	.f864						loop:
13725	.f864		be 06 df	ldx $df06,y	                ldx hazel.fsInfoBlocks.name+0,y
13726	.f867		f0 15		beq $f87e	                beq notFound                  ;taken if terminating entry
13727	.f869		d9 0e df	cmp $df0e,y	                cmp hazel.fsInfoBlocks.minHandle,y
13728	.f86c		90 07		bcc $f875	                bcc next                     ;taken if not this FS
13729	.f86e		d9 0f df	cmp $df0f,y	                cmp hazel.fsInfoBlocks.maxHandle,y
13730	.f871		90 10		bcc $f883	                bcc found                    ;taken if this FS
13731	.f873		f0 0e		beq $f883	                beq found                    ;taken if this FS

13733	.f875						next:
13734	.f875		48		pha		                pha
13735	.f876		98		tya		                tya
13736	.f877		18		clc		                clc
13737	.f878		69 0b		adc #$0b	                adc #size(fsInfoBlock)
13738	.f87a		a8		tay		                tay
13739	.f87b		68		pla		                pla
13740	.f87c		80 e6		bra $f864	                bra loop

13742	.f87e						notFound:
13743	.f87e		ae 00 df	ldx $df00	                ldx hazel.currentFS
13744	.f881		80 03		bra $f886	                bra done

13746	.f883						found:
13747	.f883		be 10 df	ldx $df10,y	                ldx hazel.fsInfoBlocks.fsNumber,y
13748	.f886						done:
13749	.f886		7a		ply		                ply
13750	.f887		68		pla		                pla
13751	.f888		60		rts		                rts
13752							                .endproc

