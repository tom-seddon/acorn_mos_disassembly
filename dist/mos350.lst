6632							                ; Enable: PIRQ from R3, PIRQ from R1
6633	>ac94	0518	86				                .byte tube.status1.S|tube.status1.J|tube.status1.I

6635							                ; 1 - I/O->CoPro bytes
6636							                ;
6637							                ; Enable: PNMI from R3
6638	>ac95	0519	88				                .byte tube.status1.S|tube.status1.M

6640							                ; 2 - CoPro->I/O words
6641							                ;
6642							                ; Enable: 2-byte R3, PIRQ from R2, PIRQ from R1
6643	>ac96	051a	96				                .byte tube.status1.S|tube.status1.V|tube.status1.J|tube.status1.I

6645							                ; 3 - I/O->CoPro words
6646							                ;
6647							                ; Enable: 2-byte R3, PNMI from R3
6648	>ac97	051b	98				                .byte tube.status1.S|tube.status1.V|tube.status1.M

6650							                ; 4 - Execute in CoPro
6651							                ;
6652							                ; Disable: 2-byte R3, PNMI from R3
6653	>ac98	051c	18				                .byte tube.status1.V|tube.status1.M

6655							                ; 5 - Reserved
6656							                ;
6657							                ; Disable: 2-byte R3, PNMI from R3
6658	>ac99	051d	18				                .byte tube.status1.V|tube.status1.M

6660							                ; 6 - CoPro->I/O 256 bytes
6661							                ;
6662							                ; Enable: PIRQ from R1
6663	>ac9a	051e	82				                .byte tube.status1.S|tube.status1.I

6665							                ; 7 - I/O->CoPro 256 bytes
6666							                ;
6667							                ; Disable: 2-byte R3, PNMI from R3
6668	>ac9b	051f	18				                .byte tube.status1.V|tube.status1.M

