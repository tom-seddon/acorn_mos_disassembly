5984	.de71		20 a2 de	jsr $dea2	                jsr get4Pixels
5985	.de74		b1 da		lda ($da),y	                lda (ZTEMP),y                  ;get pixels 4-7
5986	.de76		20 a2 de	jsr $dea2	                jsr get4Pixels
5987	.de79		80 14		bra $de8f	                bra LDE8F

5989	.de7b						read4bppChar:
