10511	.edbf		8a		txa		                txa             ; Pass service call number to A
10512	.edc0		a2 0f		ldx #$0f	                ldx #$0F     ; Start at ROM 15, and always call ROM 15
10513	.edc2		80 05		bra $edc9	                bra callServiceEntry
10514	.edc4						callServiceEntriesLoop:
10515	.edc4		3c a1 02	bit $02a1,x	                bit romInformationTable,x ;check if ROM X has a service entry
10516	.edc7		10 0b		bpl $edd4	                bpl nextROM       ;branch taken if no service entry
10517	.edc9						callServiceEntry:
10518	.edc9		20 4b e5	jsr $e54b	                jsr selectROMX  ; Page in ROM X
10519	.edcc		20 03 80	jsr $8003	                jsr $8003       ; Call ROM service entry point
10520	.edcf		aa		tax		                tax             ; X = service call result
10521	.edd0		f0 05		beq $edd7	                beq done       ;branch taken if service call claimed
10522	.edd2		a6 f4		ldx $f4		                ldx $F4         ; Get ROM number
10523	.edd4						nextROM:
10524	.edd4		ca		dex		                dex       ; Step down to next ROM, loop until all done
10525	.edd5		10 ed		bpl $edc4	                bpl callServiceEntriesLoop

10527	.edd7						done:
