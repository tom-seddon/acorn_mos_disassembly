6959	.e281		2c 66 03	bit $0366	                bit vduv.cursorFlags
6960	.e284		f0 24		beq $e2aa	                beq plx_rts ;taken if axes unswapped - so X = X position, Y = Y position
6961	.e286		7a		ply		                ply                          ;Y = Y position, X = X position
6962	.e287		60		rts		                rts

