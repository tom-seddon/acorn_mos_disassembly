6113	.df25		8d 1a 03	sta $031a	                sta vduv.graphicsAddressOffset
6114	.df28		a5 d6		lda $d6		                lda ZMEMG+0                  ;>column offset
6115	.df2a		65 d7		adc $d7		                adc ZMEMG+1                  ;add to address MSB
