3243							;-------------------------------------------------------------------------

3251							;-------------------------------------------------------------------------
3252							;
3253							; Read byte from EEPROM by 0-based CMOS RAM offset (readCMOSByte) or
3254							; RTC register index (readRTCByte).
3255							;
3256							; (The number of RTC registers on the Compact is 0, so readRTCByte and
3257							; readCMOSByte use the same indexes. Nevertheless, the two routines
3258							; behave differently... presumably I still haven't quite got this bit
3259							; right.)
3260							;
3261							; entry:
3262							;
3263							; X = address to read from
3264							;
3265							; exit:
3266							;
3267							; A = Y = byte read

3334							;-------------------------------------------------------------------------

3362							;-------------------------------------------------------------------------
3363							;
3364							; Transmit 1 bit over the I2C bus.
3365							;
3366							; preserves: P
3367							;

3380							;-------------------------------------------------------------------------
3381							;
3382							; Set the I2C clock line high.
3383							;
3384							; preserves: A/X/Y/C
3385							;

3397							;-------------------------------------------------------------------------
3398							;
3399							; Set the I2C clock line low.
3400							;
3401							; preserves: A/X/Y/C
3402							;

3413							;-------------------------------------------------------------------------
3414							;
3415							; "A change in the state of the data line, from HIGH to LOW, while the
3416							; clock is HIGH, defines the START condition."
3417							;
3418							; preserves: X/Y/P

3435							;-------------------------------------------------------------------------
3436							;
3437							; Set the I2C data line low.
3438							;
3439							; preserves: A/X/Y/C
3440							;

3451							;-------------------------------------------------------------------------

3484							;-------------------------------------------------------------------------
3485							;
3486							; Set the I2C data line to a particular value.
3487							;
3488							; entry:
3489							;
3490							; C = state of signal: 1 = high, 0 = low
3491							;
3492							; preserves: C

3500							;-------------------------------------------------------------------------
3501							;
3502							; Set the I2C data line high.
3503							;
3504							; preserves: A/X/Y/C
3505							;

3516							;-------------------------------------------------------------------------
3517							;
3518							; Transmits 1 byte/8 bits over the I2C bus.
3519							;
3520							; entry: A = byte to transmit

3537							;-------------------------------------------------------------------------

3644							;-------------------------------------------------------------------------

3659							;-------------------------------------------------------------------------

3692							;-------------------------------------------------------------------------

3698							;-------------------------------------------------------------------------

