6035	.debc		4a		lsr a		                lsr a                        ;%0abcdABC
6036	.debd		4a		lsr a		                lsr a                        ;%00abcdAB
6037	.debe						shiftOut2:
6038	.debe		4a		lsr a		                lsr a                        ;%000abcdA
6039	.debf		4a		lsr a		                lsr a                        ;%0000abcd
6040	.dec0		05 de		ora $de		                ora ZTEMPC+0                 ;%0000abcd|%abcdABCD
6041							                .endproc
