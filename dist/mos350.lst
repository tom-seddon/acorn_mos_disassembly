6050	.dec3						windGADDR:
6051	.dec3		20 a7 d1	jsr $d1a7	                jsr windEntryPoint
6052	.dec6		d0 fa		bne $dec2	                bne rtsDEC2                  ;taken if point outside window
6053	.dec8						gaddrEntryPoint:
