384							;-------------------------------------------------------------------------
385							;
386							; Get string input buffer address tail according to table byte.
387							;
388							; Entry:
389							;
390							; oscliWorkspace.tablePtr; = pointer to table byte
391							; (stringInputBufferAddress),y = pointer to input
392							;
393							; Exit:
394							;
395							; A = table byte
396							;
397							; if table byte bit 7 set: Y/X points to command line tail
398	.82f9						maybeGetStringInputBufferAddress:
399	.82f9		b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
400	.82fb		30 0c		bmi $8309	                bmi rts84FE
401	.82fd						getStringInputBufferAddressWithYOffset:
402	.82fd		98		tya		                tya
403	.82fe						getStringInputBufferAddressWithAOffset:
404	.82fe		18		clc		                clc
405	.82ff		65 f2		adc $f2		                adc stringInputBufferAddress+0
406	.8301		aa		tax		                tax
407	.8302		a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
408	.8304		90 01		bcc $8307	                bcc +
409	.8306		c8		iny		                iny
