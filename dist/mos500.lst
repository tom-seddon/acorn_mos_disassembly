13794	.faba	20 40 ee	jsr $ee40	                jsr selectHAZEL
13795	.fabd	4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13796	.fac0	68		pla		                pla                          ;restore request type
13797	.fac1	48		pha		                pha                          ;save request type
13798	.fac2	da		phx		                phx                          ;save request X
13799	.fac3	0a		asl a		                asl a
13800	.fac4	aa		tax		                tax
13801	.fac5	c9 17		cmp #$17	                cmp #11*2+1
13802	.fac7	b0 03		bcs $facc	                bcs fileswitchPassFSCToCurrentFS ;taken if out of range
13803	.fac9	7c d1 fa	jmp ($fad1,x)	                jmp (fileswitchFSCRoutinesTable,x)

