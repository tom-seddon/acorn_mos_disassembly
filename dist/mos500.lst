576	.85e2	a9 0e		lda #$0e	                lda #14
577	.85e4	20 ee ff	jsr $ffee	                jsr OSWRCH                   ; paged mode ON
578	.85e7	20 f8 ee	jsr $eef8	                jsr makeROMServiceCall   ;
579	.85ea	a2 18		ldx #$18	                ldx #romServiceCallReserved  ;???
580	.85ec	20 f8 ee	jsr $eef8	                jsr makeROMServiceCall
581	.85ef	68		pla		                pla                          ;restore STATE
582	.85f0	89 04		bit #$04	                bit #STATE.isPagedScrolling  ;was paged mode on originally?
583	.85f2	d0 2c		bne $8620	                bne parseDone   ;taken if paged mode was originally on
584						                                ;(branch target is an arbitrary nearby
585						                                ;RTS)
586	.85f4	a9 0f		lda #$0f	                lda #15         ;restore non-paged mode
587	.85f6	4c ee ff	jmp $ffee	                jmp OSWRCH

