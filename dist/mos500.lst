3835						;
3836						; EIGABS entry point.
3837						;
3838	.d1de					eigabsEntryPoint:
3839	.d1de	a9 ff		lda #$ff	                lda #$FF ;pretend it's PLOT 255 (as that would be absolute coordinates)
3840	.d1e0	80 03		bra $d1e5	                bra eigabsCommon

