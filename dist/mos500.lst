838	.8f6c	95 00		sta $00,x	                sta 0,x
839	.8f6e	ad f7 02	lda $02f7	                lda sramWorkspace.dataAddress+1
840	.8f71	95 01		sta $01,x	                sta 1,x

842	.8f73					subtractY:
