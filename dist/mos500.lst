552						; *ADFS - pass straight to ROMs/Filing System
553						; ===========================================
554	.85c2					passStarCommandThrough:
555	.85c2	2c c6 df	bit $dfc6	                bit hazel.tempFSFlag      ; Check filing system flag
556	.85c5	30 0c		bmi $85d3	                bmi L85C0                    ; If ... skip ROM service call
557	.85c7	9c c6 df	stz $dfc6	                stz hazel.tempFSFlag      ; Clear filing system flag
558	.85ca	a4 e6		ldy $e6		                ldy $E6
559	.85cc	a2 04		ldx #$04	                ldx #romServiceCallUnrecognisedCommand
560	.85ce	20 89 ee	jsr $ee89	                jsr osbyte8F    ; Service call 4 - Unknown command
562	.85d1	f0 4d		beq $8620	                beq parseDone
566	.85d3					L85C0:
