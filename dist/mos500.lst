3251						;-------------------------------------------------------------------------
3252						;
3253						; Read byte from EEPROM by 0-based CMOS RAM offset (readCMOSByte) or
3254						; RTC register index (readRTCByte).
3255						;
3256						; (The number of RTC registers on the Compact is 0, so readRTCByte and
3257						; readCMOSByte use the same indexes. Nevertheless, the two routines
3258						; behave differently... presumably I still haven't quite got this bit
3259						; right.)
3260						;
3261						; entry:
3262						;
3263						; X = address to read from
3264						;
3265						; exit:
3266						;
3267						; A = Y = byte read

3270	.9daa					readCMOSByte:
3271	.9daa	e0 ff		cpx #$ff	                cpx #$ff
3272	.9dac	d0 1c		bne $9dca	                bne readRTCByte              ; taken if address not $ff

3274						                ; Read address $ff to query the size.
3275	.9dae	20 7e 90	jsr $907e	                jsr i2cTestReadEEPROMByte    ; do an experimental read
3276	.9db1	a0 00		ldy #$00	                ldy #0                       ; failure result is 0
3277	.9db3	b0 2b		bcs $9de0	                bcs rts9DE0 ; taken if read failed - no EEPROM present
3278	.9db5	a2 7f		ldx #$7f	                ldx #$7f
3279	.9db7	20 ca 9e	jsr $9eca	                jsr i2cReadEEPROMByte        ; read the byte at $7f
3280	.9dba	5a		phy		                phy                          ; save the byte read
3281	.9dbb	a2 ff		ldx #$ff	                ldx #$ff
3282	.9dbd	20 ca 9e	jsr $9eca	                jsr i2cReadEEPROMByte        ; read the byte at $ff
3283	.9dc0	98		tya		                tya                          ; A = byte from $ff
