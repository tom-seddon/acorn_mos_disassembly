591						; Read a byte value (0-255) from a string. If the number has a '&'
592						; prefix, interpret it as hex.
593						;
594						; entry:
595						;
596						; (stringInputBufferAddress),y - string
597						;
598						; exit:
599						;
600						; X = result
601						; ?$e6 = result
602						; C=0 if error
603						; Z=1 if CR encountered
604						;
605	.85f9					parseNumberFromString:
606	.85f9	20 ad f3	jsr $f3ad	                jsr skipSpacesAndCheckForCRInStringInput
607	.85fc	c9 26		cmp #$26	                cmp #'&'                     ; hex value incoming?
608	.85fe	d0 21		bne $8621	                bne parseDecimal             ; taken if not hex value
609	.8600					parseHex:
610	.8600	c8		iny		                iny                          ; skip '&'
611	.8601	20 5b 86	jsr $865b	                jsr readHexDigit             ; read first hex digit
612	.8604	90 53		bcc $8659	                bcc errorReadingString
613	.8606	85 e6		sta $e6		                sta $E6                      ; save first hex digit
614	.8608	20 5b 86	jsr $865b	                jsr readHexDigit             ; read second hex digih
615	.860b	90 0e		bcc $861b	                bcc parsedValue         ; taken if not hex digit
616						                ; The first digit read was actually the high nybble,
617						                ; and the current digit read is therefore the low
618						                ; nybble.
619						                ;
620						                ; Shift saved digit 4 bits left.
621	.860d	a2 04		ldx #$04	                ldx #$04
622	.860f					-
623	.860f	06 e6		asl $e6		                asl $E6
624	.8611	ca		dex		                dex
625	.8612	d0 fb		bne $860f	                bne -
626	.8614	04 e6		tsb $e6		                tsb $E6                      ; insert low nybble
627	.8616	20 5b 86	jsr $865b	                jsr readHexDigit             ; read third hex digit
628	.8619	b0 29		bcs $8644	                bcs errorReadingString2 ; 3+-digit hex values are not valid
629	.861b					parsedValue:
630	.861b	a6 e6		ldx $e6		                ldx $E6
631	.861d	c9 0d		cmp #$0d	                cmp #$0D
632	.861f	38		sec		                sec
633	.8620					parseDone:
634	.8620	60		rts		                rts

636	.8621					parseDecimal:
637	.8621	20 47 86	jsr $8647	                jsr readDigitFromString
638	.8624	90 33		bcc $8659	                bcc errorReadingString      ;branch taken if not digit
639	.8626					parseDecimalDigit:
640	.8626	85 e6		sta $e6		                sta $E6                     ;save current value
641	.8628	20 46 86	jsr $8646	                jsr readNextDigitFromString
642	.862b	90 ee		bcc $861b	                bcc parsedValue ;branch taken if not digit, meaning number
643						                                     ;parsed successfully
644	.862d	aa		tax		                tax                         ;X=digit

646						                ; calculate (value*4+value)*2 - i.e., value*10. Carry
647						                ; at any point indicates the value was greater than
648						                ; 255, and therefore an error.
649	.862e	a5 e6		lda $e6		                lda $E6                     ;value
650	.8630	0a		asl a		                asl a                       ;value*2
651	.8631	b0 26		bcs $8659	                bcs errorReadingString
652	.8633	0a		asl a		                asl a                       ;value*4
653	.8634	b0 23		bcs $8659	                bcs errorReadingString
654	.8636	65 e6		adc $e6		                adc $E6                     ;value*5
655	.8638	b0 1f		bcs $8659	                bcs errorReadingString
656	.863a	0a		asl a		                asl a                       ;value*10
657	.863b	b0 1c		bcs $8659	                bcs errorReadingString
658	.863d	85 e6		sta $e6		                sta $E6                      ;save value*10
659	.863f	8a		txa		                txa                          ;A=digit
660	.8640	65 e6		adc $e6		                adc $E6                      ;value*10+digit
661	.8642	90 e2		bcc $8626	                bcc parseDecimalDigit
