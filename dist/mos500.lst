13541						;-------------------------------------------------------------------------
13542						;
13543						; Parse file name. Handle (and skip) any -FS- tempfs syntax, selecting
13544						; the FS specified if required.
13545						;
13546						; entry:
13547						;
13548						; Y (MSB)/X (LSB) = address of file name string
13549						;
13550						; exit:
13551						;
13552						; Y (MSB)/X (LSB) = address of file name part
13553						;
13554						; - New FS may have been selected
13555						;
13556	.f9be					parseFileNameAndSelectFS:
13557	.f9be	48		pha		                pha
13558	.f9bf	a5 f2		lda $f2		                lda stringInputBufferAddress+0
13559	.f9c1	48		pha		                pha
13560	.f9c2	a5 f3		lda $f3		                lda stringInputBufferAddress+1
13561	.f9c4	48		pha		                pha
13562	.f9c5	20 40 ee	jsr $ee40	                jsr selectHAZEL
13563	.f9c8	86 f2		stx $f2		                stx stringInputBufferAddress+0
13564	.f9ca	84 f3		sty $f3		                sty stringInputBufferAddress+1
13565	.f9cc	a0 00		ldy #$00	                ldy #$00
13566	.f9ce	20 f6 f9	jsr $f9f6	                jsr parseFileNameFS      ;find -FS- prefix, if any
13567	.f9d1	5a		phy		                phy                      ;save offset
13568	.f9d2	20 9d fa	jsr $fa9d	                jsr selectFS                 ;select desired FS
13569	.f9d5	68		pla		                pla
13570	.f9d6	18		clc		                clc
13571	.f9d7	65 f2		adc $f2		                adc stringInputBufferAddress+0
13572	.f9d9	aa		tax		                tax                          ;save string address LSB
13573	.f9da	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13574	.f9dc	90 01		bcc $f9df	                bcc +
13575	.f9de	c8		iny		                iny
13576	.f9df					+
13577	.f9df	68		pla		                pla
13578	.f9e0	85 f3		sta $f3		                sta stringInputBufferAddress+1
13579	.f9e2	68		pla		                pla
13580	.f9e3	85 f2		sta $f2		                sta stringInputBufferAddress+0
13581	.f9e5	68		pla		                pla
13582	.f9e6	60		rts		                rts

