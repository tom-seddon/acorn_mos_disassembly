14603	.ff51					extendedVectorEntryPoint:
14604						                ; .if CFA3000
14605						                ; ;...
14606						                ; .else
14607						                ; $10b,x = rL
14608	.ff51	48		pha		                pha                 ; $10a,x  (old ROMSEL)
14609	.ff52	48		pha		                pha                 ; $109,x  (old ACCCON)
14610	.ff53	48		pha		                pha                 ; $108,x  (thunk rH)
14611	.ff54	48		pha		                pha                 ; $107,x  (thunk rL)
14612	.ff55	48		pha		                pha                 ; $106,x  (jump dest MSB)
14613	.ff56	48		pha		                pha                 ; $105,x  (jump dest LSB)
14614	.ff57	08		php		                php                 ; $104,x  (P for RTI)
14615	.ff58	48		pha		                pha                 ; $103,x  (old A)
14616	.ff59	da		phx		                phx                 ; $102,x  (old X)
14617	.ff5a	5a		phy		                phy                 ; $101,x  (old Y)
14618	.ff5b	ba		tsx		                tsx
14619	.ff5c	a9 ff		lda #$ff	                lda #>extendedVectorReturnThunk-1
14620	.ff5e	9d 08 01	sta $0108,x	                sta $0108,x
14621	.ff61	a9 8c		lda #$8c	                lda #<extendedVectorReturnThunk-1
14622	.ff63	9d 07 01	sta $0107,x	                sta $0107,x

14624						                ; this routine is only ever called from $ff00, $ff03,
14625						                ; $ff06, etc. - so rL holds vectorIndex*3+2, suitable
14626						                ; for indexing into the extended vector space.
14627	.ff66	bc 0b 01	ldy $010b,x	                ldy $010B,x                  ;Y=vectorIndex*3+2
14628	.ff69	b9 9d 0d	lda $0d9d,y	                lda extendedVectorSpace-2,y  ;get vector LSB
14629	.ff6c	9d 05 01	sta $0105,x	                sta $0105,x                  ;
14630	.ff6f	b9 9e 0d	lda $0d9e,y	                lda extendedVectorSpace-1,y  ;get vector MSB
14631	.ff72	9d 06 01	sta $0106,x	                sta $0106,x
14632	.ff75	a5 f4		lda $f4		                lda $F4
14633	.ff77	9d 0a 01	sta $010a,x	                sta $010A,x
14634	.ff7a	ad 34 fe	lda $fe34	                lda ACCCON
14635	.ff7d	9d 09 01	sta $0109,x	                sta $0109,x

14637						                ; New stack layout:
14638						                ;
14639						                ; $10a,x - old ROMSEL
14640						                ; $109,x - old ACCCON
14641						                ; $108,x - thunk rH
14642						                ; $107,x - thunk rL
14643						                ; $106,x - jump dest MSB
14644						                ; $105,x - jump dest LSB
14645						                ; $104,x - P (for RTI)
14646						                ; $103,x - old A
14647						                ; $102,x - old X
14648						                ; $101,x - old Y

14650	.ff80	20 40 ee	jsr $ee40	                jsr selectHAZEL
14651	.ff83	b9 9f 0d	lda $0d9f,y	                lda extendedVectorSpace,y    ;get vector ROM number
14652	.ff86	20 ab e5	jsr $e5ab	                jsr selectROMA
14653	.ff89	7a		ply		                ply
14654	.ff8a	fa		plx		                plx
14655	.ff8b	68		pla		                pla
14656	.ff8c	40		rti		                rti
14657						;                .endif

