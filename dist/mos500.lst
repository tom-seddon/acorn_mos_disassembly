10179	.edd7					readAdval0:

10198						                ; Put the current ADC channel into Y and the state of the four
10199						                ; joystick direction buttons, three mouse buttons, and fire button
10200						                ; into X

10202	.edd7	ac 4c 02	ldy $024c	                ldy currentADCChannel       ; Y = currentADCChannel
10203	.edda	ae b6 02	ldx $02b6	                ldx adcResultLSBs           ; X = adval0LSB : joystick, mouse and fire switch statuses

10207	.eddd	60		rts		                rts

