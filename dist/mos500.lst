385						;
386						; Get string input buffer address tail according to table byte.
387						;
388						; Entry:
389						;
390						; oscliWorkspace.tablePtr; = pointer to table byte
391						; (stringInputBufferAddress),y = pointer to input
392						;
393						; Exit:
394						;
395						; A = table byte
396						;
397						; if table byte bit 7 set: Y/X points to command line tail
398	.8540					maybeGetStringInputBufferAddress:
399	.8540	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
400	.8542	30 0c		bmi $8550	                bmi rts84FE
401	.8544					getStringInputBufferAddressWithYOffset:
402	.8544	98		tya		                tya
403	.8545					getStringInputBufferAddressWithAOffset:
404	.8545	18		clc		                clc
405	.8546	65 f2		adc $f2		                adc stringInputBufferAddress+0
406	.8548	aa		tax		                tax
407	.8549	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
408	.854b	90 01		bcc $854e	                bcc +
409	.854d	c8		iny		                iny
410	.854e					+
411	.854e	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
412	.8550					rts84FE:
413	.8550	60		rts		                rts

