12590	.f59d	c6 e7		dec $e7		                dec autoRepeatCountdownTimer ;timer--
12591	.f59f	d0 2f		bne $f5d0	                bne braRolloverChecks        ;taken if timer newly 0
12592	.f5a1	ad ca 02	lda $02ca	                lda keyboardFirstAutoRepeatCount
12593	.f5a4	85 e7		sta $e7		                sta autoRepeatCountdownTimer
12594	.f5a6	ad 55 02	lda $0255	                lda keyboardAutoRepeatRate
12595	.f5a9	8d ca 02	sta $02ca	                sta keyboardFirstAutoRepeatCount
12596	.f5ac	ad 5a 02	lda $025a	                lda keyboardStatusByte
12597	.f5af	a6 ec		ldx $ec		                ldx lastKeyPressedInternal
12598	.f5b1	e0 d0		cpx #$d0	                cpx #$80|key_shift_lock
12599	.f5b3	f0 12		beq $f5c7	                beq shiftLockPressed
