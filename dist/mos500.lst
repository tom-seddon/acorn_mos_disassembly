830						                ; select the non-sram data pointer
831	.8f63	8a		txa		                txa
832	.8f64	49 02		eor #$02	                eor #sramTransferPointers.src^sramTransferPointers.dest
833	.8f66	aa		tax		                tax
834	.8f67	90 0a		bcc $8f73	                bcc subtractY

836						                ; store data address in the non-sram pointer
