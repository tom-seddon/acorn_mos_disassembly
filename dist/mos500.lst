8232						;-------------------------------------------------------------------------

8234						; Digital joystick input processing
8235						;
8236						; The handleDigitalJoystick  routine below is called every centisecond (100Hz)
8237						; to process digital joystick inputs and simulate analogue ADVAL channels
8238						; 1 and 2. It supports multiple operating modes configured via *CONFIGURE
8239						; and *FX commands:
8240						;
8241						; PROPORTIONAL MODE (*CONFIGURE PROPORTIONAL or *FX190,<rate 0-7>):
8242						;   Uses an integration algorithm to convert instantaneous digital switch states
8243						;   into smoothly varying 16-bit ADVAL channel values that simulate analogue
8244						;   joystick deflection. The algorithm implements linear acceleration with
8245						;   velocity limiting:
8246						;
8247						;   - Each polling tick increments a counter (joystickRepeatCounter) while a
8248						;     direction is held
8249						;   - The channel value increment is calculated as: counter * 2^rate
8250						;   - This produces quadratic growth: deflection increases as the square of time
8251						;   - When the increment's MSB exceeds the configured rate value, velocity
8252						;     limiting activates
8253						;   - Limited velocity equals rate * 256, producing linear growth thereafter
8254						;   - When input is released, the joystickRepeatCounter resets and the channel
8255						;     coasts or holds at its current value, so further joystick input is
8256						;     required to return to the centre value.
8257						;
8258						;   The rate (0-7) is configured via *CONFIGURE STICK <rate> and controls
8259						;   responsiveness: Rate 7 reaches full deflection in ~0.32 s, Rate 1 in ~2.56 s.
8260						;   Rate 0 is special, and causes the effective rate to be 3. Rate values above
8261						;   7 are clamped to 7. Also set by *FX190, <rate 0-7> which implicitly enters
8262						;   proportional mode.
8263						;
8264						; SWITCHED MODE (*CONFIGURE SWITCHED or *FX190,32):
8265						;   Provides instant positioning without acceleration. When a direction is
8266						;   pressed, the corresponding ADVAL channel immediately jumps to minimum
8267						;   ($0000), maximum ($FFFF) depending on the switch state.
8268						;   When released, channels return immediately to center ($7FFF).
8269						;
8270						; Keyboard simulating joystick (*FX4, 3):
8271						;   The cursor keys (up/down/left/right) and COPY key can be mapped to simulate
8272						;   digital joystick inputs. The routine scans these keys via KEYV and combines
8273						;   them with hardware joystick inputs - either joystick or keys can be used
8274						;   simultaneously. This allows keyboard control of joystick-driven software.
8275						;
8276						; Joystick simulating keyboard (*FX190, 64):
8277						;   When bit 6 of adcConversionType is set, the routine reverses the mapping:
8278						;   joystick directions are converted to cursor key equivalents and fire buttons
8279						;   to COPY key. This allows joystick control of keyboard-driven software like
8280						;   the MOS command line editor. In this mode ADVAL(1) and ADVAL(2) will not
8281						;   reflect the state of the â<80><9C>joystickâ<80><9D> position.
8282						;
8283						; INPUT SOURCES:
8284						;   - Hardware joystick: User VIA Port B ($FE60), bits 0-4, active-low
8285						;   - Keyboard: KEYV vector for cursor keys and COPY, returns C=1 when pressed
8286						;
8287						; ADVAL CHANNEL ASSIGNMENTS:
8288						;   Channel 0 (adval0LSB): Switch state byte, bits 0-4 encode directions/buttons
8289						;   Channel 1: Horizontal axis ($0000=right, $7FFF=center, $FFFF=left)
8290						;   Channel 2: Vertical axis ($0000=down, $7FFF=center, $FFFF=up)
8291						;   ...
8292						;   Channel <odd> : equivalent to channel 1
8293						;   Channel <even> : equivalent to channel 2
8294						;
8295						;   NOTE: The horizontal axis sense is INVERTED compared to both screen coordinates
8296						;   and standard mathematical conventions (where increasing X moves right). Here,
8297						;   increasing values move LEFT.
8298						;
8299						; ROM SERVICE CALL DELEGATION:
8300						;   When bit 7 of adcConversionType is set, joystick handling is completely
8301						;   delegated to sideways ROMs via service call $2C (romServiceCallCompactJoystick).
8302						;   This is a tail call in dispatchRomServiceCallOrJoykeys bypasses ALL built-in
8303						;   joystick handling - no keyboard-simulating-joystick, no proportional mode,
8304						;   no switched mode, and no joystick-simulating-keyboard will run.
8305						;
8306						;   This happens REGARDLESS of whether any ROM claims the service call. If no ROM
8307						;   responds, joystick handling simply doesn't occur (ADVAL values remain unchanged).
8308						;
8309						;   To enable ROM delegation: *FX190,128,127 (sets bit 7, preserves other bits)
8310						;   Default value is loaded from CMOS at boot; no *CONFIGURE setting exists.
8311						;
8312						;   ROMs implementing service call $2C receive:
8313						;   - A register = service call number ($2C)
8314						;   - Y register = page 2 offset for ADVAL workspace ($B6 = offset to $02B6)
8315						;   - Should write joystick data to $0200+Y through $0200+Y+4 (5 bytes)
8316						;   - Return X=0 to claim (stops service call chain)
8317						;   - Return A unchanged to pass to next lower-priority ROM
8318						;
8319						;   Use case: Hardware expansions (real analogue joystick interfaces) can
8320						;   completely replace the built-in digital joystick support.
8321						;
8322						;   This is an either/or choice:
8323						;   - Bit 7 clear = built-in handling (modes described above)
8324						;   - Bit 7 set = ROM-only handling (built-in code skipped entirely)
8325						;

8327						; The switchToKey table is used to enter ASCII key values into the keyboard
8328						; buffer depending on the contents of ADVAL(0) lo-byte in page 2. (i.e. the
8329						; contents of the address $0200 + adcResultLSBs). The X register value used to
8330						; index into this table will represent the bit index according to b = 8 - X
8331						;
8332						; Note that each byte is a keyboard buffer input value, subject to subsequent
8333						; translation by the mechanisms of *FX4, OSRDCH/INKEY which is why some of the
8334						; values are ASCII (delete and return) whereas others, like the edit keys are
8335						; are neither their ASCII, INKEY nor internal key codes (though are deceptively
8336						; close in value!)

8338						;                Keyboard buffer   Switch         X  ADVAL(0)       Key
8339						;                input values                          bit    equivalent

8341	>e78b	00				switchToKey:    .byte 0         ;                 0     n/a
8342	>e78c	8d				                .byte $8D       ;  joystick right 1     b7      cursor right
8343	>e78d	8f				                .byte $8F       ;  joystick up    2     b6      cursor up
8344	>e78e	8e				                .byte $8E       ;  joystick down  3     b5      cursor down
8345	>e78f	8c				                .byte $8C       ;  joystick left  4     b4      cursor left
8346	>e790	7f				                .byte $7F       ;  mouse right    5     b3      delete key
8347	>e791	0d				                .byte $D        ;  mouse middle   6     b2      return key
8348	>e792	8b				                .byte $8B       ;  mouse left     7     b1      copy key
8349	>e793	8b				                .byte $8B       ;  joystick fire  8     b0      copy key

8351						; The joyKeys table is used to define the keys which have joystick-like effects,
8352						; where the cursor keys move the joystick in the appropriate direction, and the
8353						; copy key is equivalent to the fire button.

8355	>e794	96				joyKeys:        .byte $96       ; INKEY copy
8356	>e795	e6				                .byte $E6       ; INKEY cursor left
8357	>e796	d6				                .byte $D6       ; INKEY cursor down
8358	>e797	c6				                .byte $C6       ; INKEY cursor up
8359	>e798	86				                .byte $86       ; INKEY cursor right

8361						;-------------------------------------------------------------------------

8363						; One challenge here is that the adcResultLSBs and adcResultMSBs labels are
8364						; misleading for MOS 5.x because the layout of the ADC workspace is quite
8365						; different in this version compared to MOS 3.x.
8366						;
8367						; The MOS 5.x workspace layout is as follows:
8368						;
8369						; $02b6 - ADVAL channel 0 LSB
8370						; $02b7 - ADVAL channel 1 or 3 LSB
8371						; $02b8 - ADVAL channel 1 or 3 MSB
8372						; $02b9 - ADVAL channel 2 or 4 LSB
8373						; $02ba - ADVAL channel 2 or 4 MSB
8374						; $02bb - temporary variables
8375						; $02bc - temporary variables
8376						; $02bd - temporary variables

8378						; To make this 5.x code more comprehensible, we compute 5.x labels with more
8379						; appropriate names from the 3.x labels.

8381	=$2b6					adval0LSB   = adcResultLSBs          ; $02b6
8382	=695					adval1LSB   = adcResultLSBs + 1      ; $02b7
8383	=696					adval1MSB   = adcResultLSBs + 2      ; $02b8
8384	=697					adval2LSB   = adcResultLSBs + 3      ; $02b9
8385	=698					adval2MSB   = adcResultLSBs + 4      ; $02ba  also adcResultMSB
8386	=699					advalIncLSB = adcResultLSBs + 5      ; $02bb  also adcResultMSB + 1
8387	=700					advalIncMSB = adcResultLSBs + 6      ; $02bc  also adcResultMSB + 2
8388	=701					advalTemp   = adcResultLSBs + 7      ; $02bd  also adcResultMSB + 3

8390						; The advalTemp entry of the workspace is used for several variables
8391						; at different times. For clarity, we name them here:
8392	=701					keyDelay = advalTemp
8393	=701					joystickRepeatCounter = advalTemp

8395						; Moreover, the location of adcLastChannelRead is also reused to store joystick
8396						; related keypresses, so we introduce another alias
8397	=$2be					currentKey = adcLastChannelRead

8399	.e799					handleDigitalJoystick:.block                        ; Joystick centisecond polling
8400	.e799	ad 4d 02	lda $024d	                lda maximumADCChannel               ; If the maximum ADC channel is zero
8401	.e79c	f0 ec		beq $e78a	                beq rtsE7B0                         ; nothing to do, so return
8402	.e79e	2c 4e 02	bit $024e	                bit adcConversionType               ; If bit 6 of adcConversionType is
8403	.e7a1	50 3b		bvc $e7de	                bvc dispatchRomServiceCallOrJoykeys ; clear then skip forward to delegate to ROM service call or convert keypress to joystick

8405						                                                    ; adcConversionType bit 6 is set, so convert switched
8406						                                                    ; digital joystick to keypress equivalents

8408	.e7a3	ad b6 02	lda $02b6	                lda adval0LSB                       ; A = adval0LSB (offset in page 2)
8409	.e7a6	a2 00		ldx #$00	                ldx #0                              ; X = 0

8411	.e7a8					scanSwitchBitsLoop:                         ; Loop that finds the first set bit in adval0LSB
8412						                                            ; Process the ADVAL 0 digital joystick directions / mouse buttons / fire buttons
8413						                                            ; As we shift the left-most bits of A into C, X keeps track of the bit number. Note that this
8414						                                            ; processes the bits in priority order from bit 7 to bit 0, with only the first set bit being
8415						                                            ; translated to a key through the switchToKey table.
8416	.e7a8	e8		inx		                inx                         ; X += 1 : X represents b = 8 - X where b is the bit index into the adval0LSB value
8417	.e7a9	0a		asl a		                asl a                       ; Shift left, bit 7 into carry
8418	.e7aa	b0 03		bcs $e7af	                bcs lookupSwitchKey         ; If bit 7 was set (i.e. bit 8 - X of ADVAL 0), take lookupSwitchKey
8419	.e7ac	d0 fa		bne $e7a8	                bne scanSwitchBitsLoop      ; If set bits remain, next iteration of scanSwitchBitsLoop
8420	.e7ae	aa		tax		                tax                         ; X = A

8422	.e7af					lookupSwitchKey:                                        ; Converts switch bit position to keyboard code via table lookup
8423	.e7af	bc 8b e7	ldy $e78b,x	                ldy switchToKey,x                       ; Y = entry in switchToKey table at index X
8424	.e7b2	cc be 02	cpy $02be	                cpy currentKey                          ; Is the new key (Y) the same as the previous key (currentKey)?
8425	.e7b5	8c be 02	sty $02be	                sty currentKey                          ; Update the current key (from Y)
8426	.e7b8	f0 0c		beq $e7c6	                beq handleRepeatDelay                   ; If C (Y == currentKey) handleRepeatDelay
8427	.e7ba	98		tya		                tya                                     ; A = Y
8428	.e7bb	f0 09		beq $e7c6	                beq handleRepeatDelay                   ; If A = 0 (no keypress) skip over simulated keypress
8429	.e7bd	20 a9 eb	jsr $eba9	                jsr insertCharacterIntoKeyboardBuffer   ; On entry Y = keyboard buffer input value (subject to subsequent translation)
8430	.e7c0	ad 54 02	lda $0254	                lda keyboardAutoRepeatDelay             ; A = keyboardAutoRepeatDelay
8431	.e7c3	8d bd 02	sta $02bd	                sta keyDelay                            ; keyDelay = A

8433	.e7c6					handleRepeatDelay:                                      ; Manages keyboard auto-repeat delay countdown
8434	.e7c6	ad bd 02	lda $02bd	                lda keyDelay                            ; A = keyDelay
8435	.e7c9	f0 13		beq $e7de	                beq dispatchRomServiceCallOrJoykeys     ; If no delay (A = 0) skip to dispatchRomServiceCallOrJoykeys
8436	.e7cb	ce bd 02	dec $02bd	                dec keyDelay                            ; Decrement key delay
8437	.e7ce	d0 0e		bne $e7de	                bne dispatchRomServiceCallOrJoykeys     ; If not yet zero, skip forward to dispatchRomServiceCallOrJoykeys
8438	.e7d0	ad 55 02	lda $0255	                lda keyboardAutoRepeatRate              ; Delay expired, so load keyboardAutoRepeatRate
8439	.e7d3	8d bd 02	sta $02bd	                sta joystickRepeatCounter               ; and store it
8440	.e7d6	ac be 02	ldy $02be	                ldy currentKey                          ; Y = current key ASCII
8441	.e7d9	f0 03		beq $e7de	                beq dispatchRomServiceCallOrJoykeys     ; If Y = 0 (no keypress) skip over simulated keypress
8442	.e7db	20 a9 eb	jsr $eba9	                jsr insertCharacterIntoKeyboardBuffer   ; On entry Y = keyboard buffer input value (subject to subsequent translation)

8444	.e7de					dispatchRomServiceCallOrJoykeys:                        ; Either delegate to a sideway a ROM or check joykeys
8445	.e7de	2c 4e 02	bit $024e	                bit adcConversionType                   ; If bit 7 of adcConversionType is
8446	.e7e1	10 07		bpl $e7ea	                bpl checkEditKeysMode                   ; clear skip the ROM service call, otherwise
8447	.e7e3	a0 b6		ldy #$b6	                ldy #<adval0LSB                         ; make sideways ROM service call &2C
8448	.e7e5	a2 2c		ldx #$2c	                ldx #romServiceCallCompactJoystick      ; with Y = offset into page 2 for
8449	.e7e7	4c f8 ee	jmp $eef8	                jmp makeROMServiceCall                  ; ADVAL results location

8451	.e7ea					checkEditKeysMode:                                      ; Tests if cursor editing mode joyKeys is active *FX 4, 3
8452	.e7ea	a9 ff		lda #$ff	                lda #$FF                                ; A = 255
8453	.e7ec	ae 7d 02	ldx $027d	                ldx editKeysMode                        ; If cursor editing mode (see OSBYTEs 4 and 237)
8454	.e7ef	e0 03		cpx #$03	                cpx #editKeysMode.joyKeys               ; is not equal to joyKeys (Master Compact only) then
8455	.e7f1	d0 14		bne $e807	                bne readJoystickPort                    ; skip over reading the joykeys to reading the joystick port

8457						                ; Otherwise,
8458						                ; make the cursor and arrow keys have a joystick- like effect with the copy-key
8459						                ; simulating the fire button. This routine iterates down through the joyKey table
8460						                ; of INKEY codes testing each key in turn and shifting the results into the low bits
8461						                ; of A giving: 1 1 1 right up down left copy

8463	.e7f3	e8		inx		                inx                     ; X = 4.   Index into joykeys table

8465	.e7f4					scanJoyKeysLoop:                        ; for each joykey
8466	.e7f4	48		pha		                pha                     ; Save the accumulator
8467	.e7f5	da		phx		                phx                     ; Save X
8468	.e7f6	bd 94 e7	lda $e794,x	                lda joyKeys,x           ; A = INKEY code from the Joykeys table at index X
8469	.e7f9	aa		tax		                tax                     ; X = A
8470	.e7fa	38		sec		                sec                     ; Set carry.       | KEYV with C=1, V=0 does a keyboard scan for INKEY X and
8471	.e7fb	b8		clv		                clv                     ; Clear overflow   | returns key-pressed state in C (1=pressed, 0=not pressed)
8472	.e7fc	20 91 ed	jsr $ed91	                jsr LED01               ; Scan the keyboard, ultimately via KEYV
8473	.e7ff	fa		plx		                plx                     ; Restore X
8474	.e800	68		pla		                pla                     ; Restore A
8475	.e801	2a		rol a		                rol a                   ; Rotate C (key state: 1=pressed, 0=not pressed) into A bit 0
8476	.e802	ca		dex		                dex                     ; Decrement X
8477	.e803	10 ef		bpl $e7f4	                bpl scanJoyKeysLoop     ; next joykey

8479						                                        ; At this point A contains active-high key states 1 1 1 right up down left copy
8480						                                        ; (top 3 bits are from original $FF, bottom 5 bits from key scans)

8482	.e805	49 ff		eor #$ff	                eor #$FF                ; Invert to active-low key states 0 0 0 ~right ~up ~down ~left ~copy
8483						                                        ; to match those from the joystick port

8485	.e807					readJoystickPort:   ; Read Joystick port and combine with joykey results

8487						                    ; The Master Compact has a digital Joystick/Mouse port connected
8488						                    ; to User VIA port B through a 9 way D-type connector
8489						                    ; PB0 - Fire  (active low)     - Pin 6
8490						                    ; PB1 - Left  (active low)     - Pin 3
8491						                    ; PB2 - Down  (active low)     - Pin 2
8492						                    ; PB3 - Up    (active low)     - Pin 1
8493						                    ; PB4 - Right (active low)     - Pin 4
8494						                    ; CB1 - No joystick connection - Pin 5
8495						                    ; CB2 - No joystick connection - Pin 9
8496						                    ; +5V - Power                  - Pin 7
8497						                    ; 0V  - Ground                 - Pin 9

8499	.e807	2d 60 fe	and $fe60	                and userVIA.irb                 ; Combine keyboard (A) with joystick port (User VIA Input Register B) both active-low: 0=pressed
8500						                                                ; AND of active-low signals = OR logic (De Morgan): result is 0 if either pressed
8501	.e80a	49 1f		eor #$1f	                eor #$1F                        ; Invert the five lo bits b4-b0 to make A active high
8502	.e80c	4a		lsr a		                lsr a                           ; Shift the 'fire' state into status flag C : A = 0 0 0 0 right up down left
8503	.e80d	08		php		                php                             ; Save status (including C = fire)
8504	.e80e	0a		asl a		                asl a                           ; A = 0 0 0 right up down left 0
8505	.e80f	0a		asl a		                asl a                           ; A = 0 0 right up down left 0 0
8506	.e810	0a		asl a		                asl a                           ; A = 0 right up down left 0 0 0
8507	.e811	28		plp		                plp                             ; Restore status (including C = fire)
8508	.e812	2a		rol a		                rol a                           ; A = right up down left 0 0 0 fire  - now same pattern as switchToKey table and ADVAL 0 lo-byte
8509	.e813	aa		tax		                tax                             ; X = A
8510	.e814	4d b6 02	eor $02b6	                eor adval0LSB                   ; A = changed joystick state bits, by xor with previous state
8511	.e817	2c 4e 02	bit $024e	                bit adcConversionType           ;   If bit 6 of adcConversionType is ...
8512	.e81a	29 f0		and #$f0	                and #$F0                        ; A = changed direction bits (b7-b4) (excludes changed fire state)
8513	.e81c	8e b6 02	stx $02b6	                stx adval0LSB                   ; update adval0LSB to reflect joystick/joykey state (including fire state)
8514	.e81f	70 05		bvs $e826	                bvs exitSwitchedMode            ;   ... set then exitSwitchedMode and the whole routine
8515	.e821	f0 04		beq $e827	                beq calculateJoystickIncrement  ; If same state as previous, continue to calculating the joystick increment
8516	.e823	9c bd 02	stz $02bd	                stz joystickRepeatCounter       ; Clear the key repeat counter

8518	.e826					exitSwitchedMode:
8519	.e826	60		rts		                rts                                     ; exit

8521						;-------------------------------------------------------------------------
8522						; Rate scaling. Converts adcConversionType to a valid rate (1-7), then calculates the increment in
8523						; advalIncMSB:advalIncLSB = joystickRepeatCounter * 2^rate
8524						; The effect is to give exponential sensitiviy scaling - higher rate settings produce much faster movement

8526	.e827					calculateJoystickIncrement:                 ; Joystick state is unchanged since previous call
8527	.e827	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8528	.e82a	f0 06		beq $e832	                beq applyDefaultRate        ; If zero, skip to use 3 as a default
8529	.e82c	c9 08		cmp #$08	                cmp #8                      ; Compare with 8
8530	.e82e	90 04		bcc $e834	                bcc setupRateShift          ; If <8, skip forward to use value (1 to 7) unchanged
8531	.e830	a9 04		lda #$04	                lda #4                      ; A = 4 (out of range sentinel will convert to 7)

8533	.e832					applyDefaultRate:
8534	.e832	49 03		eor #$03	                eor #3                      ; Convert 0 to 3 (the mid-range default) or 4 (out of range sentinel) to 7 (max)

8536	.e834					setupRateShift:
8537	.e834	a8		tay		                tay                         ; Y = emulated one-based analogue joystick rate [1..7] slowest to fastest
8538	.e835	3a		dec a		                dec a                       ; Decrement A
8539	.e836	aa		tax		                tax                         ; X = emulated zero-based analogue joystick rate [0..6] slowest to fastest
8540	.e837	ad bd 02	lda $02bd	                lda joystickRepeatCounter   ; A = repeat counter
8541	.e83a	9c bc 02	stz $02bc	                stz advalIncMSB             ; advalIncMSB = 0

8543	.e83d					rateShiftLoop:
8544	.e83d	ca		dex		                dex                         ; Decrement X (zero-based emulated joystick rate)
8545	.e83e	30 06		bmi $e846	                bmi storeIncrement          ; If X < 0, exit loop
8546	.e840	0a		asl a		                asl a                       ; Shift A (repeat counter) left, b7 into C
8547	.e841	2e bc 02	rol $02bc	                rol advalIncMSB             ; Rotate advalIncMSB left, shifting C in b0
8548	.e844	80 f7		bra $e83d	                bra rateShiftLoop           ; loop

8550	.e846					storeIncrement:
8551	.e846	8d bb 02	sta $02bb	                sta advalIncLSB             ; advalIncLSB = A
8552						                                            ; advalIncMSB:advalIncLSB now contain joystickRepeatCounter << rate

8554						;-------------------------------------------------------------------------
8555						; Velocity limiting.

8558	.e849	cc bc 02	cpy $02bc	                cpy advalIncMSB             ; Compare Y (emulated one-based joystick rate) with advalIncMSB
8559	.e84c	b0 06		bcs $e854	                bcs centerIfSwitchedMode    ; If emulated one-based joystick rate >= advalIncMSB skip limiting
8560	.e84e	8c bb 02	sty $02bb	                sty advalIncLSB             ; advalIncLSB = Y   Clamp advalIncLSB to the rate
8561	.e851	8c bc 02	sty $02bc	                sty advalIncMSB             ; advalIncMSB = Y   Clamp advalIncMSB to the rate

8563	.e854					centerIfSwitchedMode:
8564	.e854	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8565	.e857	29 20		and #$20	                and #$20                    ; Mask for b5 : 0 = emulated proportional, 1 = switched
8566	.e859	f0 0f		beq $e86a	                beq setupDirectionLoop      ; If zero (proportional) skip over the switched joystick move, otherwise switched
8567	.e85b	a9 ff		lda #$ff	                lda #$FF                    ; A = $FF
8568	.e85d	8d b7 02	sta $02b7	                sta adval1LSB               ; adval1LSB = A ($FF)
8569	.e860	8d b9 02	sta $02b9	                sta adval2LSB               ; adval2LSB = A ($FF)
8570	.e863	4a		lsr a		                lsr a                       ; A = $7F
8571	.e864	8d b8 02	sta $02b8	                sta adval1MSB               ; adval1MSB = A ($7F)
8572	.e867	8d ba 02	sta $02ba	                sta adval2MSB               ; adval2MSB = A ($7F)

8574						                                            ; ADVAL(1) == $7FFF  - centre joystick position
8575						                                            ; ADVAL(2) == $7FFF  - centre joystick position

8577	.e86a					setupDirectionLoop:                         ; There are four, 3-byte entries in the joystickDirections
8578	.e86a	a2 09		ldx #$09	                ldx #9                      ; table so the index of the beginning of the last entry is 9

8580	.e86c					joystickDirectionLoop:                      ; Iterate over entries in the joystickDirections table
8581	.e86c	ad b6 02	lda $02b6	                lda adcResultLSBs           ; A = adcResultLSBs which contains the switch states
8582	.e86f	3c d5 e8	bit $e8d5,x	                bit joystickDirections,x    ; Compare the mask in byte 0 of the current entry against the switches
8583	.e872	f0 3e		beq $e8b2	                beq nextDirectionEntry      ; If no match, next table entry
8584	.e874	bd d6 e8	lda $e8d6,x	                lda joystickDirections+1,x  ; A = byte 1 of the current table entry, channel (b0) and direction (b7)
8585	.e877	0a		asl a		                asl a                       ; Shift b0 to b1 and b7 into C
8586	.e878	a8		tay		                tay                         ; Y = A  : 0 -> ADVAL(1), 2 -> ADVAL(2)
8587	.e879	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8588	.e87c	29 20		and #$20	                and #$20                    ; Mask for b5 : 0 = emulated proportional, 1 = switched
8589	.e87e	f0 05		beq $e885	                beq handleProportionalMode  ; If zero (proportional) skip to handleProportionalMode
8590	.e880	bd d7 e8	lda $e8d7,x	                lda joystickDirections+2,x  ; otherwise (switched) A = byte 2 of the current table entry (switch equivalent value)
8591	.e883	80 27		bra $e8ac	                bra storeAdvalChannelLSB    ; and store it

8593						;-------------------------------------------------------------------------

8595	.e885					handleProportionalMode:                     ; store proportional mode results. On entry Y encodes channel, C encodes direction
8596	.e885	b9 b7 02	lda $02b7,y	                lda adval1LSB,y             ; A = current ADVAL(1) LSB if Y = 0, or A = current ADVAL(2) LSB if Y = 2
8597	.e888	b0 12		bcs $e89c	                bcs subtractAdvalIncrement  ; If C set (from ASL in joystickDirectionLoop) direction is -ve,
8598						                                            ; otherwise direction is +ve

8600						                                            ; 16-bit addition of the adval increment to current adval values

8602	.e88a	6d bb 02	adc $02bb	                adc advalIncLSB             ; A = ADVAL(channel) LSB + advalIncLSB
8603	.e88d	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB
8604	.e890	b9 b8 02	lda $02b8,y	                lda adval1MSB,y             ; A = ADVAL(channel) MSB
8605	.e893	6d bc 02	adc $02bc	                adc advalIncMSB             ; A = ADVAL(channel) MSB + advalIncMSB
8606	.e896	90 17		bcc $e8af	                bcc storeAdvalChannelMSB    ; Skip clamping if no overflow
8607	.e898	a9 ff		lda #$ff	                lda #$FF                    ; Clamp to max if overflow
8608	.e89a	80 10		bra $e8ac	                bra storeAdvalChannelLSB    ; and store it

8610						;-------------------------------------------------------------------------

8612	.e89c					subtractAdvalIncrement:                     ; 16-bit subtraction of the adval increment from current adval values
8613						                                            ; On entry A = current ADVAL(channel) LSB, and Y encodes channel
8614	.e89c	ed bb 02	sbc $02bb	                sbc advalIncLSB             ; A = ADVAL(channel) LSB - advalIncLSB
8615	.e89f	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB
8616	.e8a2	b9 b8 02	lda $02b8,y	                lda adval1MSB,y             ; A = ADVAL(channel) MSB
8617	.e8a5	ed bc 02	sbc $02bc	                sbc advalIncMSB             ; A = ADVAL(channel) MSB - advalIncMSB
8618	.e8a8	b0 05		bcs $e8af	                bcs storeAdvalChannelMSB    ; Skip clamping if no underflow
8619	.e8aa	a9 00		lda #$00	                lda #0                      ; Clamp to min if underflow

8621	.e8ac					storeAdvalChannelLSB:
8622	.e8ac	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB, where Y = 0 -> channel 1; Y = 2 -> channel 2

8624	.e8af					storeAdvalChannelMSB:
8625	.e8af	99 b8 02	sta $02b8,y	                sta adval1MSB,y             ; Update ADVAL(channel) MSB, where Y = 0 -> channel 1; Y = 2 -> channel 2

8627	.e8b2					nextDirectionEntry:
8628	.e8b2	ca		dex		                dex                         ; Each joystickDirections table entry is
8629	.e8b3	ca		dex		                dex                         ; three bytes, so decrement X three times
8630	.e8b4	ca		dex		                dex                         ; to point X to the next entry
8631	.e8b5	10 b5		bpl $e86c	                bpl joystickDirectionLoop   ; If still X >= 0 process the entry
8632	.e8b7	ee bd 02	inc $02bd	                inc joystickRepeatCounter   ; Increment joystickRepeatCounter
8633	.e8ba	d0 03		bne $e8bf	                bne emitAdcEvent            ; If joystickRepeatCount > 0, take emitAdcEvent
8634	.e8bc	ce bd 02	dec $02bd	                dec adcResultMSBs+3         ; Decrement joystickRepeatCounter

8636	.e8bf					emitAdcEvent:
8637	.e8bf	ae 4c 02	ldx $024c	                ldx currentADCChannel       ; X = currentADCChannel
8638	.e8c2	a0 03		ldy #$03	                ldy #3                      ; Event 3 is ADC conversion
8639	.e8c4	20 53 eb	jsr $eb53	                jsr eventEntryPoint         ; Emit ADC conversion event
8640	.e8c7	ce 4c 02	dec $024c	                dec currentADCChannel       ; Decrement current ADC channel
8641	.e8ca	f0 02		beq $e8ce	                beq resetToMaxChannel       ; If zero, reset to max ADC channel
8642	.e8cc	10 06		bpl $e8d4	                bpl exitHandleJoystick      ; If positive, we're done -> exit

8644	.e8ce					resetToMaxChannel:
8645	.e8ce	ad 4d 02	lda $024d	                lda maximumADCChannel       ; A = maximum ADC channel
8646	.e8d1	8d 4c 02	sta $024c	                sta currentADCChannel       ; Update the current ADC channel with the max

8648	.e8d4					exitHandleJoystick:
8649	.e8d4	60		rts		                rts                         ; Return
8650						                .endblock

8652						;-------------------------------------------------------------------------
8653						; The joystickDirections table contains four entries of three bytes each, and
8654						; will be processed in decending order. Each entry contains:
8655						;
8656						; Byte 0: Direction bit mask to test against the adval0LSB joystick direction bits
8657						;
8658						; Byte 1: Encodes two pieces of information, both of which are subject to an ASL
8659						;         in the code that processes the table. In the b0 it encodes the ADVAL
8660						;         channel (joystick axis) as,
8661						;
8662						;             0 -> ASL -> 0 -> interpreted as ADVAL(1) x-axis
8663						;             1 -> ASL -> 2 -> interpreted as ADVAL(2) y-axis
8664						;
8665						;         Furthermore, b7 encodes the direction and controls whether the magnitude
8666						;         of the joystick increment is added or subtracted,
8667						;
8668						;             0 -> ASL -> C=0 -> ADD (positive change)
8669						;             1 -> ASL -> C=1 -> SUBTRACT (negative change)
8670						;
8671						;         For example,
8672						;
8673						;             $01 (0000 0001) -> ASL -> $02 -> carry clear -> ADD mode
8674						;             $80 (1000 0000) -> ASL -> $00 -> carry set -> SUBTRACT mode
8675						;             $81 (1000 0001) -> ASL -> $02 -> carry set -> SUBTRACT mode
8676						;
8677						; Byte 2: The value to use is switched mode ($00 min, $FF max)

8679	.e8d5					joystickDirections:

8681	>e8d5	40				    .byte $40   ; UP joystick switch bit mask
8682	>e8d6	01				    .byte $01   ;   ADVAL(2) +ve
8683	>e8d7	ff				    .byte $FF   ;   max switched mode value

8685	>e8d8	20				    .byte $20   ; DOWN joystick switch bit mask
8686	>e8d9	81				    .byte $81   ;   ADVAL(2) -ve
8687	>e8da	00				    .byte $00   ;   min switched mode value

8689	>e8db	80				    .byte $80   ; RIGHT joystick switch bit mask
8690	>e8dc	80				    .byte $80   ;   ADVAL(1) -ve
8691	>e8dd	00				    .byte $00   ;   min switched mode value

8693	>e8de	10				    .byte $10   ; LEFT joystick switch bit mask
8694	>e8df	00				    .byte $00   ;   ADVAL(1) +ve
8695	>e8e0	ff				    .byte $FF   ;   max switched mode value

8699						;-------------------------------------------------------------------------

