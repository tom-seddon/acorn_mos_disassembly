4434	.d599	bd 01 03	lda $0301,x	                lda vduv+1,x                 ;>VX
4435	.d59c	79 01 03	adc $0301,y	                adc vduv+1,y                 ;>(VX+VY)
4436	.d59f	fa		plx		                plx                          ;X=VA
4437	.d5a0	48		pha		                pha                          ;save >(VX+VY)
