420	.8555	ad 00 df	lda $df00	                lda hazel.currentFS
421	.8558	20 9d fa	jsr $fa9d	                jsr selectFS
422	.855b	a9 08		lda #$08	                lda #fscStarCommand
423	.855d	20 93 f2	jsr $f293	                jsr callFSCV
