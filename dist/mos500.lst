6954	.e28a	a2 03		ldx #$03	                ldx #VDUVariables.textWindowTop-VDUVariables.textWindow
6955	.e28c	20 9a e2	jsr $e29a	                jsr getTextWindowRelativePosition
6956	.e28f	aa		tax		                tax                          ;X = Y position
