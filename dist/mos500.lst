416						;
417						; Insert value into bitfield for an item and write the value to NVRAM.
418						;
419						; Entry:
420						;
421						; A = value to insert
422						; X = offset into configure table for item's metadata
423						;
424						; Exit:
425						;
426						; NVRAM byte updated appropriately

428	.88ee					setConfigurationBitfield: .block;L88EE: .block
429	.88ee	85 b0		sta $b0		                sta $B0         ;save value
430	.88f0	20 8d 8b	jsr $8b8d	                jsr getMaskCount ; get mask bit count in Y
431	.88f3	b9 99 8b	lda $8b99,y	                lda maskByBitCount,y ; get appropriate bit mask
432	.88f6	20 84 8b	jsr $8b84	                jsr getShiftCount    ; get shift count in Y
433	.88f9	80 03		bra $88fe	                bra shift            ; start shifting as required
434	.88fb					shiftLoop:
435	.88fb	0a		asl a		                asl a           ;shift mask
436	.88fc	06 b0		asl $b0		                asl $B0         ;shift value

438	.88fe					shift:
439	.88fe	88		dey		                dey
440	.88ff	10 fa		bpl $88fb	                bpl shiftLoop

442						                ; A = shifted mask, ?$B0=shifted value
443	.8901	85 b1		sta $b1		                sta $B1         ;store shifted mask
