620						;
621						; Read configuration byte, given offset of metadata in the configure
622						; table.
623						;
624						; Entry:
625						;
626						; X = offset of metadata in the configure table
627						;
628						; Exit:
629						;
630						; A = value read
631						;
632						; Preserves: X/Y/P

638	.8a64					readConfigurationByte: .block
639	.8a64	08		php		                php
640	.8a65	5a		phy		                phy
641	.8a66	da		phx		                phx
642	.8a67	20 78 8b	jsr $8b78	                jsr getRTCByteIndex ;
643	.8a6a	20 ca 9d	jsr $9dca	                jsr readRTCByte
644	.8a6d	fa		plx		                plx
645	.8a6e	20 84 8b	jsr $8b84	                jsr getShiftCount
646	.8a71	80 01		bra $8a74	                bra shift

648						;-------------------------------------------------------------------------

650	.8a73					shiftLoop:
651	.8a73	4a		lsr a		                lsr a

653	.8a74					shift:
654	.8a74	88		dey		                dey
655	.8a75	10 fc		bpl $8a73	                bpl shiftLoop

657	.8a77	20 8d 8b	jsr $8b8d	                jsr getMaskCount
658	.8a7a	39 99 8b	and $8b99,y	                and maskByBitCount,y
659	.8a7d	e0 07		cpx #$07	                cpx #configureTable.baud.metadata-configureTable
660	.8a7f	d0 01		bne $8a82	                bne gotMaskedByte
661	.8a81	1a		inc a		                inc a

663	.8a82					gotMaskedByte:
664						                ; If retrieving the MODE value, rearrange things so
665						                ; the shadow modes are 128-135.
666	.8a82	e0 4d		cpx #$4d	                cpx #configureTable.mode.metadata-configureTable
667	.8a84	d0 06		bne $8a8c	                bne done        ;taken if not MODE
668	.8a86	89 08		bit #$08	                bit #CMOSBytes.defaults0.shadowMask ;test shadow bit
669	.8a88	f0 02		beq $8a8c	                beq done                                   ;taken if not shadow mode
670	.8a8a	49 88		eor #$88	                eor #$80|CMOSBytes.defaults0.shadowMask ;turn mode|flag into mode|$80

672	.8a8c					done:
673	.8a8c	7a		ply		                ply
674	.8a8d	28		plp		                plp
675	.8a8e	60		rts		                rts
676						                .endblock

678						;-------------------------------------------------------------------------
679						;
680						; Find command in command table.
681						;
682						; Entry:
683						;
684						; (stringInputBufferAddress),y = input
685						; oscliWorkspace.tablePtr; = address of command table
686						; V = 0 if commands have 4 bytes of metadata
687						;     1 if commands have 2 bytes of metadata
688						;
689						; Exit:
690						;
691						; C=0 = no match
692						;
693						; C=1 = match;
694						;       A holds 1st byte of metadata
695						;       oscliWorkspace.tablePtr; = address of 2nd and following metadata bytes
696						;       (stringInputBufferAddress),y = input following command
697						;
698						; Preserves: X/V

700	.8a8f					findCommand: .block
701	.8a8f	84 e6		sty $e6		                sty commandLineY ;save Y
702	.8a91	80 0a		bra $8a9d	                bra checkInput       ;get going...

704	.8a93					checkLetter:
705	.8a93	52 b0		eor ($b0)	                eor (oscliWorkspace.tablePtr)
706	.8a95	29 df		and #$df	                and #$DF
707	.8a97	d0 15		bne $8aae	                bne noMatch    ; taken if char didn't match
708	.8a99	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte
709	.8a9c	c8		iny		                iny

711	.8a9d					checkInput:
712	.8a9d	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
713	.8a9f	20 9c eb	jsr $eb9c	                jsr isLetter
714	.8aa2	90 ef		bcc $8a93	                bcc checkLetter ; taken if letter

716						                ; Non-letter input means potentially end of command
717						                ; name.
718	.8aa4	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr) ; next table byte
719	.8aa6	30 21		bmi $8ac9	                bmi commandMatch ; taken if end of string - a match
720	.8aa8	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
721	.8aaa	c9 2e		cmp #$2e	                cmp #'.'        ; '.' is the abbreviation char
722	.8aac	f0 04		beq $8ab2	                beq abbreviationMatch ;taken with C=1 if match

724	.8aae					noMatch:
725	.8aae	18		clc		                clc             ;indicate no match
726	.8aaf	a4 e6		ldy $e6		                ldy commandLineY ;restore Y
727	.8ab1	88		dey		                dey             ;compensate for upcoming iny

729	.8ab2					abbreviationMatch:
730	.8ab2	c8		iny		                iny             ; skip the '.'

732	.8ab3					findCommandMetadataLoop:
733	.8ab3	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte
734	.8ab6	f0 15		beq $8acd	                beq rts8ACD
735	.8ab8	10 f9		bpl $8ab3	                bpl findCommandMetadataLoop ; keep looping through chars if necessary
736	.8aba	b0 11		bcs $8acd	                bcs rts8ACD                 ;taken if it was a match
737	.8abc	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte   ;discard 2nd metadata byte
738	.8abf	70 dc		bvs $8a9d	                bvs checkInput ; if V=1, 2-byte metadata; if V=0, 4-byte metadata
739	.8ac1	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte ;discard 3rd metadata byte
740	.8ac4	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte ;discard 4th metadata byte
741	.8ac7	80 d4		bra $8a9d	                bra checkInput

743						;-------------------------------------------------------------------------

745	.8ac9					commandMatch:
746	.8ac9	20 ce 8a	jsr $8ace	                jsr fetchCommandTableByte
747	.8acc	38		sec		                sec

749	.8acd					rts8ACD:
750	.8acd	60		rts		                rts
751						                .endblock

753						;-------------------------------------------------------------------------
754						;
755						; Fetch byte from command table with postincrement.
756						;
757						; Entry:
758						;
759						; oscliWorkspace.tablePtr; = address of byte to fetch
760						;
761						; Exit:
762						;
763						; A = byte fetched
764						; oscliWorkspace.tablePtr; incremented
765						;
766						; Preserves: X/Y/C/V

768	.8ace					fetchCommandTableByte:
769	.8ace	e8		inx		                inx
770	.8acf	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
771	.8ad1	48		pha		                pha
772	.8ad2	e6 b0		inc $b0		                inc oscliWorkspace.tablePtr+0
773	.8ad4	d0 02		bne $8ad8	                bne L8AD8
774	.8ad6	e6 b1		inc $b1		                inc oscliWorkspace.tablePtr+1

776	.8ad8					L8AD8:
777	.8ad8	68		pla		                pla
778	.8ad9	60		rts		                rts

780						;-------------------------------------------------------------------------
781						;
782						; Print configure table items.
783						;
784						; Entry:
785						;
786						; C = ???
787						;
788						; V=0 if *CONFIGURE; V=1 if *STATUS
789						;
790	.8ada					L8ADA: .block
791	.8ada	48		pha		                pha
792	.8adb	a0 03		ldy #$03	                ldy #configureTable.baud-configureTable
793	.8add	a2 02		ldx #$02	                ldx #(configureTable.baud-configureTable)-1

795	.8adf					loop:
796	.8adf	e8		inx		                inx
797	.8ae0	bd 87 87	lda $8787,x	                lda configureTable,x ;get name byte
798	.8ae3	f0 5a		beq $8b3f	                beq done            ;all done if 0
799	.8ae5	10 f8		bpl $8adf	                bpl loop            ;keep going until end of name
800						                                     ;reached
801	.8ae7	50 1f		bvc $8b08	                bvc L8B08            ;taken if *CONFIGURE

803						                ; A = metadata byte 0
804	.8ae9	29 40		and #$40	                and #$40
805	.8aeb	f0 10		beq $8afd	                beq L8AFD       ;taken if V0 clear

807	.8aed	bd 88 87	lda $8788,x	                lda configureTable+1,x ;A = metadata byte 1
808	.8af0	30 0b		bmi $8afd	                bmi L8AFD              ;taken if N1 set

810	.8af2	20 64 8a	jsr $8a64	                jsr readConfigurationByte ;Read the actual value
811	.8af5	5d 87 87	eor $8787,x	                eor configureTable,x      ;eor with MatchValue
812	.8af8	29 07		and #$07	                and #7                    ;A=0 if value matches MatchValue
813	.8afa	d0 3d		bne $8b39	                bne next                  ;taken if value isn't MatchValue
814	.8afc	3a		dec a		                dec a                     ;A=$ff

816	.8afd					L8AFD:
817	.8afd	b0 09		bcs $8b08	                bcs L8B08       ;
818	.8aff	10 38		bpl $8b39	                bpl next        ;
819	.8b01	68		pla		                pla
820	.8b02	48		pha		                pha
821	.8b03	5d 88 87	eor $8788,x	                eor configureTable+1,x
822	.8b06	d0 31		bne $8b39	                bne next

824	.8b08					L8B08:
825	.8b08	08		php		                php
826	.8b09	da		phx		                phx
827	.8b0a	50 09		bvc $8b15	                bvc printOrdinaryItem
828	.8b0c	c0 35		cpy #$35	                cpy #configureTable.ignore-configureTable
829	.8b0e	d0 05		bne $8b15	                bne printOrdinaryItem
830	.8b10	20 a1 8b	jsr $8ba1	                jsr readUsePrinterIgnoreChar
831	.8b13	b0 1b		bcs $8b30	                bcs L8B30

833	.8b15					printOrdinaryItem:
837	.8b15	a2 09		ldx #$09	                ldx #9
839	.8b17	20 6b 8b	jsr $8b6b	                jsr printConfigureTableString
840	.8b1a	29 40		and #$40	                and #$40
841	.8b1c	f0 0f		beq $8b2d	                beq printSpaces       ;taken if V0 clear
842	.8b1e	b9 88 87	lda $8788,y	                lda configureTable+1,y
843	.8b21	30 0a		bmi $8b2d	                bmi printSpaces ;taken if N1 set

845						                ; V0 set, N1 clear = newline and next item
846	.8b23	20 e7 ff	jsr $ffe7	                jsr OSNEWL
847	.8b26	80 0f		bra $8b37	                bra next2

849	.8b28					printSpacesLoop:
850	.8b28	a9 20		lda #$20	                lda #' '
851	.8b2a	20 ee ff	jsr $ffee	                jsr OSWRCH

853	.8b2d					printSpaces:
854	.8b2d	ca		dex		                dex
855	.8b2e	10 f8		bpl $8b28	                bpl printSpacesLoop

857	.8b30					L8B30:
858	.8b30	fa		plx		                plx
859	.8b31	28		plp		                plp
860	.8b32	08		php		                php
861	.8b33	da		phx		                phx
862	.8b34	20 84 88	jsr $8884	                jsr L8884

864	.8b37					next2:
865	.8b37	fa		plx		                plx
866	.8b38	28		plp		                plp

868	.8b39					next:
869	.8b39	e8		inx		                inx             ;point X just before next item
870	.8b3a	8a		txa		                txa
871	.8b3b	a8		tay		                tay
872	.8b3c	c8		iny		                iny             ;point Y at next item
873	.8b3d	80 a0		bra $8adf	                bra loop

875	.8b3f					done:
876	.8b3f	68		pla		                pla
877	.8b40	60		rts		                rts
878						                .endblock

