3111	.cee0	20 e7 ce	jsr $cee7	                jsr getNextColumnAddress
3112	.cee3	86 dc		stx $dc		                stx ZTEMPB+0
3113	.cee5	85 dd		sta $dd		                sta ZTEMPB+1

