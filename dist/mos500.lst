5859						;
5860						; Print 0-terminated message using address from stack.
5861						;
5862						; entry:
5863						;
5864						; S=[StrL; StrH] - where Str = (address of string)-1
5865						; Y = 0 to print message; otherwise, don't print message
5866						;
5867	.acf6					printFollowingMessage:                       ;
5868	.acf6	68		pla		                pla
5869	.acf7	85 b8		sta $b8		                sta printMessageAddress+0
5870	.acf9	68		pla		                pla
5871	.acfa	85 b9		sta $b9		                sta printMessageAddress+1
5872	.acfc	5a		phy		                phy                          ;save initial Y
5873	.acfd	98		tya		                tya                          ;Z=1 if Y=0
5874	.acfe	08		php		                php                          ;save Y=0 state
