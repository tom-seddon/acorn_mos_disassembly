14702						; Except for the NMI routine in main RAM, MOS entry points have to
14703						; refer to code in the top 4 KB of the MOS area. HAZEL will probably
14704						; be paged in, and the utils ROM will probably be paged out.
14705						entryPoint: .macro instr,dest
14708						                .endmacro

