3690	.d155	88		dey		                dey                          ;Y=gcolModeInvert
3691	.d156	90 08		bcc $d160	                bcc LD160                    ;taken if invert mode
3692	.d158	aa		tax		                tax              ;X=0 if fg settings, 1 if bg settings
