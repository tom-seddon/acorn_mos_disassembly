882	.8b41					printConfigureTableStringLoop:
886	.8b41	20 ee ff	jsr $ffee	                jsr OSWRCH      ;print char
890	.8b44	48		pha		                pha             ;save A (char to print)
891	.8b45	5a		phy		                phy             ;save Y (table offset)
892	.8b46	98		tya		                tya             ;get table offset in A

897						                ; If we're at a snippet insert point, insert the
898						                ; snippet, recursively.
899	.8b47	a0 02		ldy #$02	                ldy #len(configureTable.textSnippets)-1
900	.8b49					findSnippetInsertPointLoop:
901	.8b49	d9 50 88	cmp $8850,y	                cmp configureTable.textSnippetInsertPointOffsets,y
902	.8b4c	d0 07		bne $8b55	                bne nextSnippetInsertPoint

904						                ; Insert a snippet here. Load the new snippet's offset
905						                ; in Y and repeat.
906	.8b4e	b9 53 88	lda $8853,y	                lda configureTable.textSnippetOffsets,y
907	.8b51	a8		tay		                tay
908	.8b52	20 6b 8b	jsr $8b6b	                jsr printConfigureTableString
909	.8b55					nextSnippetInsertPoint
