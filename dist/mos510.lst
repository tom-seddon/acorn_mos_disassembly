3274						                ; Read address $ff to query the size.
3275	.9e1e	20 bb 90	jsr $90bb	                jsr i2cTestReadEEPROMByte    ; do an experimental read
3276	.9e21	a0 00		ldy #$00	                ldy #0                       ; failure result is 0
3277	.9e23	b0 2b		bcs $9e50	                bcs rts9DE0 ; taken if read failed - no EEPROM present
3278	.9e25	a2 7f		ldx #$7f	                ldx #$7f
3279	.9e27	20 3a 9f	jsr $9f3a	                jsr i2cReadEEPROMByte        ; read the byte at $7f
3280	.9e2a	5a		phy		                phy                          ; save the byte read
3281	.9e2b	a2 ff		ldx #$ff	                ldx #$ff
3282	.9e2d	20 3a 9f	jsr $9f3a	                jsr i2cReadEEPROMByte        ; read the byte at $ff
3283	.9e30	98		tya		                tya                          ; A = byte from $ff
3284	.9e31	ba		tsx		                tsx

3286	.9e32	5d 01 01	eor $0101,x	                eor $101,x
3287						                ; The EEPROM contents reset code EORs the byte at +$7f
3288						                ; with $80, and stores that at +$ff. So either the
3289						                ; result is 0 (+$7f and +$ff are the same byte: it's a
3290						                ; 128-byte EEPROM) or it's a value with bit 8 clear
3291						                ; (+$7f and +$ff are not the same byte: it's a
3292						                ; 256-byte EEPROM).
3293	.9e35	09 7f		ora #$7f	                ora #$7f ; 127 if 128-byte EEPROM; 255 if 256-byte EEPROM
