385						;
386						; Get string input buffer address tail according to table byte.
387						;
388						; Entry:
389						;
390						; oscliWorkspace.tablePtr; = pointer to table byte
391						; (stringInputBufferAddress),y = pointer to input
392						;
393						; Exit:
394						;
395						; A = table byte
396						;
397						; if table byte bit 7 set: Y/X points to command line tail
398	.857d					maybeGetStringInputBufferAddress:
399	.857d	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
400	.857f	30 0c		bmi $858d	                bmi rts84FE
401	.8581					getStringInputBufferAddressWithYOffset:
402	.8581	98		tya		                tya
403	.8582					getStringInputBufferAddressWithAOffset:
