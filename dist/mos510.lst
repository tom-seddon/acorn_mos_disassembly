12544						;-------------------------------------------------------------------------
12545						;
12546						; Test Shift & Ctrl keys, or deal with timer interrupt.
12547						;
12548						; Entry: C=0 if KEYV V=0 C=0 - test SHIFT+CTRL keys
12549						;        C=1 if KEYV V=1 C=1 - keyboard timer interrupt
12550						;
12551	.f55c					keyTestSHIFTAndCTRLOrTimerInterrupt:
12552	.f55c	ad 5a 02	lda $025a	                lda keyboardStatusByte
12553	.f55f	29 b7		and #$b7	                and #~(keyboardStatusByte.shiftPressed|keyboardStatusByte.ctrlPressed)
12554	.f561	a2 00		ldx #$00	                ldx #key_shift
12555	.f563	20 f9 f6	jsr $f6f9	                jsr interrogateKeyboard      ;X=$80 if SHIFT pressed
12556	.f566	90 02		bcc $f56a	                bcc +                        ;taken if testing
12557						                                             ;SHIFT+CTRL only
12558	.f568	86 fa		stx $fa		                stx SEIWKA                   ;b7 set if SHIFT pressed
12559	.f56a					+
12560	.f56a	b8		clv		                clv                        ;V=0
12561	.f56b	10 05		bpl $f572	                bpl testCTRL               ;taken if SHIFT not pressed
12562	.f56d	2c 70 e3	bit $e370	                bit valueFF                ;V=1 N=1
12563	.f570	09 08		ora #$08	                ora #keyboardStatusByte.shiftPressed
12564	.f572					testCTRL:
12565	.f572	e8		inx		                inx                          ;X=1 - key_ctrl
12566	.f573	20 f9 f6	jsr $f6f9	                jsr interrogateKeyboard
12567	.f576	90 b9		bcc $f531	                bcc updateKeyboardLEDs ;taken if testing SHIFT+CTRL only
12568	.f578	10 02		bpl $f57c	                bpl updateKeyboardStatusByte ;taken if CTRL not pressed
12569	.f57a	09 40		ora #$40	                ora #keyboardStatusByte.ctrlPressed
12570	.f57c					updateKeyboardStatusByte:
12571	.f57c	8d 5a 02	sta $025a	                sta keyboardStatusByte
12572	.f57f	a6 ec		ldx $ec		                ldx lastKeyPressedInternal
12573	.f581	f0 4d		beq $f5d0	                beq braRolloverChecks        ;taken if no key pressed
12574	.f583	20 f9 f6	jsr $f6f9	                jsr interrogateKeyboard      ;still pressed?
12575	.f586	30 0d		bmi $f595	                bmi checkForKeyAutoRepeat    ;taken if still pressed
12576	.f588	e4 ec		cpx $ec		                cpx lastKeyPressedInternal   ;X=0 at this point
12577	.f58a					storeLastKeyPressed:
12578	.f58a	86 ec		stx $ec		                stx lastKeyPressedInternal   ;update last key pressed
12579	.f58c	d0 42		bne $f5d0	                bne braRolloverChecks  ;taken if still nothing pressed
12580	.f58e	64 ec		stz $ec		                stz lastKeyPressedInternal   ;reset last key pressed
12581	.f590					resetAutoRepeatAndContinue:
12582	.f590	20 ee f6	jsr $f6ee	                jsr resetAutoRepeatCounters
12583	.f593	80 3b		bra $f5d0	                bra braRolloverChecks

