8720	.e8fb	64 eb		stz $eb		                stz tapeCritical
8721	.e8fd	90 24		bcc $e923	                bcc osrdchDone                    ;taken if byte valid
8722	.e8ff	a9 00		lda #$00	                lda #$00                     ;OSFIND close file
8723	.e901	9c 56 02	stz $0256	                stz execFileHandle           ;reset *EXEC handle
8724	.e904	20 ce ff	jsr $ffce	                jsr OSFIND                   ;close *EXEC file
8725	.e907					osrdchLoop:
8726	.e907	a5 ff		lda $ff		                lda escapeFlag               ;b7 set if ESCAPE pressed
8727	.e909	0a		asl a		                asl a                        ;C=1 if ESCAPE pressed
8728	.e90a	a9 1b		lda #$1b	                lda #27                      ;ASCII for ESCAPE
8729	.e90c	b0 15		bcs $e923	                bcs osrdchDone               ;exit with C=1 if ESCAPE
8730						                                             ;pressed
