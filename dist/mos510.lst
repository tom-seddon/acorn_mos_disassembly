207	.8cd9	8a		txa		                txa                       ; A = result
208	.8cda	c9 10		cmp #$10	                cmp #$10
209	.8cdc	b0 d3		bcs $8cb1	                bcs badIdError  ; bad id if >15

211	.8cde					gotROMID:
212						                ; +4 = romid
213	.8cde	8d f1 02	sta $02f1	                sta sramWorkspace.bank

