137	.8c91	b0 1e		bcs $8cb1	                bcs badIdError  ; bad id if >=$14
138	.8c93	49 14		eor #$14	                eor #$14        ; $10->$04, $11->$05, $12->$06, $13->$07
139	.8c95	8d f1 02	sta $02f1	                sta sramWorkspace.bank

