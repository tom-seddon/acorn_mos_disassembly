199						                ; be "1" or the first char of "10", "11", etc. Handle
200						                ; accordingly.
201						                ;
202						                ; (If using the W/X/Y/Z syntax, the banks are 4-7.)
203	.8cd1	c9 01		cmp #$01	                cmp #1
