10493						;
10494						; Pass service call around sideways ROMs
10495						;
10496						; Entry:
10497						; X=service call number
10498						; Y=any parameters
10499						;
10500						; Exit:
10501						; X=0 or preserved
10502						; Y=any returned parameters
10503						; EQ=call claimed if called directly
10504						;
10505	.eef8					makeROMServiceCall: .proc                    ;ee72
10506	.eef8	a5 f4		lda $f4		                lda $F4         ; Save current ROM
10507	.eefa	48		pha		                pha
10508	.eefb	ad 34 fe	lda $fe34	                lda ACCCON      ; Save current paging state
10509	.eefe	48		pha		                pha
10510	.eeff	20 40 ee	jsr $ee40	                jsr selectHAZEL ; Page in Hazel
10511	.ef02	8a		txa		                txa             ; Pass service call number to A
10512	.ef03	a2 0f		ldx #$0f	                ldx #$0F     ; Start at ROM 15, and always call ROM 15
10513	.ef05	80 05		bra $ef0c	                bra callServiceEntry
10514	.ef07					callServiceEntriesLoop:
10515	.ef07	3c a1 02	bit $02a1,x	                bit romInformationTable,x ;check if ROM X has a service entry
10516	.ef0a	10 0b		bpl $ef17	                bpl nextROM       ;branch taken if no service entry
10517	.ef0c					callServiceEntry:
10518	.ef0c	20 9a e5	jsr $e59a	                jsr selectROMX  ; Page in ROM X
10519	.ef0f	20 03 80	jsr $8003	                jsr $8003       ; Call ROM service entry point
10520	.ef12	aa		tax		                tax             ; X = service call result
10521	.ef13	f0 05		beq $ef1a	                beq done       ;branch taken if service call claimed
10522	.ef15	a6 f4		ldx $f4		                ldx $F4         ; Get ROM number
10523	.ef17					nextROM:
10524	.ef17	ca		dex		                dex       ; Step down to next ROM, loop until all done
10525	.ef18	10 ed		bpl $ef07	                bpl callServiceEntriesLoop

10527	.ef1a					done:
10528	.ef1a	68		pla		                pla                          ; Restore paging state
10529	.ef1b	20 36 ee	jsr $ee36	                jsr selectMOSOrHAZEL
10530	.ef1e	68		pla		                pla                          ; Restore current ROM
10531	.ef1f	20 ab e5	jsr $e5ab	                jsr selectROMA
10532	.ef22	8a		txa		                txa                          ; Pass claim/noclaim to A
10533	.ef23	60		rts		                rts
10534						                .pend

