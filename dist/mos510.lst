712						                ; convert ASCII A-F hex digit to number.
713	.86a7	49 48		eor #$48	                eor #$48
714	.86a9	1a		inc a		                inc a
715	.86aa					+
716	.86aa	c8		iny		                iny
717	.86ab	60		rts		                rts

