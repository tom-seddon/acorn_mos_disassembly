13845	.fae9					fileswitchFSCUnknownCommand:
13846	.fae9	fa		plx		                plx
13847	.faea	20 11 fb	jsr $fb11	                jsr getCommandLinePointer
13848	.faed	80 de		bra $facd	                bra fileswitchPassFSCToCurrentFS_X

13850						;-------------------------------------------------------------------------
13851						;
13852						; FSC 1 - check EOF [AUG p343]
13853						;
13854	.faef					fileswitchFSCCheckEOF:
13855	.faef	7a		ply		                ply                         ;Y = file handle
13856	.faf0	5a		phy		                phy                         ;restore stack arrangement
13857	.faf1	20 e7 f9	jsr $f9e7	                jsr selectFSForHandle
13858	.faf4	80 d6		bra $facc	                bra fileswitchPassFSCToCurrentFS

13860						;-------------------------------------------------------------------------
13861						;
13862						; FSC 0 - *OPT [AUG p343]
13863						;
13864	.faf6					fileswitchFSCOPT:
13865	.faf6	2c c6 df	bit $dfc6	                bit hazel.tempFSFlag   ; Check temporary fs flag
13866	.faf9	70 d1		bvs $facc	                bvs fileswitchPassFSCToCurrentFS
13867	.fafb	ad 00 df	lda $df00	                lda hazel.currentFS ; Get current filing system number

13869						;-------------------------------------------------------------------------
13870						;
13871						; Pass FSCV request through to a particular FS.
13872						;
13873						; entry:
13874						;
13875						; A = FS to select
13876						;
13877						; Y = FSCV Y
13878						;
13879						; S = [FSCV X; FSCV A]
13880						;
13881	.fafe					fileswitchPassFSCToSpecificFS:
13882	.fafe	20 9d fa	jsr $fa9d	                jsr selectFS        ; Select filing system
13883	.fb01	80 c9		bra $facc	                bra fileswitchPassFSCToCurrentFS

13885						;-------------------------------------------------------------------------
13886						;
13887						; FSC 2 - */filename [AUG p343]
13888						; FSC 4 - *RUN filename [AUG p344]
13889						;
13890	.fb03					fileswitchFSCStarSlash:
13891	.fb03					fileswitchFSCStarRUN:
13892	.fb03	fa		plx		                plx
13893	.fb04	20 11 fb	jsr $fb11	                jsr getCommandLinePointer ; Skip '*'s and spaces, set command line address
13894	.fb07	da		phx		                phx             ; Continue on to pass to filing system

13897						;-------------------------------------------------------------------------
13898						;
13899						; FSC 5 - *CAT [AUG p344]
13900						; FSC 9 - *EX [NAUG p257]
13901						; FSC, 10 - *INFO [NAUG p257]
13902						;
13903	.fb08					fileswitchFSCStarCAT:
13904	.fb08					fileswitchFSCStarEX:
13905	.fb08					fileswitchFSCStarINFO:
13906	.fb08	fa		plx		                plx
13907	.fb09	0e c6 df	asl $dfc6	                asl hazel.tempFSFlag
13908	.fb0c	20 be f9	jsr $f9be	                jsr parseFileNameAndSelectFS
13909	.fb0f	80 bc		bra $facd	                bra fileswitchPassFSCToCurrentFS_X

13911						;-------------------------------------------------------------------------
13912						;
13913						; Get command line pointer.
13914						;
13915						; Entry:
13916						;
13917						; X/Y - pointer to CR-terminated command line string
13918						;
13919						; Exit:
13920						;
13921						; X/Y, (hazel.commandLinePointer) - pointer to first non-space char in
13922						; command line string
13923	.fb11					getCommandLinePointer: .proc ;fbc1
13924	.fb11	86 f2		stx $f2		                stx stringInputBufferAddress+0
13925	.fb13	84 f3		sty $f3		                sty stringInputBufferAddress+1

13927						; skip spaces. Stop if terminating CR encountered.

13929	.fb15	a0 ff		ldy #$ff	                ldy #$FF
13930	.fb17					-
13931	.fb17	c8		iny		                iny
13932	.fb18	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13933	.fb1a	c9 0d		cmp #$0d	                cmp #$0D
13934	.fb1c	f0 04		beq $fb22	                beq +
13935	.fb1e	c9 20		cmp #$20	                cmp #' '
13936	.fb20	d0 f5		bne $fb17	                bne -

13938	.fb22					+

13940						; Hmm. Didn't we just do this bit already?

13942	.fb22	20 ad f3	jsr $f3ad	                jsr skipSpacesAndCheckForCRInStringInput

13944						; Store address of first non-space char in the HAZEL command line
13945						; pointer.

13947	.fb25	98		tya		                tya
13948	.fb26	18		clc		                clc
13949	.fb27	65 f2		adc $f2		                adc stringInputBufferAddress+0
13950	.fb29	8d 04 df	sta $df04	                sta hazel.commandLinePointer+0
13951	.fb2c	a5 f3		lda $f3		                lda stringInputBufferAddress+1
13952	.fb2e	69 00		adc #$00	                adc #$00
13953	.fb30	8d 05 df	sta $df05	                sta hazel.commandLinePointer+1
13954	.fb33	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13955	.fb35	a6 f2		ldx $f2		                ldx stringInputBufferAddress+0
13956	.fb37	60		rts		                rts
13957						                .pend

13959						;-------------------------------------------------------------------------
13960						;
13961						; FSC 11 - RUN from libfs [NAUG p257]
13962						;
13963	.fb38					fileswitchFSCRUNLibrary:
13964	.fb38	ad 02 df	lda $df02	                lda hazel.libFS      ; Is a libfs set?
13965	.fb3b	10 c1		bpl $fafe	                bpl fileswitchPassFSCToSpecificFS
13966	.fb3d					badCommandError:
13967	.fb3d	00		brk #		                brk
13968	>fb3e	fe				                .byte 254
13969	>fb3f	42 61 64 20 63 6f 6d 6d		                .text "Bad command"
	>fb47	61 6e 64
13970	.fb4a	00		brk #		                brk

