13609						;-------------------------------------------------------------------------
13610						;
13611						; Parse the FS part of a file name, if any, and return the filing
13612						; system to use.
13613						;
13614						; Entry:
13615						;
13616						; (stringInputBufferAddress),y = the string
13617						;
13618						; Exit:
13619						;
13620						; A = FS number to use
13621						;
13622						; (stringInputBufferAddress),y = next char after any tempfs prefix has
13623						; been consumed
13624	.f9f6					parseFileNameFS: .proc

13626	.f9f6	4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13627	.f9f9	20 ad f3	jsr $f3ad	                jsr skipSpacesAndCheckForCRInStringInput
13628	.f9fc	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13629	.f9fe	c9 2d		cmp #$2d	                cmp #'-'
13630	.fa00	f0 0c		beq $fa0e	                beq parseFSNamePrefix ; branch taken if tempfs syntax
13631	.fa02	2c c6 df	bit $dfc6	                bit hazel.tempFSFlag
13632	.fa05	ad 00 df	lda $df00	                lda hazel.currentFS
13633	.fa08	50 03		bvc $fa0d	                bvc +
13634	.fa0a	ad 01 df	lda $df01	                lda hazel.activeFS
13635	.fa0d					+
13636	.fa0d	60		rts		                rts

13638	.fa0e					parseFSNamePrefix:
13639	.fa0e	c8		iny		                iny
13640	.fa0f	a2 00		ldx #$00	                ldx #$00
13641	.fa11					LFAC1:
13642	.fa11	bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;get FS name char
13643	.fa14	f0 44		beq $fa5a	                beq badFilingSystemName
13644	.fa16	8a		txa		                txa                      ;A=offset in info blocks
13645	.fa17	18		clc		                clc
13646	.fa18	69 08		adc #$08	                adc #size(fsInfoBlock.name)
13647	.fa1a	85 b0		sta $b0		                sta parseFileNameFSWorkspace.fsInfoOffset
13648	.fa1c	5a		phy		                phy
13649	.fa1d					compareFSNameLoop:
13650	.fa1d	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y

13652						; validate FS name char. Must be letter or digit.

13654	.fa1f	20 9c eb	jsr $eb9c	                jsr isLetter
13655	.fa22	90 08		bcc $fa2c	                bcc validFSNameChar           ;branch taken if letter
13656	.fa24	c9 30		cmp #$30	                cmp #'0'
13657	.fa26	90 1b		bcc $fa43	                bcc notValidFSNameChar       ;branch taken if not digit
13658	.fa28	c9 3a		cmp #$3a	                cmp #'9'+1
13659	.fa2a	b0 17		bcs $fa43	                bcs notValidFSNameChar       ;branch taken if not digit
13660	.fa2c					validFSNameChar:
13661	.fa2c	e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13662	.fa2e	b0 0b		bcs $fa3b	                bcs nextFSInfoBlock ;branch taken if end of FS
13663						                                         ;info block name was reached
13664	.fa30	5d 06 df	eor $df06,x	                eor hazel.fsInfoBlocks,x
13665	.fa33	29 df		and #$df	                and #$DF                 ;Z=1 if char matches FS name
13666	.fa35	d0 04		bne $fa3b	                bne nextFSInfoBlock      ;branch taken if not a match
13667	.fa37	e8		inx		                inx                      ;next fs info block byte
13668	.fa38	c8		iny		                iny                      ;next input string byte
13669	.fa39	80 e2		bra $fa1d	                bra compareFSNameLoop

13671	.fa3b					nextFSInfoBlock:
13672	.fa3b	7a		ply		                ply
13673	.fa3c	a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset ;offset of end of name
13674	.fa3e	e8		inx		                inx
13675	.fa3f	e8		inx		                inx
13676	.fa40	e8		inx		                inx             ;advance to next entry
13677	.fa41	80 ce		bra $fa11	                bra LFAC1

13679	.fa43					notValidFSNameChar:

13681						; Matching FS name must be terminated with -. Otherwise, it's bad
13682						; syntax, or perhaps an overly long name.

13684	.fa43	c9 2d		cmp #$2d	                cmp #'-'
13685	.fa45	d0 13		bne $fa5a	                bne badFilingSystemName
13686	.fa47	c8		iny		                iny                       ;consume input '-'
13687	.fa48	e4 b0		cpx $b0		                cpx parseFileNameFSWorkspace.fsInfoOffset
13688	.fa4a	f0 07		beq $fa53	                beq foundFSInfoBlock     ;branch taken if a match due
13689						                                         ;to being right at end of the
13690						                                         ;FS info block name
13691	.fa4c	bd 06 df	lda $df06,x	                lda hazel.fsInfoBlocks,x ;
13692	.fa4f	c9 20		cmp #$20	                cmp #' '
13693	.fa51	d0 e8		bne $fa3b	                bne nextFSInfoBlock      ;branch taken if not a match
13694						                                         ;as tthe supplied name was a
13695						                                         ;prefix of this FS's name
13696	.fa53					foundFSInfoBlock:
13697	.fa53	68		pla		                pla
13698	.fa54	a6 b0		ldx $b0		                ldx parseFileNameFSWorkspace.fsInfoOffset
13699	.fa56	bd 08 df	lda $df08,x	                lda hazel.fsInfoBlocks+(fsInfoBlock.fsNumber-(fsInfoBlock.name+size(fsInfoBlock.name))),x
13700	.fa59	60		rts		                rts

13702	.fa5a					badFilingSystemName:
13703	.fa5a	00		brk #		                brk
13704	>fa5b	f8 42 61 64 20 66 69 6c		                .text $f8,'Bad filing system name',0
	>fa63	69 6e 67 20 73 79 73 74 65 6d 20 6e 61 6d 65 00
13705						                .pend

13707						;-------------------------------------------------------------------------
13708						;
13709						; Find FS for the given handle
13710						;
13711						; entry:
13712						;
13713						; Y = file handle
13714						;
13715						; exit:
13716						;
13717						; X = FS number - will just use current FS if none suitable found
13718						;
13719	.fa73					findFSForHandle: .proc
13720	.fa73	48		pha		                pha                          ;
13721	.fa74	5a		phy		                phy                          ;
13722	.fa75	98		tya		                tya                          ;A = handle to search for
13723	.fa76	a0 00		ldy #$00	                ldy #$00                     ;
13724	.fa78					loop:
13725	.fa78	be 06 df	ldx $df06,y	                ldx hazel.fsInfoBlocks.name+0,y
13726	.fa7b	f0 15		beq $fa92	                beq notFound                  ;taken if terminating entry
13727	.fa7d	d9 0e df	cmp $df0e,y	                cmp hazel.fsInfoBlocks.minHandle,y
13728	.fa80	90 07		bcc $fa89	                bcc next                     ;taken if not this FS
13729	.fa82	d9 0f df	cmp $df0f,y	                cmp hazel.fsInfoBlocks.maxHandle,y
13730	.fa85	90 10		bcc $fa97	                bcc found                    ;taken if this FS
13731	.fa87	f0 0e		beq $fa97	                beq found                    ;taken if this FS

13733	.fa89					next:
13734	.fa89	48		pha		                pha
13735	.fa8a	98		tya		                tya
13736	.fa8b	18		clc		                clc
13737	.fa8c	69 0b		adc #$0b	                adc #size(fsInfoBlock)
13738	.fa8e	a8		tay		                tay
13739	.fa8f	68		pla		                pla
13740	.fa90	80 e6		bra $fa78	                bra loop

13742	.fa92					notFound:
13743	.fa92	ae 00 df	ldx $df00	                ldx hazel.currentFS
13744	.fa95	80 03		bra $fa9a	                bra done

13746	.fa97					found:
13747	.fa97	be 10 df	ldx $df10,y	                ldx hazel.fsInfoBlocks.fsNumber,y
13748	.fa9a					done:
13749	.fa9a	7a		ply		                ply
13750	.fa9b	68		pla		                pla
13751	.fa9c	60		rts		                rts
13752						                .endproc

