405	.8583	65 f2		adc $f2		                adc stringInputBufferAddress+0
406	.8585	aa		tax		                tax
407	.8586	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
408	.8588	90 01		bcc $858b	                bcc +
409	.858a	c8		iny		                iny
410	.858b					+
411	.858b	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
412	.858d					rts84FE:
413	.858d	60		rts		                rts

