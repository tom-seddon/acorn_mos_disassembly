678						;-------------------------------------------------------------------------
679						;
680						; Find command in command table.
681						;
682						; Entry:
683						;
684						; (stringInputBufferAddress),y = input
685						; oscliWorkspace.tablePtr; = address of command table
686						; V = 0 if commands have 4 bytes of metadata
687						;     1 if commands have 2 bytes of metadata
688						;
689						; Exit:
690						;
691						; C=0 = no match
692						;
693						; C=1 = match;
694						;       A holds 1st byte of metadata
695						;       oscliWorkspace.tablePtr; = address of 2nd and following metadata bytes
696						;       (stringInputBufferAddress),y = input following command
697						;
698						; Preserves: X/V

700	.8acc					findCommand: .block
701	.8acc	84 e6		sty $e6		                sty commandLineY ;save Y
702	.8ace	80 0a		bra $8ada	                bra checkInput       ;get going...

704	.8ad0					checkLetter:
705	.8ad0	52 b0		eor ($b0)	                eor (oscliWorkspace.tablePtr)
706	.8ad2	29 df		and #$df	                and #$DF
707	.8ad4	d0 15		bne $8aeb	                bne noMatch    ; taken if char didn't match
708	.8ad6	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte
709	.8ad9	c8		iny		                iny

711	.8ada					checkInput:
712	.8ada	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
713	.8adc	20 9c eb	jsr $eb9c	                jsr isLetter
714	.8adf	90 ef		bcc $8ad0	                bcc checkLetter ; taken if letter

716						                ; Non-letter input means potentially end of command
717						                ; name.
718	.8ae1	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr) ; next table byte
719	.8ae3	30 21		bmi $8b06	                bmi commandMatch ; taken if end of string - a match
720	.8ae5	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
721	.8ae7	c9 2e		cmp #$2e	                cmp #'.'        ; '.' is the abbreviation char
722	.8ae9	f0 04		beq $8aef	                beq abbreviationMatch ;taken with C=1 if match

724	.8aeb					noMatch:
725	.8aeb	18		clc		                clc             ;indicate no match
726	.8aec	a4 e6		ldy $e6		                ldy commandLineY ;restore Y
727	.8aee	88		dey		                dey             ;compensate for upcoming iny

729	.8aef					abbreviationMatch:
730	.8aef	c8		iny		                iny             ; skip the '.'

732	.8af0					findCommandMetadataLoop:
733	.8af0	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte
734	.8af3	f0 15		beq $8b0a	                beq rts8ACD
735	.8af5	10 f9		bpl $8af0	                bpl findCommandMetadataLoop ; keep looping through chars if necessary
736	.8af7	b0 11		bcs $8b0a	                bcs rts8ACD                 ;taken if it was a match
737	.8af9	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte   ;discard 2nd metadata byte
738	.8afc	70 dc		bvs $8ada	                bvs checkInput ; if V=1, 2-byte metadata; if V=0, 4-byte metadata
739	.8afe	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte ;discard 3rd metadata byte
740	.8b01	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte ;discard 4th metadata byte
741	.8b04	80 d4		bra $8ada	                bra checkInput

743						;-------------------------------------------------------------------------

745	.8b06					commandMatch:
746	.8b06	20 0b 8b	jsr $8b0b	                jsr fetchCommandTableByte
747	.8b09	38		sec		                sec

