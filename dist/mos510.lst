589						;-------------------------------------------------------------------------
590						;
591						; Read a byte value (0-255) from a string. If the number has a '&'
592						; prefix, interpret it as hex.
593						;
594						; entry:
595						;
596						; (stringInputBufferAddress),y - string
597						;
598						; exit:
599						;
600						; X = result
601						; ?$e6 = result
602						; C=0 if error
603						; Z=1 if CR encountered
604						;
605	.8636					parseNumberFromString:
606	.8636	20 ad f3	jsr $f3ad	                jsr skipSpacesAndCheckForCRInStringInput
607	.8639	c9 26		cmp #$26	                cmp #'&'                     ; hex value incoming?
608	.863b	d0 21		bne $865e	                bne parseDecimal             ; taken if not hex value
609	.863d					parseHex:
610	.863d	c8		iny		                iny                          ; skip '&'
611	.863e	20 98 86	jsr $8698	                jsr readHexDigit             ; read first hex digit
612	.8641	90 53		bcc $8696	                bcc errorReadingString
613	.8643	85 e6		sta $e6		                sta $E6                      ; save first hex digit
614	.8645	20 98 86	jsr $8698	                jsr readHexDigit             ; read second hex digih
615	.8648	90 0e		bcc $8658	                bcc parsedValue         ; taken if not hex digit
616						                ; The first digit read was actually the high nybble,
617						                ; and the current digit read is therefore the low
618						                ; nybble.
619						                ;
620						                ; Shift saved digit 4 bits left.
621	.864a	a2 04		ldx #$04	                ldx #$04
622	.864c					-
623	.864c	06 e6		asl $e6		                asl $E6
624	.864e	ca		dex		                dex
625	.864f	d0 fb		bne $864c	                bne -
626	.8651	04 e6		tsb $e6		                tsb $E6                      ; insert low nybble
627	.8653	20 98 86	jsr $8698	                jsr readHexDigit             ; read third hex digit
628	.8656	b0 29		bcs $8681	                bcs errorReadingString2 ; 3+-digit hex values are not valid
629	.8658					parsedValue:
630	.8658	a6 e6		ldx $e6		                ldx $E6
631	.865a	c9 0d		cmp #$0d	                cmp #$0D
632	.865c	38		sec		                sec
633	.865d					parseDone:
634	.865d	60		rts		                rts

636	.865e					parseDecimal:
637	.865e	20 84 86	jsr $8684	                jsr readDigitFromString
638	.8661	90 33		bcc $8696	                bcc errorReadingString      ;branch taken if not digit
639	.8663					parseDecimalDigit:
640	.8663	85 e6		sta $e6		                sta $E6                     ;save current value
641	.8665	20 83 86	jsr $8683	                jsr readNextDigitFromString
642	.8668	90 ee		bcc $8658	                bcc parsedValue ;branch taken if not digit, meaning number
643						                                     ;parsed successfully
644	.866a	aa		tax		                tax                         ;X=digit

646						                ; calculate (value*4+value)*2 - i.e., value*10. Carry
647						                ; at any point indicates the value was greater than
648						                ; 255, and therefore an error.
649	.866b	a5 e6		lda $e6		                lda $E6                     ;value
650	.866d	0a		asl a		                asl a                       ;value*2
651	.866e	b0 26		bcs $8696	                bcs errorReadingString
652	.8670	0a		asl a		                asl a                       ;value*4
653	.8671	b0 23		bcs $8696	                bcs errorReadingString
654	.8673	65 e6		adc $e6		                adc $E6                     ;value*5
655	.8675	b0 1f		bcs $8696	                bcs errorReadingString
656	.8677	0a		asl a		                asl a                       ;value*10
657	.8678	b0 1c		bcs $8696	                bcs errorReadingString
658	.867a	85 e6		sta $e6		                sta $E6                      ;save value*10
659	.867c	8a		txa		                txa                          ;A=digit
660	.867d	65 e6		adc $e6		                adc $E6                      ;value*10+digit
661	.867f	90 e2		bcc $8663	                bcc parseDecimalDigit
662	.8681					errorReadingString2:
