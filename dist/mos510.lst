8735	.e914	90 0d		bcc $e923	                bcc osrdchDone
8736	.e916	24 e6		bit $e6		                bit readCharacterTimedFlag
8737	.e918	10 ed		bpl $e907	                bpl osrdchLoop     ;taken if no timeout - keep looping
8738	.e91a	ad b2 02	lda $02b2	                lda inkeyTimeoutCounter+1
8739	.e91d	0d b1 02	ora $02b1	                ora inkeyTimeoutCounter+0
8740	.e920	d0 e5		bne $e907	                bne osrdchLoop     ;taken if timeout not timed out yet
8741	.e922	3a		dec a		                dec a              ;timed out: A=$ff, C=1
8742	.e923					osrdchDone:
8743	.e923	7a		ply		                ply
8744	.e924	fa		plx		                plx
8745	.e925	60		rts		                rts

