13764	.faa0	f0 16		beq $fab8	                beq rtsFB68               ; Already active fs, return
13765	.faa2	5a		phy		                phy
13766	.faa3	da		phx		                phx
13767	.faa4	a8		tay		                tay
13768	.faa5	3a		dec a		                dec a
13769	.faa6	d0 07		bne $faaf	                bne LFB5F       ;taken if not FS 1 (tape)

13771						; ??? - only if trying to select tape FS

13773	.faa8	a9 04		lda #$04	                lda #$04
13774	.faaa	24 e2		bit $e2		                bit $E2
13775	.faac	d0 01		bne $faaf	                bne LFB5F
13776	.faae	c8		iny		                iny
13777	.faaf					LFB5F:
13778	.faaf	5a		phy		                phy
13779	.fab0	a2 12		ldx #$12	                ldx #romServiceCallInitialiseFilingSystem
13780	.fab2	20 f8 ee	jsr $eef8	                jsr makeROMServiceCall
13781	.fab5	68		pla		                pla
13782	.fab6	fa		plx		                plx
13783	.fab7	7a		ply		                ply
13784	.fab8					rtsFB68:
13785	.fab8	60		rts		                rts

