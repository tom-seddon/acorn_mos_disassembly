8734	.e914	20 5a ec	jsr $ec5a	                jsr readFromEconetOrSoftKeyOrInputBufferA ;handle Econet/soft key stuff???
8735	.e917	90 0d		bcc $e926	                bcc osrdchDone
8736	.e919	24 e6		bit $e6		                bit readCharacterTimedFlag
8737	.e91b	10 ed		bpl $e90a	                bpl osrdchLoop     ;taken if no timeout - keep looping
8738	.e91d	ad b2 02	lda $02b2	                lda inkeyTimeoutCounter+1
8739	.e920	0d b1 02	ora $02b1	                ora inkeyTimeoutCounter+0
8740	.e923	d0 e5		bne $e90a	                bne osrdchLoop     ;taken if timeout not timed out yet
8741	.e925	3a		dec a		                dec a              ;timed out: A=$ff, C=1
8742	.e926					osrdchDone:
8743	.e926	7a		ply		                ply
8744	.e927	fa		plx		                plx
8745	.e928	60		rts		                rts

