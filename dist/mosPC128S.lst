589						;-------------------------------------------------------------------------
590						;
591						; Read a byte value (0-255) from a string. If the number has a '&'
592						; prefix, interpret it as hex.
593						;
594						; entry:
595						;
596						; (stringInputBufferAddress),y - string
597						;
598						; exit:
599						;
600						; X = result
601						; ?$e6 = result
602						; C=0 if error
603						; Z=1 if CR encountered
604						;
605	.8641					parseNumberFromString:
606	.8641	20 b2 f3	jsr $f3b2	                jsr skipSpacesAndCheckForCRInStringInput
607	.8644	c9 26		cmp #$26	                cmp #'&'                     ; hex value incoming?
608	.8646	d0 21		bne $8669	                bne parseDecimal             ; taken if not hex value
609	.8648					parseHex:
610	.8648	c8		iny		                iny                          ; skip '&'
611	.8649	20 a3 86	jsr $86a3	                jsr readHexDigit             ; read first hex digit
612	.864c	90 53		bcc $86a1	                bcc errorReadingString
613	.864e	85 e6		sta $e6		                sta $E6                      ; save first hex digit
614	.8650	20 a3 86	jsr $86a3	                jsr readHexDigit             ; read second hex digih
615	.8653	90 0e		bcc $8663	                bcc parsedValue         ; taken if not hex digit
616						                ; The first digit read was actually the high nybble,
617						                ; and the current digit read is therefore the low
618						                ; nybble.
619						                ;
620						                ; Shift saved digit 4 bits left.
621	.8655	a2 04		ldx #$04	                ldx #$04
622	.8657					-
623	.8657	06 e6		asl $e6		                asl $E6
624	.8659	ca		dex		                dex
625	.865a	d0 fb		bne $8657	                bne -
626	.865c	04 e6		tsb $e6		                tsb $E6                      ; insert low nybble
627	.865e	20 a3 86	jsr $86a3	                jsr readHexDigit             ; read third hex digit
628	.8661	b0 29		bcs $868c	                bcs errorReadingString2 ; 3+-digit hex values are not valid
629	.8663					parsedValue:
630	.8663	a6 e6		ldx $e6		                ldx $E6
631	.8665	c9 0d		cmp #$0d	                cmp #$0D
632	.8667	38		sec		                sec
633	.8668					parseDone:
634	.8668	60		rts		                rts

636	.8669					parseDecimal:
637	.8669	20 8f 86	jsr $868f	                jsr readDigitFromString
638	.866c	90 33		bcc $86a1	                bcc errorReadingString      ;branch taken if not digit
639	.866e					parseDecimalDigit:
640	.866e	85 e6		sta $e6		                sta $E6                     ;save current value
641	.8670	20 8e 86	jsr $868e	                jsr readNextDigitFromString
642	.8673	90 ee		bcc $8663	                bcc parsedValue ;branch taken if not digit, meaning number
643						                                     ;parsed successfully
644	.8675	aa		tax		                tax                         ;X=digit

646						                ; calculate (value*4+value)*2 - i.e., value*10. Carry
647						                ; at any point indicates the value was greater than
648						                ; 255, and therefore an error.
649	.8676	a5 e6		lda $e6		                lda $E6                     ;value
650	.8678	0a		asl a		                asl a                       ;value*2
651	.8679	b0 26		bcs $86a1	                bcs errorReadingString
652	.867b	0a		asl a		                asl a                       ;value*4
653	.867c	b0 23		bcs $86a1	                bcs errorReadingString
654	.867e	65 e6		adc $e6		                adc $E6                     ;value*5
655	.8680	b0 1f		bcs $86a1	                bcs errorReadingString
656	.8682	0a		asl a		                asl a                       ;value*10
657	.8683	b0 1c		bcs $86a1	                bcs errorReadingString
658	.8685	85 e6		sta $e6		                sta $E6                      ;save value*10
659	.8687	8a		txa		                txa                          ;A=digit
660	.8688	65 e6		adc $e6		                adc $E6                      ;value*10+digit
661	.868a	90 e2		bcc $866e	                bcc parseDecimalDigit
662	.868c					errorReadingString2:
663	.868c	18		clc		                clc
664	.868d	60		rts		                rts

666	.868e					readNextDigitFromString:
667	.868e	c8		iny		                iny

669						; check if current string input byte is a digit.
670						;
671						; exit: C=1 if digit; C=0 if not digit
672	.868f					readDigitFromString:
673	.868f	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
674	.8691	c9 3a		cmp #$3a	                cmp #'9'+1
675	.8693	b0 0c		bcs $86a1	                bcs errorReadingString       ;taken if not ASCII decimal digit
676	.8695	c9 30		cmp #$30	                cmp #'0'
677	.8697	90 08		bcc $86a1	                bcc errorReadingString       ;taken if not ASCII decimal digit
678	.8699	29 0f		and #$0f	                and #$0F         ;convert ASCII decimaldigit to number
679	.869b	60		rts		                rts

681	.869c					L8641:
682	.869c	20 b2 f3	jsr $f3b2	                jsr skipSpacesAndCheckForCRInStringInput
684	.869f	c9 0d		cmp #$0d	                cmp #$0D
686	.86a1					errorReadingString:
687	.86a1	18		clc		                clc
688	.86a2	60		rts		                rts

690						;-------------------------------------------------------------------------
691						;
692						; Read a hex digit from a string
693						;
694						; entry:
695						;
696						; (stringInputBufferAddress),y = next byte to read
697						;
698						; exit:
699						;
700						; C=1 if ok: A = digit read
701						;
702						; C=0 if error: A = value read, Z=1 if CR encountered
703						;
704	.86a3					readHexDigit:
705	.86a3	20 8f 86	jsr $868f	                jsr readDigitFromString
706	.86a6	b0 0d		bcs $86b5	                bcs +                        ; branch taken if digit
707	.86a8	29 df		and #$df	                and #$DF                     ; convert to upper case
708	.86aa	c9 47		cmp #$47	                cmp #'F'+1
709	.86ac	b0 ee		bcs $869c	                bcs L8641    ; branch taken if not ASCII A-F hex digit
710	.86ae	c9 41		cmp #$41	                cmp #'A'
711	.86b0	90 ea		bcc $869c	                bcc L8641     ;branch taken if not ASCII A-F hex digit
712						                ; convert ASCII A-F hex digit to number.
713	.86b2	49 48		eor #$48	                eor #$48
714	.86b4	1a		inc a		                inc a
715	.86b5					+
716	.86b5	c8		iny		                iny
717	.86b6	60		rts		                rts

