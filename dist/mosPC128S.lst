13982						;-------------------------------------------------------------------------
13983						;
13984						; Tube 6502 language ROM relocation
13985						;

14293						;-------------------------------------------------------------------------
14294						;
14295						; Delay after a possible EEPROM write, to give the device time to time
14296						; out out of write mode. Trying to stay reasonably under 10 ms. Don't
14297						; interfere with the 100 Hz timer, but give the 100 Hz routine at
14298						; least a bit of time to run.
14299						;
14300						; 256 times round inner loop=2+256*2+255*3+2=1281 cycles
14301						;
14302						; 1281 cycles = 0.6405 ms
14303						;
14304						; 12 iterations = 15372+(a bit) cycles=~7.7 ms
14305						;
14306						; This can be revisited if required.
14307						;
14308						; Preserves: A/X/P

14329						;-------------------------------------------------------------------------

14331	.fbbe					mosUnusedBegin:
14332	>fbbe	ff ff ff ff ff ff ff ff		                .fill $fc00-*,$ff
	>fbc6	ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff
	>fbd6	ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff
	>fbe6	ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff ff
	>fbf6	ff ff ff ff ff ff ff ff ff ff
14333	=66					mosUnusedSize=*-mosUnusedBegin

