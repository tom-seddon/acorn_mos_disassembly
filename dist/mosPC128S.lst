150	.c01c	8c 30 fe	sty $fe30	                sty ROMSEL
151	.c01f	b2 f6		lda ($f6)	                lda ($F6)                    ; Get byte with ROM Y paged in
152	.c021	4c 9d e5	jmp $e59d	                jmp selectROMX                    ; Page in ROM X and return

