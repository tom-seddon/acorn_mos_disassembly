6121	.df34	64 d6		stz $d6		                stz ZMEMG+0 ;LSB always 0 - the offset takes care of this
6122	.df36	a6 da		ldx $da		                ldx ZTEMP+0 ;get scanline in row
6123	.df38	20 7c da	jsr $da7c	                jsr setupColourMasks
