8719	.e8fb	20 d7 ff	jsr $ffd7	                jsr OSBGET             ;get 1 byte from the *EXEC file
8720	.e8fe	64 eb		stz $eb		                stz tapeCritical
8721	.e900	90 24		bcc $e926	                bcc osrdchDone                    ;taken if byte valid
8722	.e902	a9 00		lda #$00	                lda #$00                     ;OSFIND close file
8723	.e904	9c 56 02	stz $0256	                stz execFileHandle           ;reset *EXEC handle
8724	.e907	20 ce ff	jsr $ffce	                jsr OSFIND                   ;close *EXEC file
8725	.e90a					osrdchLoop:
8726	.e90a	a5 ff		lda $ff		                lda escapeFlag               ;b7 set if ESCAPE pressed
8727	.e90c	0a		asl a		                asl a                        ;C=1 if ESCAPE pressed
8728	.e90d	a9 1b		lda #$1b	                lda #27                      ;ASCII for ESCAPE
8729	.e90f	b0 15		bcs $e926	                bcs osrdchDone               ;exit with C=1 if ESCAPE
8730						                                             ;pressed
