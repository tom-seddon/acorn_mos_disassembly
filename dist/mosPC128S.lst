3200						;
3201	.cf24					setCRTCRegisterRaw:
3202	.cf24	8c 00 fe	sty $fe00	                sty CRTC+0
3203	.cf27	8d 01 fe	sta $fe01	                sta CRTC+1
3204	.cf2a					rtsCF2A:
3205	.cf2a	60		rts		                rts

