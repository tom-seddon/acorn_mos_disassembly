6608	>e148	80				                .byte %10000000
6609	>e149	40				                .byte %01000000
6610	>e14a	20				                .byte %00100000
6611	>e14b	10				                .byte %00010000
6612	>e14c	08				                .byte %00001000
6613	>e14d	04				                .byte %00000100
6614	>e14e	02				                .byte %00000010
