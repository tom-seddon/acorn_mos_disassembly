3272	.9e30	d0 1c		bne $9e4e	                bne readRTCByte              ; taken if address not $ff

3274						                ; Read address $ff to query the size.
3275	.9e32	20 cf 90	jsr $90cf	                jsr i2cTestReadEEPROMByte    ; do an experimental read
3276	.9e35	a0 00		ldy #$00	                ldy #0                       ; failure result is 0
3277	.9e37	b0 2b		bcs $9e64	                bcs rts9DE0 ; taken if read failed - no EEPROM present
3278	.9e39	a2 7f		ldx #$7f	                ldx #$7f
3279	.9e3b	20 4f 9f	jsr $9f4f	                jsr i2cReadEEPROMByte        ; read the byte at $7f
3280	.9e3e	5a		phy		                phy                          ; save the byte read
3281	.9e3f	a2 ff		ldx #$ff	                ldx #$ff
3282	.9e41	20 4f 9f	jsr $9f4f	                jsr i2cReadEEPROMByte        ; read the byte at $ff
3283	.9e44	98		tya		                tya                          ; A = byte from $ff
3284	.9e45	ba		tsx		                tsx

3286	.9e46	5d 01 01	eor $0101,x	                eor $101,x
3287						                ; The EEPROM contents reset code EORs the byte at +$7f
3288						                ; with $80, and stores that at +$ff. So either the
3289						                ; result is 0 (+$7f and +$ff are the same byte: it's a
3290						                ; 128-byte EEPROM) or it's a value with bit 8 clear
3291						                ; (+$7f and +$ff are not the same byte: it's a
3292						                ; 256-byte EEPROM).
3293	.9e49	09 7f		ora #$7f	                ora #$7f ; 127 if 128-byte EEPROM; 255 if 256-byte EEPROM
