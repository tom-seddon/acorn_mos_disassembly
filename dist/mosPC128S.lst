7044						;
7045	.e2c9					LE2B6:
7046	.e2c9	a2 24		ldx #$24	                ldx #VDUVariables.graphicsCursorPixelsX
7047	.e2cb					LE2B8:
7048	.e2cb	a0 14		ldy #$14	                ldy #VDUVariables.oldGraphicsCursorPixelsX

7050						;-------------------------------------------------------------------------
7051						;
7052						; Swap 4 bytes in the VDU variables.
7053						;
7054						; entry:
7055						;
7056						; X = offset of one set of 4 bytes
7057						;
7058						; Y = offset of the other set of 4 bytes
7059						;
7060	.e2cd					exchangeFourVDUBytes:
7061	.e2cd	a9 04		lda #$04	                lda #$04

7063						;-------------------------------------------------------------------------
7064						;
7065						; Swap bytes in the VDU variables.
7066						;
7067						; entry:
7068						;
7069						; A = number of bytes to swap
7070						;
7071						; X = offset of one set of bytes
7072						;
7073						; Y = offset of the other set of bytes
7074						;
7075	.e2cf					exchangeVDUVariables:
7076	.e2cf	48		pha		                pha                          ;save count remaining
7077	.e2d0	bd 00 03	lda $0300,x	                lda vduv,x
7078	.e2d3	48		pha		                pha
7079	.e2d4	b9 00 03	lda $0300,y	                lda vduv,y
7080	.e2d7	9d 00 03	sta $0300,x	                sta vduv,x
7081	.e2da	68		pla		                pla
7082	.e2db	99 00 03	sta $0300,y	                sta vduv,y
7083	.e2de	e8		inx		                inx
7084	.e2df	c8		iny		                iny
7085	.e2e0	68		pla		                pla
7086	.e2e1	3a		dec a		                dec a
7087	.e2e2	d0 eb		bne $e2cf	                bne exchangeVDUVariables
7088	.e2e4	60		rts		                rts

