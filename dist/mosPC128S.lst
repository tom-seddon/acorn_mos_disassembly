678						;-------------------------------------------------------------------------
679						;
680						; Find command in command table.
681						;
682						; Entry:
683						;
684						; (stringInputBufferAddress),y = input
685						; oscliWorkspace.tablePtr; = address of command table
686						; V = 0 if commands have 4 bytes of metadata
687						;     1 if commands have 2 bytes of metadata
688						;
689						; Exit:
690						;
691						; C=0 = no match
692						;
693						; C=1 = match;
694						;       A holds 1st byte of metadata
695						;       oscliWorkspace.tablePtr; = address of 2nd and following metadata bytes
696						;       (stringInputBufferAddress),y = input following command
697						;
698						; Preserves: X/V

700	.8ae0					findCommand: .block
701	.8ae0	84 e6		sty $e6		                sty commandLineY ;save Y
702	.8ae2	80 0a		bra $8aee	                bra checkInput       ;get going...

704	.8ae4					checkLetter:
705	.8ae4	52 b0		eor ($b0)	                eor (oscliWorkspace.tablePtr)
706	.8ae6	29 df		and #$df	                and #$DF
707	.8ae8	d0 15		bne $8aff	                bne noMatch    ; taken if char didn't match
708	.8aea	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte
709	.8aed	c8		iny		                iny

711	.8aee					checkInput:
712	.8aee	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
713	.8af0	20 9f eb	jsr $eb9f	                jsr isLetter
714	.8af3	90 ef		bcc $8ae4	                bcc checkLetter ; taken if letter

716						                ; Non-letter input means potentially end of command
717						                ; name.
718	.8af5	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr) ; next table byte
719	.8af7	30 21		bmi $8b1a	                bmi commandMatch ; taken if end of string - a match
720	.8af9	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
721	.8afb	c9 2e		cmp #$2e	                cmp #'.'        ; '.' is the abbreviation char
722	.8afd	f0 04		beq $8b03	                beq abbreviationMatch ;taken with C=1 if match

724	.8aff					noMatch:
725	.8aff	18		clc		                clc             ;indicate no match
726	.8b00	a4 e6		ldy $e6		                ldy commandLineY ;restore Y
727	.8b02	88		dey		                dey             ;compensate for upcoming iny

729	.8b03					abbreviationMatch:
730	.8b03	c8		iny		                iny             ; skip the '.'

732	.8b04					findCommandMetadataLoop:
733	.8b04	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte
734	.8b07	f0 15		beq $8b1e	                beq rts8ACD
735	.8b09	10 f9		bpl $8b04	                bpl findCommandMetadataLoop ; keep looping through chars if necessary
736	.8b0b	b0 11		bcs $8b1e	                bcs rts8ACD                 ;taken if it was a match
737	.8b0d	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte   ;discard 2nd metadata byte
738	.8b10	70 dc		bvs $8aee	                bvs checkInput ; if V=1, 2-byte metadata; if V=0, 4-byte metadata
739	.8b12	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte ;discard 3rd metadata byte
740	.8b15	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte ;discard 4th metadata byte
741	.8b18	80 d4		bra $8aee	                bra checkInput

743						;-------------------------------------------------------------------------

745	.8b1a					commandMatch:
746	.8b1a	20 1f 8b	jsr $8b1f	                jsr fetchCommandTableByte
747	.8b1d	38		sec		                sec

749	.8b1e					rts8ACD:
750	.8b1e	60		rts		                rts
751						                .endblock

