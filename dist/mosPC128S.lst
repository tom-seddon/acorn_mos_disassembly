431	.85b6	f0 e0		beq $8598	                beq rts84FE
432	.85b8	c9 7c		cmp #$7c	                cmp #'|'
433	.85ba	f0 dc		beq $8598	                beq rts84FE
434	.85bc	9c c6 df	stz $dfc6	                stz hazel.tempFSFlag
435	.85bf	c9 2d		cmp #$2d	                cmp #'-'
436	.85c1	d0 0c		bne $85cf	                bne L8535
437	.85c3	20 69 fa	jsr $fa69	                jsr parseFileNameFS
438	.85c6	20 10 fb	jsr $fb10	                jsr selectFS
439	.85c9	38		sec		                sec
440	.85ca	6e c6 df	ror $dfc6	                ror hazel.tempFSFlag
441	.85cd	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
442	.85cf					L8535:
