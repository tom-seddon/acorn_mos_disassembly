4802	.a852	60		rts		                rts

4805						; Call Return
4806						;  0    A=0   SEC                        - unsupported
4807						;  1    A=0   SEC  Write using new PTR   - unsupported
4808						;  2    A=         Write with current PTR
4809						;  3    A=1   SEC  Read with new PTR     - unsupported
4810						;  4    A=         Read with current PTR
4811						;  5+   A=A/2 SEC                        - unsupported

