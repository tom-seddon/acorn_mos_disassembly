3146						;
3147						; VDU 23 0 Control 6845 CRTC directly [MasRef E.3-12]
3148						;
3149	.cefb					vdu23_0_EntryPoint:
3150	.cefb	ad 1d 03	lda $031d	                lda vduv.queueEnd-7           ;get value
