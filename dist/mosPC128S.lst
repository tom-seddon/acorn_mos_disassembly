4794	.a848					osgbpbTapeOrROM:
4795	.a848	4a		lsr a		                lsr a                        ; Odd numbered calls - change PTR - exit with A=changed, SEC
4796	.a849	b0 06		bcs $a851	                bcs LA376
4797	.a84b	f0 04		beq $a851	                beq LA376                    ; OSGBPB 0 - exit with A=unchanged, SEC
4798	.a84d	c9 03		cmp #$03	                cmp #$03                     ; function/2<3 - function<6 - function 2 and 4 - jump to do
4799	.a84f	90 02		bcc $a853	                bcc LA378
