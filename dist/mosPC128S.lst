10493						;
10494						; Pass service call around sideways ROMs
10495						;
10496						; Entry:
10497						; X=service call number
10498						; Y=any parameters
10499						;
10500						; Exit:
10501						; X=0 or preserved
10502						; Y=any returned parameters
10503						; EQ=call claimed if called directly
10504						;
10505	.eefb					makeROMServiceCall: .proc                    ;ee72
10506	.eefb	a5 f4		lda $f4		                lda $F4         ; Save current ROM
10507	.eefd	48		pha		                pha
10508	.eefe	ad 34 fe	lda $fe34	                lda ACCCON      ; Save current paging state
10509	.ef01	48		pha		                pha
10510	.ef02	20 43 ee	jsr $ee43	                jsr selectHAZEL ; Page in Hazel
10511	.ef05	8a		txa		                txa             ; Pass service call number to A
10512	.ef06	a2 0f		ldx #$0f	                ldx #$0F     ; Start at ROM 15, and always call ROM 15
10513	.ef08	80 05		bra $ef0f	                bra callServiceEntry
10514	.ef0a					callServiceEntriesLoop:
10515	.ef0a	3c a1 02	bit $02a1,x	                bit romInformationTable,x ;check if ROM X has a service entry
10516	.ef0d	10 0b		bpl $ef1a	                bpl nextROM       ;branch taken if no service entry
10517	.ef0f					callServiceEntry:
10518	.ef0f	20 9d e5	jsr $e59d	                jsr selectROMX  ; Page in ROM X
10519	.ef12	20 03 80	jsr $8003	                jsr $8003       ; Call ROM service entry point
10520	.ef15	aa		tax		                tax             ; X = service call result
10521	.ef16	f0 05		beq $ef1d	                beq done       ;branch taken if service call claimed
10522	.ef18	a6 f4		ldx $f4		                ldx $F4         ; Get ROM number
10523	.ef1a					nextROM:
10524	.ef1a	ca		dex		                dex       ; Step down to next ROM, loop until all done
10525	.ef1b	10 ed		bpl $ef0a	                bpl callServiceEntriesLoop

10527	.ef1d					done:
10528	.ef1d	68		pla		                pla                          ; Restore paging state
10529	.ef1e	20 39 ee	jsr $ee39	                jsr selectMOSOrHAZEL
10530	.ef21	68		pla		                pla                          ; Restore current ROM
10531	.ef22	20 ae e5	jsr $e5ae	                jsr selectROMA
10532	.ef25	8a		txa		                txa                          ; Pass claim/noclaim to A
10533	.ef26	60		rts		                rts
10534						                .pend

