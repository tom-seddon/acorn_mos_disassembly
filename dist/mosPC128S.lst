385						;
386						; Get string input buffer address tail according to table byte.
387						;
388						; Entry:
389						;
390						; oscliWorkspace.tablePtr; = pointer to table byte
391						; (stringInputBufferAddress),y = pointer to input
392						;
393						; Exit:
394						;
395						; A = table byte
396						;
397						; if table byte bit 7 set: Y/X points to command line tail
398	.8588					maybeGetStringInputBufferAddress:
399	.8588	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
400	.858a	30 0c		bmi $8598	                bmi rts84FE
401	.858c					getStringInputBufferAddressWithYOffset:
402	.858c	98		tya		                tya
403	.858d					getStringInputBufferAddressWithAOffset:
404	.858d	18		clc		                clc
405	.858e	65 f2		adc $f2		                adc stringInputBufferAddress+0
406	.8590	aa		tax		                tax
407	.8591	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
408	.8593	90 01		bcc $8596	                bcc +
409	.8595	c8		iny		                iny
410	.8596					+
411	.8596	b2 b0		lda ($b0)	                lda (oscliWorkspace.tablePtr)
412	.8598					rts84FE:
413	.8598	60		rts		                rts

415						; Prepare OSCLI command line
416						; ==========================
417	.8599					oscli:
418	.8599	86 f2		stx $f2		                stx stringInputBufferAddress+0
419	.859b	84 f3		sty $f3		                sty stringInputBufferAddress+1
420	.859d	ad 00 df	lda $df00	                lda hazel.currentFS
421	.85a0	20 10 fb	jsr $fb10	                jsr selectFS
422	.85a3	a9 08		lda #$08	                lda #fscStarCommand
423	.85a5	20 98 f2	jsr $f298	                jsr callFSCV
424	.85a8	a0 ff		ldy #$ff	                ldy #$FF
425	.85aa					L8510:
426	.85aa	20 b1 f3	jsr $f3b1	                jsr incAndSkipSpaces
427	.85ad	f0 e9		beq $8598	                beq rts84FE
