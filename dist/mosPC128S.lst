7024	.e2c1	a2 18		ldx #$18	                ldx #VDUVariables.textCursorXPosition
7025	.e2c3	a0 64		ldy #$64	                ldy #VDUVariables.editCursorXPosition

7027						;-------------------------------------------------------------------------
7028						;
7029						; Swap 2 bytes in the VDU variables.
7030						;
7031						; entry:
7032						;
7033						; X = offset of one set of 2 bytes
7034						;
7035						; Y = offset of the other set of 2 bytes
7036						;
7037	.e2c5					exchangeTwoVDUBytes:
7038	.e2c5	a9 02		lda #$02	                lda #$02
7039	.e2c7	80 06		bra $e2cf	                bra exchangeVDUVariables

7041						;-------------------------------------------------------------------------
