6872						;
6873						; Get address of soft character definition.
6874						;
6875						; entry:
6876						;
6877						; A = character (32-255)
6878						;
6879						; exit:
6880						;
6881						; (ZTEMPC) = address
6882						;
6883	.e23f					getSoftCharacterDefinitionAddress:
6884	.e23f	0a		asl a		                asl a                        ;a bcdefgh0
6885	.e240	2a		rol a		                rol a                        ;b cdefgh0a
6886	.e241	2a		rol a		                rol a                        ;c defgh0ab
6887	.e242	a8		tay		                tay
6888	.e243	29 03		and #$03	                and #$03                     ;c 000000ab
6889	.e245	2a		rol a		                rol a                        ;0 00000abc
6890	.e246	69 88		adc #$88	                adc #(>andy.softCharacterDefinitions)-1
6891	.e248	85 df		sta $df		                sta ZTEMPC+1
6892	.e24a	98		tya		                tya                          ;0 defgh0ab
6893	.e24b	29 f8		and #$f8	                and #$F8                     ;0 defgh000
6894	.e24d	85 de		sta $de		                sta ZTEMPC+0
6895	.e24f	60		rts		                rts                          ;

