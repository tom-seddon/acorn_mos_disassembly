8155	.e76d	20 eb f7	jsr $f7eb	                jsr LF8FF
8156	.e770	a9 01		lda #$01	                lda #VIA.irq.ca2
8160	.e772					staSystemVIAIFR:
8161	.e772	8d 4d fe	sta $fe4d	                sta systemVIA.ifr
8162	.e775					rtsE6B6:
8163	.e775	60		rts		                rts

8166	.e776					handleUnrecognisedInterruptE799:
8167	.e776	4c 7f e6	jmp $e67f	                jmp handleUnrecogisedInterrupt

8169						;-------------------------------------------------------------------------
8170						;
8171						; OSBYTE 17 (&11) Write next ADC channel to be sampled [MasRef D.2-25]
8172						;
8173	.e779					osbyte11:
8178	.e779	8c 4c 02	sty $024c	                sty currentADCChannel
8180	.e77c	80 ea		bra $e768	                bra initiateADCConversion

8183						;-------------------------------------------------------------------------
8184						;
8185						; Print a 0-terminated string at some offset from startupMessages.
8186						;
8187						; entry:
8188						;
8189						; Y = offset-1 of message
8190						;
8191	.e77e					printStartupMessage:
8192	.e77e	a9 e0		lda #$e0	                lda #>startupMessages
8193						                ; .cerror (<startupMessages)!=0,"startupMessages must be page-aligned" ;it's more flexible than this, but this'll do for now

8195						;-------------------------------------------------------------------------
8196						;
8197						; Print a 0-terminated string.
8198						;
8199						; entry:
8200						;
8201						; A = address MSB
8202						;
8203						; Y = (address LSB)-1
8204						;
8205	.e780					print0TerminatedString:
8206	.e780	85 fe		sta $fe		                sta errPtr+1
8207	.e782	64 fd		stz $fd		                stz errPtr+0

8209						;-------------------------------------------------------------------------
8210						;
8211						; Print the BRK message.
8212						;
8213						; entry:
8214						;
8215						; (errPtr) = pointer to the error number (as will be the case after a
8216						; BRK)
8217						;
8218						; Y=0
8219						;
8220	.e784					printBRKMessage:
8221	.e784	c8		iny		                iny
8222	.e785	b1 fd		lda ($fd),y	                lda (errPtr),y
8223	.e787	20 e3 ff	jsr $ffe3	                jsr OSASCI
8224	.e78a	aa		tax		                tax
8225	.e78b	d0 f7		bne $e784	                bne printBRKMessage
8226	.e78d					rtsE7B0:
8227	.e78d	60		rts		                rts

8229						;-------------------------------------------------------------------------

8232						;-------------------------------------------------------------------------

8234						; Digital joystick input processing
8235						;
8236						; The handleDigitalJoystick  routine below is called every centisecond (100Hz)
8237						; to process digital joystick inputs and simulate analogue ADVAL channels
8238						; 1 and 2. It supports multiple operating modes configured via *CONFIGURE
8239						; and *FX commands:
8240						;
8241						; PROPORTIONAL MODE (*CONFIGURE PROPORTIONAL or *FX190,<rate 0-7>):
8242						;   Uses an integration algorithm to convert instantaneous digital switch states
8243						;   into smoothly varying 16-bit ADVAL channel values that simulate analogue
8244						;   joystick deflection. The algorithm implements linear acceleration with
8245						;   velocity limiting:
8246						;
8247						;   - Each polling tick increments a counter (joystickRepeatCounter) while a
8248						;     direction is held
8249						;   - The channel value increment is calculated as: counter * 2^rate
8250						;   - This produces quadratic growth: deflection increases as the square of time
8251						;   - When the increment's MSB exceeds the configured rate value, velocity
8252						;     limiting activates
8253						;   - Limited velocity equals rate * 256, producing linear growth thereafter
8254						;   - When input is released, the joystickRepeatCounter resets and the channel
8255						;     coasts or holds at its current value, so further joystick input is
8256						;     required to return to the centre value.
8257						;
8258						;   The rate (0-7) is configured via *CONFIGURE STICK <rate> and controls
8259						;   responsiveness: Rate 7 reaches full deflection in ~0.32 s, Rate 1 in ~2.56 s.
8260						;   Rate 0 is special, and causes the effective rate to be 3. Rate values above
8261						;   7 are clamped to 7. Also set by *FX190, <rate 0-7> which implicitly enters
8262						;   proportional mode.
8263						;
8264						; SWITCHED MODE (*CONFIGURE SWITCHED or *FX190,32):
8265						;   Provides instant positioning without acceleration. When a direction is
8266						;   pressed, the corresponding ADVAL channel immediately jumps to minimum
8267						;   ($0000), maximum ($FFFF) depending on the switch state.
8268						;   When released, channels return immediately to center ($7FFF).
8269						;
8270						; Keyboard simulating joystick (*FX4, 3):
8271						;   The cursor keys (up/down/left/right) and COPY key can be mapped to simulate
8272						;   digital joystick inputs. The routine scans these keys via KEYV and combines
8273						;   them with hardware joystick inputs - either joystick or keys can be used
8274						;   simultaneously. This allows keyboard control of joystick-driven software.
8275						;
8276						; Joystick simulating keyboard (*FX190, 64):
8277						;   When bit 6 of adcConversionType is set, the routine reverses the mapping:
8278						;   joystick directions are converted to cursor key equivalents and fire buttons
8279						;   to COPY key. This allows joystick control of keyboard-driven software like
8280						;   the MOS command line editor. In this mode ADVAL(1) and ADVAL(2) will not
8281						;   reflect the state of the â<80><9C>joystickâ<80><9D> position.
8282						;
8283						; INPUT SOURCES:
8284						;   - Hardware joystick: User VIA Port B ($FE60), bits 0-4, active-low
8285						;   - Keyboard: KEYV vector for cursor keys and COPY, returns C=1 when pressed
8286						;
8287						; ADVAL CHANNEL ASSIGNMENTS:
8288						;   Channel 0 (adval0LSB): Switch state byte, bits 0-4 encode directions/buttons
8289						;   Channel 1: Horizontal axis ($0000=right, $7FFF=center, $FFFF=left)
8290						;   Channel 2: Vertical axis ($0000=down, $7FFF=center, $FFFF=up)
8291						;   ...
8292						;   Channel <odd> : equivalent to channel 1
8293						;   Channel <even> : equivalent to channel 2
8294						;
8295						;   NOTE: The horizontal axis sense is INVERTED compared to both screen coordinates
8296						;   and standard mathematical conventions (where increasing X moves right). Here,
8297						;   increasing values move LEFT.
8298						;
8299						; ROM SERVICE CALL DELEGATION:
8300						;   When bit 7 of adcConversionType is set, joystick handling is completely
8301						;   delegated to sideways ROMs via service call $2C (romServiceCallCompactJoystick).
8302						;   This is a tail call in dispatchRomServiceCallOrJoykeys bypasses ALL built-in
8303						;   joystick handling - no keyboard-simulating-joystick, no proportional mode,
8304						;   no switched mode, and no joystick-simulating-keyboard will run.
8305						;
8306						;   This happens REGARDLESS of whether any ROM claims the service call. If no ROM
8307						;   responds, joystick handling simply doesn't occur (ADVAL values remain unchanged).
8308						;
8309						;   To enable ROM delegation: *FX190,128,127 (sets bit 7, preserves other bits)
8310						;   Default value is loaded from CMOS at boot; no *CONFIGURE setting exists.
8311						;
8312						;   ROMs implementing service call $2C receive:
8313						;   - A register = service call number ($2C)
8314						;   - Y register = page 2 offset for ADVAL workspace ($B6 = offset to $02B6)
8315						;   - Should write joystick data to $0200+Y through $0200+Y+4 (5 bytes)
8316						;   - Return X=0 to claim (stops service call chain)
8317						;   - Return A unchanged to pass to next lower-priority ROM
8318						;
8319						;   Use case: Hardware expansions (real analogue joystick interfaces) can
8320						;   completely replace the built-in digital joystick support.
8321						;
8322						;   This is an either/or choice:
8323						;   - Bit 7 clear = built-in handling (modes described above)
8324						;   - Bit 7 set = ROM-only handling (built-in code skipped entirely)
8325						;

8327						; The switchToKey table is used to enter ASCII key values into the keyboard
8328						; buffer depending on the contents of ADVAL(0) lo-byte in page 2. (i.e. the
8329						; contents of the address $0200 + adcResultLSBs). The X register value used to
8330						; index into this table will represent the bit index according to b = 8 - X
8331						;
8332						; Note that each byte is a keyboard buffer input value, subject to subsequent
8333						; translation by the mechanisms of *FX4, OSRDCH/INKEY which is why some of the
8334						; values are ASCII (delete and return) whereas others, like the edit keys are
8335						; are neither their ASCII, INKEY nor internal key codes (though are deceptively
8336						; close in value!)

8338						;                Keyboard buffer   Switch         X  ADVAL(0)       Key
8339						;                input values                          bit    equivalent

8341	>e78e	00				switchToKey:    .byte 0         ;                 0     n/a
8342	>e78f	8d				                .byte $8D       ;  joystick right 1     b7      cursor right
8343	>e790	8f				                .byte $8F       ;  joystick up    2     b6      cursor up
8344	>e791	8e				                .byte $8E       ;  joystick down  3     b5      cursor down
8345	>e792	8c				                .byte $8C       ;  joystick left  4     b4      cursor left
8346	>e793	7f				                .byte $7F       ;  mouse right    5     b3      delete key
8347	>e794	0d				                .byte $D        ;  mouse middle   6     b2      return key
8348	>e795	8b				                .byte $8B       ;  mouse left     7     b1      copy key
8349	>e796	8b				                .byte $8B       ;  joystick fire  8     b0      copy key

8351						; The joyKeys table is used to define the keys which have joystick-like effects,
8352						; where the cursor keys move the joystick in the appropriate direction, and the
8353						; copy key is equivalent to the fire button.

8355	>e797	96				joyKeys:        .byte $96       ; INKEY copy
8356	>e798	e6				                .byte $E6       ; INKEY cursor left
8357	>e799	d6				                .byte $D6       ; INKEY cursor down
8358	>e79a	c6				                .byte $C6       ; INKEY cursor up
8359	>e79b	86				                .byte $86       ; INKEY cursor right

8361						;-------------------------------------------------------------------------

8363						; One challenge here is that the adcResultLSBs and adcResultMSBs labels are
8364						; misleading for MOS 5.x because the layout of the ADC workspace is quite
8365						; different in this version compared to MOS 3.x.
8366						;
8367						; The MOS 5.x workspace layout is as follows:
8368						;
8369						; $02b6 - ADVAL channel 0 LSB
8370						; $02b7 - ADVAL channel 1 or 3 LSB
8371						; $02b8 - ADVAL channel 1 or 3 MSB
8372						; $02b9 - ADVAL channel 2 or 4 LSB
8373						; $02ba - ADVAL channel 2 or 4 MSB
8374						; $02bb - temporary variables
8375						; $02bc - temporary variables
8376						; $02bd - temporary variables

8378						; To make this 5.x code more comprehensible, we compute 5.x labels with more
8379						; appropriate names from the 3.x labels.

8381	=$2b6					adval0LSB   = adcResultLSBs          ; $02b6
8382	=695					adval1LSB   = adcResultLSBs + 1      ; $02b7
8383	=696					adval1MSB   = adcResultLSBs + 2      ; $02b8
8384	=697					adval2LSB   = adcResultLSBs + 3      ; $02b9
8385	=698					adval2MSB   = adcResultLSBs + 4      ; $02ba  also adcResultMSB
8386	=699					advalIncLSB = adcResultLSBs + 5      ; $02bb  also adcResultMSB + 1
8387	=700					advalIncMSB = adcResultLSBs + 6      ; $02bc  also adcResultMSB + 2
8388	=701					advalTemp   = adcResultLSBs + 7      ; $02bd  also adcResultMSB + 3

8390						; The advalTemp entry of the workspace is used for several variables
8391						; at different times. For clarity, we name them here:
8392	=701					keyDelay = advalTemp
8393	=701					joystickRepeatCounter = advalTemp

8395						; Moreover, the location of adcLastChannelRead is also reused to store joystick
8396						; related keypresses, so we introduce another alias
8397	=$2be					currentKey = adcLastChannelRead

8399	.e79c					handleDigitalJoystick:.block                        ; Joystick centisecond polling
8400	.e79c	ad 4d 02	lda $024d	                lda maximumADCChannel               ; If the maximum ADC channel is zero
8401	.e79f	f0 ec		beq $e78d	                beq rtsE7B0                         ; nothing to do, so return
8402	.e7a1	2c 4e 02	bit $024e	                bit adcConversionType               ; If bit 6 of adcConversionType is
8403	.e7a4	50 3b		bvc $e7e1	                bvc dispatchRomServiceCallOrJoykeys ; clear then skip forward to delegate to ROM service call or convert keypress to joystick

8405						                                                    ; adcConversionType bit 6 is set, so convert switched
8406						                                                    ; digital joystick to keypress equivalents

8408	.e7a6	ad b6 02	lda $02b6	                lda adval0LSB                       ; A = adval0LSB (offset in page 2)
8409	.e7a9	a2 00		ldx #$00	                ldx #0                              ; X = 0

8411	.e7ab					scanSwitchBitsLoop:                         ; Loop that finds the first set bit in adval0LSB
8412						                                            ; Process the ADVAL 0 digital joystick directions / mouse buttons / fire buttons
8413						                                            ; As we shift the left-most bits of A into C, X keeps track of the bit number. Note that this
8414						                                            ; processes the bits in priority order from bit 7 to bit 0, with only the first set bit being
8415						                                            ; translated to a key through the switchToKey table.
8416	.e7ab	e8		inx		                inx                         ; X += 1 : X represents b = 8 - X where b is the bit index into the adval0LSB value
8417	.e7ac	0a		asl a		                asl a                       ; Shift left, bit 7 into carry
8418	.e7ad	b0 03		bcs $e7b2	                bcs lookupSwitchKey         ; If bit 7 was set (i.e. bit 8 - X of ADVAL 0), take lookupSwitchKey
8419	.e7af	d0 fa		bne $e7ab	                bne scanSwitchBitsLoop      ; If set bits remain, next iteration of scanSwitchBitsLoop
8420	.e7b1	aa		tax		                tax                         ; X = A

8422	.e7b2					lookupSwitchKey:                                        ; Converts switch bit position to keyboard code via table lookup
8423	.e7b2	bc 8e e7	ldy $e78e,x	                ldy switchToKey,x                       ; Y = entry in switchToKey table at index X
8424	.e7b5	cc be 02	cpy $02be	                cpy currentKey                          ; Is the new key (Y) the same as the previous key (currentKey)?
8425	.e7b8	8c be 02	sty $02be	                sty currentKey                          ; Update the current key (from Y)
8426	.e7bb	f0 0c		beq $e7c9	                beq handleRepeatDelay                   ; If C (Y == currentKey) handleRepeatDelay
8427	.e7bd	98		tya		                tya                                     ; A = Y
8428	.e7be	f0 09		beq $e7c9	                beq handleRepeatDelay                   ; If A = 0 (no keypress) skip over simulated keypress
8429	.e7c0	20 ac eb	jsr $ebac	                jsr insertCharacterIntoKeyboardBuffer   ; On entry Y = keyboard buffer input value (subject to subsequent translation)
8430	.e7c3	ad 54 02	lda $0254	                lda keyboardAutoRepeatDelay             ; A = keyboardAutoRepeatDelay
8431	.e7c6	8d bd 02	sta $02bd	                sta keyDelay                            ; keyDelay = A

8433	.e7c9					handleRepeatDelay:                                      ; Manages keyboard auto-repeat delay countdown
8434	.e7c9	ad bd 02	lda $02bd	                lda keyDelay                            ; A = keyDelay
8435	.e7cc	f0 13		beq $e7e1	                beq dispatchRomServiceCallOrJoykeys     ; If no delay (A = 0) skip to dispatchRomServiceCallOrJoykeys
8436	.e7ce	ce bd 02	dec $02bd	                dec keyDelay                            ; Decrement key delay
8437	.e7d1	d0 0e		bne $e7e1	                bne dispatchRomServiceCallOrJoykeys     ; If not yet zero, skip forward to dispatchRomServiceCallOrJoykeys
8438	.e7d3	ad 55 02	lda $0255	                lda keyboardAutoRepeatRate              ; Delay expired, so load keyboardAutoRepeatRate
8439	.e7d6	8d bd 02	sta $02bd	                sta joystickRepeatCounter               ; and store it
8440	.e7d9	ac be 02	ldy $02be	                ldy currentKey                          ; Y = current key ASCII
8441	.e7dc	f0 03		beq $e7e1	                beq dispatchRomServiceCallOrJoykeys     ; If Y = 0 (no keypress) skip over simulated keypress
8442	.e7de	20 ac eb	jsr $ebac	                jsr insertCharacterIntoKeyboardBuffer   ; On entry Y = keyboard buffer input value (subject to subsequent translation)

8444	.e7e1					dispatchRomServiceCallOrJoykeys:                        ; Either delegate to a sideway a ROM or check joykeys
8445	.e7e1	2c 4e 02	bit $024e	                bit adcConversionType                   ; If bit 7 of adcConversionType is
8446	.e7e4	10 07		bpl $e7ed	                bpl checkEditKeysMode                   ; clear skip the ROM service call, otherwise
8447	.e7e6	a0 b6		ldy #$b6	                ldy #<adval0LSB                         ; make sideways ROM service call &2C
8448	.e7e8	a2 2c		ldx #$2c	                ldx #romServiceCallCompactJoystick      ; with Y = offset into page 2 for
8449	.e7ea	4c fb ee	jmp $eefb	                jmp makeROMServiceCall                  ; ADVAL results location

8451	.e7ed					checkEditKeysMode:                                      ; Tests if cursor editing mode joyKeys is active *FX 4, 3
8452	.e7ed	a9 ff		lda #$ff	                lda #$FF                                ; A = 255
8453	.e7ef	ae 7d 02	ldx $027d	                ldx editKeysMode                        ; If cursor editing mode (see OSBYTEs 4 and 237)
8454	.e7f2	e0 03		cpx #$03	                cpx #editKeysMode.joyKeys               ; is not equal to joyKeys (Master Compact only) then
8455	.e7f4	d0 14		bne $e80a	                bne readJoystickPort                    ; skip over reading the joykeys to reading the joystick port

8457						                ; Otherwise,
8458						                ; make the cursor and arrow keys have a joystick- like effect with the copy-key
8459						                ; simulating the fire button. This routine iterates down through the joyKey table
8460						                ; of INKEY codes testing each key in turn and shifting the results into the low bits
8461						                ; of A giving: 1 1 1 right up down left copy

8463	.e7f6	e8		inx		                inx                     ; X = 4.   Index into joykeys table

8465	.e7f7					scanJoyKeysLoop:                        ; for each joykey
8466	.e7f7	48		pha		                pha                     ; Save the accumulator
8467	.e7f8	da		phx		                phx                     ; Save X
8468	.e7f9	bd 97 e7	lda $e797,x	                lda joyKeys,x           ; A = INKEY code from the Joykeys table at index X
8469	.e7fc	aa		tax		                tax                     ; X = A
8470	.e7fd	38		sec		                sec                     ; Set carry.       | KEYV with C=1, V=0 does a keyboard scan for INKEY X and
8471	.e7fe	b8		clv		                clv                     ; Clear overflow   | returns key-pressed state in C (1=pressed, 0=not pressed)
8472	.e7ff	20 94 ed	jsr $ed94	                jsr LED01               ; Scan the keyboard, ultimately via KEYV
8473	.e802	fa		plx		                plx                     ; Restore X
8474	.e803	68		pla		                pla                     ; Restore A
8475	.e804	2a		rol a		                rol a                   ; Rotate C (key state: 1=pressed, 0=not pressed) into A bit 0
8476	.e805	ca		dex		                dex                     ; Decrement X
8477	.e806	10 ef		bpl $e7f7	                bpl scanJoyKeysLoop     ; next joykey

8479						                                        ; At this point A contains active-high key states 1 1 1 right up down left copy
8480						                                        ; (top 3 bits are from original $FF, bottom 5 bits from key scans)

8482	.e808	49 ff		eor #$ff	                eor #$FF                ; Invert to active-low key states 0 0 0 ~right ~up ~down ~left ~copy
8483						                                        ; to match those from the joystick port

8485	.e80a					readJoystickPort:   ; Read Joystick port and combine with joykey results

8487						                    ; The Master Compact has a digital Joystick/Mouse port connected
8488						                    ; to User VIA port B through a 9 way D-type connector
8489						                    ; PB0 - Fire  (active low)     - Pin 6
8490						                    ; PB1 - Left  (active low)     - Pin 3
8491						                    ; PB2 - Down  (active low)     - Pin 2
8492						                    ; PB3 - Up    (active low)     - Pin 1
8493						                    ; PB4 - Right (active low)     - Pin 4
8494						                    ; CB1 - No joystick connection - Pin 5
8495						                    ; CB2 - No joystick connection - Pin 9
8496						                    ; +5V - Power                  - Pin 7
8497						                    ; 0V  - Ground                 - Pin 9

8499	.e80a	2d 60 fe	and $fe60	                and userVIA.irb                 ; Combine keyboard (A) with joystick port (User VIA Input Register B) both active-low: 0=pressed
8500						                                                ; AND of active-low signals = OR logic (De Morgan): result is 0 if either pressed
8501	.e80d	49 1f		eor #$1f	                eor #$1F                        ; Invert the five lo bits b4-b0 to make A active high
8502	.e80f	4a		lsr a		                lsr a                           ; Shift the 'fire' state into status flag C : A = 0 0 0 0 right up down left
8503	.e810	08		php		                php                             ; Save status (including C = fire)
8504	.e811	0a		asl a		                asl a                           ; A = 0 0 0 right up down left 0
8505	.e812	0a		asl a		                asl a                           ; A = 0 0 right up down left 0 0
8506	.e813	0a		asl a		                asl a                           ; A = 0 right up down left 0 0 0
8507	.e814	28		plp		                plp                             ; Restore status (including C = fire)
8508	.e815	2a		rol a		                rol a                           ; A = right up down left 0 0 0 fire  - now same pattern as switchToKey table and ADVAL 0 lo-byte
8509	.e816	aa		tax		                tax                             ; X = A
8510	.e817	4d b6 02	eor $02b6	                eor adval0LSB                   ; A = changed joystick state bits, by xor with previous state
8511	.e81a	2c 4e 02	bit $024e	                bit adcConversionType           ;   If bit 6 of adcConversionType is ...
8512	.e81d	29 f0		and #$f0	                and #$F0                        ; A = changed direction bits (b7-b4) (excludes changed fire state)
8513	.e81f	8e b6 02	stx $02b6	                stx adval0LSB                   ; update adval0LSB to reflect joystick/joykey state (including fire state)
8514	.e822	70 05		bvs $e829	                bvs exitSwitchedMode            ;   ... set then exitSwitchedMode and the whole routine
8515	.e824	f0 04		beq $e82a	                beq calculateJoystickIncrement  ; If same state as previous, continue to calculating the joystick increment
8516	.e826	9c bd 02	stz $02bd	                stz joystickRepeatCounter       ; Clear the key repeat counter

8518	.e829					exitSwitchedMode:
8519	.e829	60		rts		                rts                                     ; exit

8521						;-------------------------------------------------------------------------
8522						; Rate scaling. Converts adcConversionType to a valid rate (1-7), then calculates the increment in
8523						; advalIncMSB:advalIncLSB = joystickRepeatCounter * 2^rate
8524						; The effect is to give exponential sensitiviy scaling - higher rate settings produce much faster movement

8526	.e82a					calculateJoystickIncrement:                 ; Joystick state is unchanged since previous call
8527	.e82a	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8528	.e82d	f0 06		beq $e835	                beq applyDefaultRate        ; If zero, skip to use 3 as a default
8529	.e82f	c9 08		cmp #$08	                cmp #8                      ; Compare with 8
8530	.e831	90 04		bcc $e837	                bcc setupRateShift          ; If <8, skip forward to use value (1 to 7) unchanged
8531	.e833	a9 04		lda #$04	                lda #4                      ; A = 4 (out of range sentinel will convert to 7)

8533	.e835					applyDefaultRate:
8534	.e835	49 03		eor #$03	                eor #3                      ; Convert 0 to 3 (the mid-range default) or 4 (out of range sentinel) to 7 (max)

8536	.e837					setupRateShift:
8537	.e837	a8		tay		                tay                         ; Y = emulated one-based analogue joystick rate [1..7] slowest to fastest
8538	.e838	3a		dec a		                dec a                       ; Decrement A
8539	.e839	aa		tax		                tax                         ; X = emulated zero-based analogue joystick rate [0..6] slowest to fastest
8540	.e83a	ad bd 02	lda $02bd	                lda joystickRepeatCounter   ; A = repeat counter
8541	.e83d	9c bc 02	stz $02bc	                stz advalIncMSB             ; advalIncMSB = 0

8543	.e840					rateShiftLoop:
8544	.e840	ca		dex		                dex                         ; Decrement X (zero-based emulated joystick rate)
8545	.e841	30 06		bmi $e849	                bmi storeIncrement          ; If X < 0, exit loop
8546	.e843	0a		asl a		                asl a                       ; Shift A (repeat counter) left, b7 into C
8547	.e844	2e bc 02	rol $02bc	                rol advalIncMSB             ; Rotate advalIncMSB left, shifting C in b0
8548	.e847	80 f7		bra $e840	                bra rateShiftLoop           ; loop

8550	.e849					storeIncrement:
8551	.e849	8d bb 02	sta $02bb	                sta advalIncLSB             ; advalIncLSB = A
8552						                                            ; advalIncMSB:advalIncLSB now contain joystickRepeatCounter << rate

8554						;-------------------------------------------------------------------------
8555						; Velocity limiting.

8558	.e84c	cc bc 02	cpy $02bc	                cpy advalIncMSB             ; Compare Y (emulated one-based joystick rate) with advalIncMSB
8559	.e84f	b0 06		bcs $e857	                bcs centerIfSwitchedMode    ; If emulated one-based joystick rate >= advalIncMSB skip limiting
8560	.e851	8c bb 02	sty $02bb	                sty advalIncLSB             ; advalIncLSB = Y   Clamp advalIncLSB to the rate
8561	.e854	8c bc 02	sty $02bc	                sty advalIncMSB             ; advalIncMSB = Y   Clamp advalIncMSB to the rate

8563	.e857					centerIfSwitchedMode:
8564	.e857	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8565	.e85a	29 20		and #$20	                and #$20                    ; Mask for b5 : 0 = emulated proportional, 1 = switched
8566	.e85c	f0 0f		beq $e86d	                beq setupDirectionLoop      ; If zero (proportional) skip over the switched joystick move, otherwise switched
8567	.e85e	a9 ff		lda #$ff	                lda #$FF                    ; A = $FF
8568	.e860	8d b7 02	sta $02b7	                sta adval1LSB               ; adval1LSB = A ($FF)
8569	.e863	8d b9 02	sta $02b9	                sta adval2LSB               ; adval2LSB = A ($FF)
8570	.e866	4a		lsr a		                lsr a                       ; A = $7F
8571	.e867	8d b8 02	sta $02b8	                sta adval1MSB               ; adval1MSB = A ($7F)
8572	.e86a	8d ba 02	sta $02ba	                sta adval2MSB               ; adval2MSB = A ($7F)

8574						                                            ; ADVAL(1) == $7FFF  - centre joystick position
8575						                                            ; ADVAL(2) == $7FFF  - centre joystick position

8577	.e86d					setupDirectionLoop:                         ; There are four, 3-byte entries in the joystickDirections
8578	.e86d	a2 09		ldx #$09	                ldx #9                      ; table so the index of the beginning of the last entry is 9

8580	.e86f					joystickDirectionLoop:                      ; Iterate over entries in the joystickDirections table
8581	.e86f	ad b6 02	lda $02b6	                lda adcResultLSBs           ; A = adcResultLSBs which contains the switch states
8582	.e872	3c d8 e8	bit $e8d8,x	                bit joystickDirections,x    ; Compare the mask in byte 0 of the current entry against the switches
8583	.e875	f0 3e		beq $e8b5	                beq nextDirectionEntry      ; If no match, next table entry
8584	.e877	bd d9 e8	lda $e8d9,x	                lda joystickDirections+1,x  ; A = byte 1 of the current table entry, channel (b0) and direction (b7)
8585	.e87a	0a		asl a		                asl a                       ; Shift b0 to b1 and b7 into C
8586	.e87b	a8		tay		                tay                         ; Y = A  : 0 -> ADVAL(1), 2 -> ADVAL(2)
8587	.e87c	ad 4e 02	lda $024e	                lda adcConversionType       ; A = adcConversionType
8588	.e87f	29 20		and #$20	                and #$20                    ; Mask for b5 : 0 = emulated proportional, 1 = switched
8589	.e881	f0 05		beq $e888	                beq handleProportionalMode  ; If zero (proportional) skip to handleProportionalMode
8590	.e883	bd da e8	lda $e8da,x	                lda joystickDirections+2,x  ; otherwise (switched) A = byte 2 of the current table entry (switch equivalent value)
8591	.e886	80 27		bra $e8af	                bra storeAdvalChannelLSB    ; and store it

8593						;-------------------------------------------------------------------------

8595	.e888					handleProportionalMode:                     ; store proportional mode results. On entry Y encodes channel, C encodes direction
8596	.e888	b9 b7 02	lda $02b7,y	                lda adval1LSB,y             ; A = current ADVAL(1) LSB if Y = 0, or A = current ADVAL(2) LSB if Y = 2
8597	.e88b	b0 12		bcs $e89f	                bcs subtractAdvalIncrement  ; If C set (from ASL in joystickDirectionLoop) direction is -ve,
8598						                                            ; otherwise direction is +ve

8600						                                            ; 16-bit addition of the adval increment to current adval values

8602	.e88d	6d bb 02	adc $02bb	                adc advalIncLSB             ; A = ADVAL(channel) LSB + advalIncLSB
8603	.e890	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB
8604	.e893	b9 b8 02	lda $02b8,y	                lda adval1MSB,y             ; A = ADVAL(channel) MSB
8605	.e896	6d bc 02	adc $02bc	                adc advalIncMSB             ; A = ADVAL(channel) MSB + advalIncMSB
8606	.e899	90 17		bcc $e8b2	                bcc storeAdvalChannelMSB    ; Skip clamping if no overflow
8607	.e89b	a9 ff		lda #$ff	                lda #$FF                    ; Clamp to max if overflow
8608	.e89d	80 10		bra $e8af	                bra storeAdvalChannelLSB    ; and store it

8610						;-------------------------------------------------------------------------

8612	.e89f					subtractAdvalIncrement:                     ; 16-bit subtraction of the adval increment from current adval values
8613						                                            ; On entry A = current ADVAL(channel) LSB, and Y encodes channel
8614	.e89f	ed bb 02	sbc $02bb	                sbc advalIncLSB             ; A = ADVAL(channel) LSB - advalIncLSB
8615	.e8a2	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB
8616	.e8a5	b9 b8 02	lda $02b8,y	                lda adval1MSB,y             ; A = ADVAL(channel) MSB
8617	.e8a8	ed bc 02	sbc $02bc	                sbc advalIncMSB             ; A = ADVAL(channel) MSB - advalIncMSB
8618	.e8ab	b0 05		bcs $e8b2	                bcs storeAdvalChannelMSB    ; Skip clamping if no underflow
8619	.e8ad	a9 00		lda #$00	                lda #0                      ; Clamp to min if underflow

8621	.e8af					storeAdvalChannelLSB:
8622	.e8af	99 b7 02	sta $02b7,y	                sta adval1LSB,y             ; Update ADVAL(channel) LSB, where Y = 0 -> channel 1; Y = 2 -> channel 2

8624	.e8b2					storeAdvalChannelMSB:
8625	.e8b2	99 b8 02	sta $02b8,y	                sta adval1MSB,y             ; Update ADVAL(channel) MSB, where Y = 0 -> channel 1; Y = 2 -> channel 2

8627	.e8b5					nextDirectionEntry:
8628	.e8b5	ca		dex		                dex                         ; Each joystickDirections table entry is
8629	.e8b6	ca		dex		                dex                         ; three bytes, so decrement X three times
8630	.e8b7	ca		dex		                dex                         ; to point X to the next entry
8631	.e8b8	10 b5		bpl $e86f	                bpl joystickDirectionLoop   ; If still X >= 0 process the entry
8632	.e8ba	ee bd 02	inc $02bd	                inc joystickRepeatCounter   ; Increment joystickRepeatCounter
8633	.e8bd	d0 03		bne $e8c2	                bne emitAdcEvent            ; If joystickRepeatCount > 0, take emitAdcEvent
8634	.e8bf	ce bd 02	dec $02bd	                dec adcResultMSBs+3         ; Decrement joystickRepeatCounter

8636	.e8c2					emitAdcEvent:
8637	.e8c2	ae 4c 02	ldx $024c	                ldx currentADCChannel       ; X = currentADCChannel
8638	.e8c5	a0 03		ldy #$03	                ldy #3                      ; Event 3 is ADC conversion
8639	.e8c7	20 56 eb	jsr $eb56	                jsr eventEntryPoint         ; Emit ADC conversion event
8640	.e8ca	ce 4c 02	dec $024c	                dec currentADCChannel       ; Decrement current ADC channel
8641	.e8cd	f0 02		beq $e8d1	                beq resetToMaxChannel       ; If zero, reset to max ADC channel
8642	.e8cf	10 06		bpl $e8d7	                bpl exitHandleJoystick      ; If positive, we're done -> exit

8644	.e8d1					resetToMaxChannel:
8645	.e8d1	ad 4d 02	lda $024d	                lda maximumADCChannel       ; A = maximum ADC channel
8646	.e8d4	8d 4c 02	sta $024c	                sta currentADCChannel       ; Update the current ADC channel with the max

8648	.e8d7					exitHandleJoystick:
8649	.e8d7	60		rts		                rts                         ; Return
8650						                .endblock

8652						;-------------------------------------------------------------------------
8653						; The joystickDirections table contains four entries of three bytes each, and
8654						; will be processed in decending order. Each entry contains:
8655						;
8656						; Byte 0: Direction bit mask to test against the adval0LSB joystick direction bits
8657						;
8658						; Byte 1: Encodes two pieces of information, both of which are subject to an ASL
8659						;         in the code that processes the table. In the b0 it encodes the ADVAL
8660						;         channel (joystick axis) as,
8661						;
8662						;             0 -> ASL -> 0 -> interpreted as ADVAL(1) x-axis
8663						;             1 -> ASL -> 2 -> interpreted as ADVAL(2) y-axis
8664						;
8665						;         Furthermore, b7 encodes the direction and controls whether the magnitude
8666						;         of the joystick increment is added or subtracted,
8667						;
8668						;             0 -> ASL -> C=0 -> ADD (positive change)
8669						;             1 -> ASL -> C=1 -> SUBTRACT (negative change)
8670						;
8671						;         For example,
8672						;
8673						;             $01 (0000 0001) -> ASL -> $02 -> carry clear -> ADD mode
8674						;             $80 (1000 0000) -> ASL -> $00 -> carry set -> SUBTRACT mode
8675						;             $81 (1000 0001) -> ASL -> $02 -> carry set -> SUBTRACT mode
8676						;
8677						; Byte 2: The value to use is switched mode ($00 min, $FF max)

8679	.e8d8					joystickDirections:

8681	>e8d8	40				    .byte $40   ; UP joystick switch bit mask
8682	>e8d9	01				    .byte $01   ;   ADVAL(2) +ve
8683	>e8da	ff				    .byte $FF   ;   max switched mode value

8685	>e8db	20				    .byte $20   ; DOWN joystick switch bit mask
8686	>e8dc	81				    .byte $81   ;   ADVAL(2) -ve
8687	>e8dd	00				    .byte $00   ;   min switched mode value

8689	>e8de	80				    .byte $80   ; RIGHT joystick switch bit mask
8690	>e8df	80				    .byte $80   ;   ADVAL(1) -ve
8691	>e8e0	00				    .byte $00   ;   min switched mode value

8693	>e8e1	10				    .byte $10   ; LEFT joystick switch bit mask
8694	>e8e2	00				    .byte $00   ;   ADVAL(1) +ve
8695	>e8e3	ff				    .byte $FF   ;   max switched mode value

8699						;-------------------------------------------------------------------------

