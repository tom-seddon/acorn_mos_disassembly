13719	.fae6					findFSForHandle: .proc
13720	.fae6	48		pha		                pha                          ;
13721	.fae7	5a		phy		                phy                          ;
13722	.fae8	98		tya		                tya                          ;A = handle to search for
13723	.fae9	a0 00		ldy #$00	                ldy #$00                     ;
13724	.faeb					loop:
13725	.faeb	be 06 df	ldx $df06,y	                ldx hazel.fsInfoBlocks.name+0,y
13726	.faee	f0 15		beq $fb05	                beq notFound                  ;taken if terminating entry
13727	.faf0	d9 0e df	cmp $df0e,y	                cmp hazel.fsInfoBlocks.minHandle,y
13728	.faf3	90 07		bcc $fafc	                bcc next                     ;taken if not this FS
13729	.faf5	d9 0f df	cmp $df0f,y	                cmp hazel.fsInfoBlocks.maxHandle,y
13730	.faf8	90 10		bcc $fb0a	                bcc found                    ;taken if this FS
13731	.fafa	f0 0e		beq $fb0a	                beq found                    ;taken if this FS

13733	.fafc					next:
13734	.fafc	48		pha		                pha
13735	.fafd	98		tya		                tya
13736	.fafe	18		clc		                clc
13737	.faff	69 0b		adc #$0b	                adc #size(fsInfoBlock)
13738	.fb01	a8		tay		                tay
13739	.fb02	68		pla		                pla
13740	.fb03	80 e6		bra $faeb	                bra loop

13742	.fb05					notFound:
13743	.fb05	ae 00 df	ldx $df00	                ldx hazel.currentFS
13744	.fb08	80 03		bra $fb0d	                bra done

13746	.fb0a					found:
13747	.fb0a	be 10 df	ldx $df10,y	                ldx hazel.fsInfoBlocks.fsNumber,y
13748	.fb0d					done:
13749	.fb0d	7a		ply		                ply
13750	.fb0e	68		pla		                pla
13751	.fb0f	60		rts		                rts
13752						                .endproc

13754						;-------------------------------------------------------------------------
13755						;
13756						; Select filing system in A.
13757						;
13758						; Entry:
13759						;
13760						; A = FS number
13761						;
13762	.fb10					selectFS:                               ;fb4d
13763	.fb10	cd 01 df	cmp $df01	                cmp hazel.activeFS      ; Check active fs
13764	.fb13	f0 16		beq $fb2b	                beq rtsFB68               ; Already active fs, return
13765	.fb15	5a		phy		                phy
13766	.fb16	da		phx		                phx
13767	.fb17	a8		tay		                tay
13768	.fb18	3a		dec a		                dec a
13769	.fb19	d0 07		bne $fb22	                bne LFB5F       ;taken if not FS 1 (tape)

13771						; ??? - only if trying to select tape FS

13773	.fb1b	a9 04		lda #$04	                lda #$04
13774	.fb1d	24 e2		bit $e2		                bit $E2
13775	.fb1f	d0 01		bne $fb22	                bne LFB5F
13776	.fb21	c8		iny		                iny
13777	.fb22					LFB5F:
13778	.fb22	5a		phy		                phy
13779	.fb23	a2 12		ldx #$12	                ldx #romServiceCallInitialiseFilingSystem
13780	.fb25	20 fb ee	jsr $eefb	                jsr makeROMServiceCall
13781	.fb28	68		pla		                pla
13782	.fb29	fa		plx		                plx
13783	.fb2a	7a		ply		                ply
13784	.fb2b					rtsFB68:
13785	.fb2b	60		rts		                rts

13787						;-------------------------------------------------------------------------
13788						;
13789						; FileSwitch FSC
13790						; ==============
13791						;
13792	.fb2c					fileswitchFSCEntryPoint:
13793	.fb2c	48		pha		                pha                          ;save request type
13794	.fb2d	20 43 ee	jsr $ee43	                jsr selectHAZEL
13795	.fb30	4e c6 df	lsr $dfc6	                lsr hazel.tempFSFlag
13796	.fb33	68		pla		                pla                          ;restore request type
13797	.fb34	48		pha		                pha                          ;save request type
13798	.fb35	da		phx		                phx                          ;save request X
13799	.fb36	0a		asl a		                asl a
13800	.fb37	aa		tax		                tax
13801	.fb38	c9 17		cmp #$17	                cmp #11*2+1
13802	.fb3a	b0 03		bcs $fb3f	                bcs fileswitchPassFSCToCurrentFS ;taken if out of range
13803	.fb3c	7c 44 fb	jmp ($fb44,x)	                jmp (fileswitchFSCRoutinesTable,x)

13805						;-------------------------------------------------------------------------
13806						;
13807						; Pass to filing system's FSC
13808						;
13809						; There's 2 entry points - fileswitchPassFSCToCurrentFS, for
13810						; when X and A are both on the stack, and
13811						; fileswitchPassFSCToCurrentFS_X, for when only A is on the
13812						; stack.
13813						;
13814	.fb3f					fileswitchPassFSCToCurrentFS:
13815	.fb3f					fileswitchFSCNewFS:
13816	.fb3f					fileswitchFSCFileHandleRange:
13817	.fb3f					fileswitchFSCStarCommand:
13818	.fb3f	fa		plx		                plx                          ;restore request X
13819	.fb40					fileswitchPassFSCToCurrentFS_X:
13820	.fb40	68		pla		                pla                          ;restore request type
13821	.fb41	6c da df	jmp ($dfda)	                jmp (hazel.activeFSCV) ;call active FS's real FSCV entry point

13823						;-------------------------------------------------------------------------
13824						;
13825						; FileSwitch FSC table
13826						;
13827	.fb44					fileswitchFSCRoutinesTable:
13828	>fb44	69 fb				                .word fileswitchFSCOPT
13829	>fb46	62 fb				                .word fileswitchFSCCheckEOF
13830	>fb48	76 fb				                .word fileswitchFSCStarSlash
13831	>fb4a	5c fb				                .word fileswitchFSCUnknownCommand
13832	>fb4c	76 fb				                .word fileswitchFSCStarRUN
13833	>fb4e	7b fb				                .word fileswitchFSCStarCAT
13834	>fb50	3f fb				                .word fileswitchFSCNewFS
13835	>fb52	3f fb				                .word fileswitchFSCFileHandleRange
13836	>fb54	3f fb				                .word fileswitchFSCStarCommand
13837	>fb56	7b fb				                .word fileswitchFSCStarEX
13838	>fb58	7b fb				                .word fileswitchFSCStarINFO
13839	>fb5a	ab fb				                .word fileswitchFSCRUNLibrary

13841						;-------------------------------------------------------------------------
13842						;
13843						; FSC 3 - *command [AUG p344]
13844						;
13845	.fb5c					fileswitchFSCUnknownCommand:
13846	.fb5c	fa		plx		                plx
13847	.fb5d	20 84 fb	jsr $fb84	                jsr getCommandLinePointer
13848	.fb60	80 de		bra $fb40	                bra fileswitchPassFSCToCurrentFS_X

13850						;-------------------------------------------------------------------------
13851						;
13852						; FSC 1 - check EOF [AUG p343]
13853						;
13854	.fb62					fileswitchFSCCheckEOF:
13855	.fb62	7a		ply		                ply                         ;Y = file handle
13856	.fb63	5a		phy		                phy                         ;restore stack arrangement
13857	.fb64	20 5a fa	jsr $fa5a	                jsr selectFSForHandle
13858	.fb67	80 d6		bra $fb3f	                bra fileswitchPassFSCToCurrentFS

13860						;-------------------------------------------------------------------------
13861						;
13862						; FSC 0 - *OPT [AUG p343]
13863						;
13864	.fb69					fileswitchFSCOPT:
13865	.fb69	2c c6 df	bit $dfc6	                bit hazel.tempFSFlag   ; Check temporary fs flag
13866	.fb6c	70 d1		bvs $fb3f	                bvs fileswitchPassFSCToCurrentFS
13867	.fb6e	ad 00 df	lda $df00	                lda hazel.currentFS ; Get current filing system number

13869						;-------------------------------------------------------------------------
13870						;
13871						; Pass FSCV request through to a particular FS.
13872						;
13873						; entry:
13874						;
13875						; A = FS to select
13876						;
13877						; Y = FSCV Y
13878						;
13879						; S = [FSCV X; FSCV A]
13880						;
13881	.fb71					fileswitchPassFSCToSpecificFS:
13882	.fb71	20 10 fb	jsr $fb10	                jsr selectFS        ; Select filing system
13883	.fb74	80 c9		bra $fb3f	                bra fileswitchPassFSCToCurrentFS

13885						;-------------------------------------------------------------------------
13886						;
13887						; FSC 2 - */filename [AUG p343]
13888						; FSC 4 - *RUN filename [AUG p344]
13889						;
13890	.fb76					fileswitchFSCStarSlash:
13891	.fb76					fileswitchFSCStarRUN:
13892	.fb76	fa		plx		                plx
13893	.fb77	20 84 fb	jsr $fb84	                jsr getCommandLinePointer ; Skip '*'s and spaces, set command line address
13894	.fb7a	da		phx		                phx             ; Continue on to pass to filing system

13897						;-------------------------------------------------------------------------
13898						;
13899						; FSC 5 - *CAT [AUG p344]
13900						; FSC 9 - *EX [NAUG p257]
13901						; FSC, 10 - *INFO [NAUG p257]
13902						;
13903	.fb7b					fileswitchFSCStarCAT:
13904	.fb7b					fileswitchFSCStarEX:
13905	.fb7b					fileswitchFSCStarINFO:
13906	.fb7b	fa		plx		                plx
13907	.fb7c	0e c6 df	asl $dfc6	                asl hazel.tempFSFlag
13908	.fb7f	20 31 fa	jsr $fa31	                jsr parseFileNameAndSelectFS
13909	.fb82	80 bc		bra $fb40	                bra fileswitchPassFSCToCurrentFS_X

13911						;-------------------------------------------------------------------------
13912						;
13913						; Get command line pointer.
13914						;
13915						; Entry:
13916						;
13917						; X/Y - pointer to CR-terminated command line string
13918						;
13919						; Exit:
13920						;
13921						; X/Y, (hazel.commandLinePointer) - pointer to first non-space char in
13922						; command line string
13923	.fb84					getCommandLinePointer: .proc ;fbc1
13924	.fb84	86 f2		stx $f2		                stx stringInputBufferAddress+0
13925	.fb86	84 f3		sty $f3		                sty stringInputBufferAddress+1

13927						; skip spaces. Stop if terminating CR encountered.

13929	.fb88	a0 ff		ldy #$ff	                ldy #$FF
13930	.fb8a					-
13931	.fb8a	c8		iny		                iny
13932	.fb8b	b1 f2		lda ($f2),y	                lda (stringInputBufferAddress),y
13933	.fb8d	c9 0d		cmp #$0d	                cmp #$0D
13934	.fb8f	f0 04		beq $fb95	                beq +
13935	.fb91	c9 20		cmp #$20	                cmp #' '
13936	.fb93	d0 f5		bne $fb8a	                bne -

13938	.fb95					+

13940						; Hmm. Didn't we just do this bit already?

13942	.fb95	20 b2 f3	jsr $f3b2	                jsr skipSpacesAndCheckForCRInStringInput

13944						; Store address of first non-space char in the HAZEL command line
13945						; pointer.

13947	.fb98	98		tya		                tya
13948	.fb99	18		clc		                clc
13949	.fb9a	65 f2		adc $f2		                adc stringInputBufferAddress+0
13950	.fb9c	8d 04 df	sta $df04	                sta hazel.commandLinePointer+0
13951	.fb9f	a5 f3		lda $f3		                lda stringInputBufferAddress+1
13952	.fba1	69 00		adc #$00	                adc #$00
13953	.fba3	8d 05 df	sta $df05	                sta hazel.commandLinePointer+1
13954	.fba6	a4 f3		ldy $f3		                ldy stringInputBufferAddress+1
13955	.fba8	a6 f2		ldx $f2		                ldx stringInputBufferAddress+0
13956	.fbaa	60		rts		                rts
13957						                .pend

13959						;-------------------------------------------------------------------------
13960						;
13961						; FSC 11 - RUN from libfs [NAUG p257]
13962						;
13963	.fbab					fileswitchFSCRUNLibrary:
13964	.fbab	ad 02 df	lda $df02	                lda hazel.libFS      ; Is a libfs set?
13965	.fbae	10 c1		bpl $fb71	                bpl fileswitchPassFSCToSpecificFS
13966	.fbb0					badCommandError:
13967	.fbb0	00		brk #		                brk
13968	>fbb1	fe				                .byte 254
13969	>fbb2	42 61 64 20 63 6f 6d 6d		                .text "Bad command"
	>fbba	61 6e 64
13970	.fbbd	00		brk #		                brk

