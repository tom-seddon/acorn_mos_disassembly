6625						;-------------------------------------------------------------------------
6626						;
6627						; Overwrite: ZGORA=$ff, ZGEOR=$ff
6628						; OR: ZGORA=value, ZGEOR=$00
6629						; AND: ZGORA=~value, ZGEOR=$00
6630						; EOR: ZGORA=$00, ZGEOR=value
6631						; Invert: ZGORA=$00, ZGEOR=$ff
6632						; Leave: ZGORA=$00, ZGEOR=$ff
6633						;
6634	.e156					zgeorORTable:
6635	>e156	00				                .byte $00
6636	.e157					zgoraORTable:
6637	>e157	ff				                .byte $FF
6638	.e158					zgoraEORTable:
6639	>e158	00				                .byte $00
6640	>e159	00				                .byte $00
6641	>e15a	ff				                .byte $FF
6642	.e15b					zgeorEORTable:
6643	>e15b	ff				                .byte $FF
6644	>e15c	ff				                .byte $FF
6645	>e15d	ff				                .byte $FF
6646	>e15e	00				                .byte $00

