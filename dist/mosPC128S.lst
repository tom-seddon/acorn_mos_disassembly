6898						;
6899						; OSBYTE 165 (&A5) Read output cursor position [MasRef D.2-50]
6900						;
6901	.e250					osbyteA5:
6902	.e250	20 e2 f4	jsr $f4e2	                jsr withMOSROM
6903	.e253	24 d0		bit $d0		                bit STATE
6904	.e255	50 0e		bvc $e265	                bvc getTextCursorPositionWithColumn81                    ;taken if cursor editing
6905	.e257	20 c1 e2	jsr $e2c1	                jsr exchangeEditCursorPositionAndTextCursorPosition
6906	.e25a	20 65 e2	jsr $e265	                jsr getTextCursorPositionWithColumn81
6907	.e25d	da		phx		                phx
6908	.e25e	5a		phy		                phy
6909	.e25f	20 c1 e2	jsr $e2c1	                jsr exchangeEditCursorPositionAndTextCursorPosition
6910	.e262	7a		ply		                ply
6911	.e263	fa		plx		                plx
6912	.e264	60		rts		                rts

6914						;-------------------------------------------------------------------------
6915						;
6916						; Get text cursor position, taking the column 81 flag into account and
6917						; reporting the X coordinate as N+1 in that case.
6918						;
6919	.e265					getTextCursorPositionWithColumn81:
6920	.e265	20 80 e2	jsr $e280	                jsr getTextCursorPosition
6921	.e268	2c 6c 03	bit $036c	                bit vduv.column81
6922	.e26b	10 01		bpl $e26e	                bpl +                       ;taken if not at column 81
6923	.e26d	e8		inx		                inx                         ;X=81
6924	.e26e					+
6925	.e26e	60		rts		                rts

6927						;-------------------------------------------------------------------------

6929	.e26f					LE25C:
6930	.e26f	38		sec		                sec
6931	.e270	ad 0a 03	lda $030a	                lda vduv.textWindowRight
6932	.e273	ed 08 03	sbc $0308	                sbc vduv.textWindowLeft
6933	.e276	48		pha		                pha
6934	.e277	a9 00		lda #$00	                lda #$00
6935	.e279	a8		tay		                tay
6936	.e27a	80 10		bra $e28c	                bra LE279

6938						;-------------------------------------------------------------------------
6939						;
6940						; OSBYTE 134 (&86) Read text cursor position [MasRef D.2-41]
6941						;
6942	.e27c					osbyte86:
6943	.e27c	24 d0		bit $d0		                bit STATE
6944	.e27e	50 d0		bvc $e250	                bvc osbyteA5       ;taken if not cursor editing
6945	.e280					getTextCursorPosition:
6946	.e280	a9 02		lda #$02	                lda #VDUVariables.cursorFlags.invertHorizontal
6947	.e282	a0 10		ldy #$10	                ldy #VDUVariables.textCursorXPosition-VDUVariables.textWindow
6948	.e284	a2 00		ldx #$00	                ldx #VDUVariables.textWindowLeft-VDUVariables.textWindow
6949	.e286	20 9d e2	jsr $e29d	                jsr getTextWindowRelativePosition
6950	.e289	48		pha		                pha                          ;save X position
6951	.e28a	a9 04		lda #$04	                lda #VDUVariables.cursorFlags.invertVertical
6952	.e28c					LE279:
6953	.e28c	c8		iny		                iny               ;i.e., offset of textCursorYPosition
6954	.e28d	a2 03		ldx #$03	                ldx #VDUVariables.textWindowTop-VDUVariables.textWindow
6955	.e28f	20 9d e2	jsr $e29d	                jsr getTextWindowRelativePosition
6956	.e292	aa		tax		                tax                          ;X = Y position
6957	.e293	a8		tay		                tay                          ;Y = Y position
6958	.e294	a9 08		lda #$08	                lda #vduv.cursorFlags.swapAxes
6959	.e296	2c 66 03	bit $0366	                bit vduv.cursorFlags
6960	.e299	f0 24		beq $e2bf	                beq plx_rts ;taken if axes unswapped - so X = X position, Y = Y position
6961	.e29b	7a		ply		                ply                          ;Y = Y position, X = X position
6962	.e29c	60		rts		                rts

6964						;-------------------------------------------------------------------------
6965						;
6966						; Get text window-relative cursor position, taking into account cursor
6967						; flags.
6968						;
6969						; entry:
6970						;
6971						; A = cursorFlags bit for axis of interest - invertHorizontal or invertVertical
6972						;
6973						; X = offset in VDU variables of text window minimum for axis of interest
6974						;
6975						; Y = offset in VDU variables of cursor position for axis of interest
6976						;
6977						; exit:
6978						;
6979						; A = text window-relative coordinate
6980						;
6981	.e29d					getTextWindowRelativePosition:
6982	.e29d	38		sec		                sec                     ;C=1 ready for the subtraction
6983	.e29e	2c 66 03	bit $0366	                bit vduv.cursorFlags ;test cursor flags inversion bit of interest
6984	.e2a1	f0 0b		beq $e2ae	                beq axisNotInverted
6985	.e2a3					axisInverted:
6986	.e2a3	8a		txa		                txa
6987	.e2a4	49 02		eor #$02	                eor #$02                     ;swap min and max
6988	.e2a6	aa		tax		                tax
6989	.e2a7	bd 08 03	lda $0308,x	                lda vduv.textWindow,x
6990	.e2aa	f9 08 03	sbc $0308,y	                sbc vduv.textWindow,y
6991	.e2ad	60		rts		                rts

6993	.e2ae					axisNotInverted:
6994	.e2ae	b9 08 03	lda $0308,y	                lda vduv.textWindow,y
6995	.e2b1	fd 08 03	sbc $0308,x	                sbc vduv.textWindow,x
6996	.e2b4	60		rts		                rts

6998						;-------------------------------------------------------------------------
6999						;
7000						; Get default bounds for current mode.
7001						;
7002						; exit:
7003						;
7004						; X = max column (19, 39 or 79)
7005						;
7006						; Y = max row (24 or 31)
7007						;
7008						; preserves: A, C
7009						;
7010	.e2b5					getDefaultBoundsForCurrentScreenMODE:
7011	.e2b5	ae 55 03	ldx $0355	                ldx vduv.currentScreenMODE
7012	.e2b8	bc 1c e1	ldy $e11c,x	                ldy modeMaxColumn,x          ;Y = max column
7013	.e2bb	5a		phy		                phy                          ;save max column
7014	.e2bc	bc 14 e1	ldy $e114,x	                ldy modeMaxRow,x             ;Y = max row
7015	.e2bf					plx_rts:
7016	.e2bf	fa		plx		                plx                          ;X = max column
7017	.e2c0	60		rts		                rts

